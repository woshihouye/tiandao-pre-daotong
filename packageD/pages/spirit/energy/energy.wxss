.container {
  min-height: 100vh;
  padding-bottom: 140rpx;
  background: var(--page-bg);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.5;
}

.energy-display {
  display: flex;
  align-items: flex-end;
  flex-wrap: wrap;
  gap: 12rpx;
}

.energy-value {
  margin-top: 20rpx;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
}

.energy-progress {
  margin-top: 18rpx;
}

.energy-level {
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.advice-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.field-row:last-child {
  border-bottom: none;
}

.field-label {
  width: 180rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.5;
}

.field-control,
.picker-value {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  padding: 0 18rpx;
  border-radius: 24rpx;
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}

.field-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: 26rpx;
  color: var(--text-primary);
  text-align: right;
}

.field-unit {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.quality-group {
  flex: 1;
  min-width: 0;
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}

.quality-item {
  min-width: 88rpx;
  padding: 14rpx 18rpx;
  text-align: center;
  border-radius: 18rpx;
  border: 1rpx solid var(--border-color);
  background: var(--surface-soft);
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.quality-item.active {
  color: #ffffff;
  background: var(--primary);
  border-color: var(--primary);
}

.buff-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52rpx;
  margin-top: 18rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--border-color);
  background: var(--surface-soft);
  font-size: 24rpx;
  color: var(--primary);
  line-height: 1.5;
}

.action-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
}

.save-btn {
  width: 100%;
}
