.container {
  min-height: 100vh;
  padding: 24rpx;
  background: var(--page-bg);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.5;
}

.section-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 预览区 */
.poem-preview {
  position: relative;
  margin-top: 28rpx;
  padding: 48rpx 40rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, var(--card-bg) 0%, var(--surface-soft) 100%);
  border: 1rpx solid rgba(var(--primary-rgb), 0.2);
  text-align: center;
  min-height: 100rpx;
}

.poem-deco {
  position: absolute;
  font-size: 48rpx;
  color: rgba(var(--primary-rgb), 0.15);
  font-weight: 700;
  line-height: 1;
}

.poem-deco:first-child {
  top: 16rpx;
  left: 24rpx;
}

.poem-deco.right {
  bottom: 16rpx;
  right: 24rpx;
}

.poem-content {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 2;
  letter-spacing: 2rpx;
}

/* 输入区 */
.poem-input-wrap {
  position: relative;
  margin-top: 24rpx;
}

.poem-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.8;
  box-sizing: border-box;
}

.poem-count {
  text-align: right;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 按钮 */
.poem-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.btn-outline {
  flex: 1;
  padding: 14rpx 0;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
  background: transparent;
  border: 1rpx solid var(--primary);
  line-height: 1.5;
}

.btn-ghost {
  padding: 14rpx 24rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
  line-height: 1.5;
}

.save-btn {
  margin: 32rpx 0;
  width: 100%;
  padding: 18rpx 0;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  background: var(--primary);
  color: #fff;
  line-height: 1.5;
}
