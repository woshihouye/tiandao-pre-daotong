.page{min-height:100vh;padding:40rpx;background:#1a1a2e;color:#fff}
.title{font-size:36rpx;font-weight:700;margin-bottom:40rpx}
.section{margin-bottom:40rpx}
.section-title{font-size:28rpx;color:#94a3b8;margin-bottom:16rpx;font-weight:600}
.faq-item{padding:16rpx;background:rgba(30,41,59,.6);border-radius:16rpx;margin-bottom:12rpx;font-size:26rpx}
.faq-q{color:#eab308;display:block}.faq-a{color:#94a3b8;margin-top:8rpx;display:block}
.msg-input{width:100%;height:160rpx;background:rgba(30,41,59,.8);border:1rpx solid rgba(255,255,255,.05);border-radius:16rpx;padding:16rpx;color:#fff;font-size:26rpx;box-sizing:border-box}
.send-btn{display:block;text-align:center;padding:20rpx;background:#eab308;color:#0f172a;border-radius:24rpx;margin-top:16rpx;font-weight:600}.send-btn.disabled{background:#334155;color:#64748b}
.msg-list{display:flex;flex-direction:column;gap:12rpx}.msg-bubble{padding:16rpx 24rpx;border-radius:16rpx;font-size:24rpx;max-width:80%}
.self{align-self:flex-end;background:#eab308;color:#0f172a}.admin{align-self:flex-start;background:rgba(30,41,59,.8);color:#fff}
