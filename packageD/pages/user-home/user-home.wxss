.container {
  min-height: 100vh;
  padding: 24rpx;
  background: var(--page-bg);
}

.loading-card {
  padding: 100rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* 形象头区 */
.hero-card {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  gap: 20rpx;
}

.hero-avatar {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--surface-soft);
  border: 2rpx solid var(--primary);
  font-size: 42rpx;
  font-weight: 700;
  color: var(--primary);
}

.hero-info {
  flex: 1;
  min-width: 0;
}

.hero-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.5;
}

.hero-realm {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.hero-actions {
  flex-shrink: 0;
}

/* 定场诗 */
.poem-card {
  margin-top: 20rpx;
  padding: 32rpx 28rpx;
  text-align: center;
  background: linear-gradient(135deg, var(--card-bg) 0%, var(--surface-soft) 100%);
  border: 1rpx solid rgba(var(--primary-rgb), 0.15);
}

.poem-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 2;
  letter-spacing: 2rpx;
}

/* 核心数据 */
.stats-card {
  margin-top: 20rpx;
  display: flex;
  padding: 24rpx 16rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.5;
}

.stat-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 模板 */
.template-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}

.tm-cover {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: var(--card-bg);
  font-size: 26rpx;
  font-weight: 700;
  color: var(--primary);
  border: 1rpx solid var(--border-color);
}

.tm-info {
  flex: 1;
  margin-left: 16rpx;
}

.tm-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.tm-cap {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.tm-arrow {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.section-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.5;
}

.side-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.side-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
  font-size: 24rpx;
  color: var(--text-secondary);
}

.side-cover {
  font-weight: 700;
  color: var(--primary);
}

/* 底部操作栏 */
.action-bar {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
  padding-bottom: 48rpx;
}

.btn {
  flex: 1;
  padding: 18rpx 0;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
  line-height: 1.5;
}

.btn-primary {
  background: var(--primary);
  color: #fff;
}

.btn-ghost {
  background: var(--surface-soft);
  color: var(--text-secondary);
  border: 1rpx solid var(--border-color);
}

.btn-outline {
  background: transparent;
  color: var(--primary);
  border: 1rpx solid var(--primary);
}

.card {
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
}

/* 受限卡片 */
.restricted-card {
  margin: 120rpx 48rpx;
  text-align: center;
  padding: 64rpx 32rpx;
  border-radius: 24rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
}

.restricted-avatar {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--surface-soft);
  border: 2rpx solid var(--primary);
  font-size: 48rpx;
  font-weight: 700;
  color: var(--primary);
}

.restricted-name {
  margin-top: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.restricted-icon {
  margin-top: 24rpx;
  font-size: 52rpx;
}

.restricted-reason {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.restricted-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--primary);
  line-height: 1.5;
}
