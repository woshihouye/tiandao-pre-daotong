.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 无权限空态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}
.empty-icon { font-size: 80rpx; }
.empty-text { font-size: 28rpx; color: #999; margin-top: 20rpx; }

/* Tab 切换 */
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #666;
}
.tab-item.active {
  color: #3B82F6;
  font-weight: bold;
  border-bottom: 4rpx solid #3B82F6;
}

/* 列表空态 */
.empty-list {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 100rpx 0;
}

/* 审核卡片 */
.card {
  background: #fff;
  margin: 20rpx 24rpx;
  padding: 28rpx;
  border-radius: 16rpx;
}
.card-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.card-meta {
  font-size: 26rpx;
  color: #3B82F6;
  margin-top: 12rpx;
}
.card-desc {
  font-size: 26rpx;
  color: #666;
  margin-top: 12rpx;
}
.card-applicant {
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
  word-break: break-all;
}
.card-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 24rpx;
}
.btn {
  padding: 12rpx 40rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  margin-left: 20rpx;
}
.btn.approve {
  background: #ECFDF5;
  color: #059669;
}
.btn.reject {
  background: #FEF2F2;
  color: #DC2626;
}
