.page{min-height:100vh;padding:40rpx;background:#1a1a2e;color:#fff}
.title{font-size:36rpx;font-weight:700;margin-bottom:16rpx}
.warn{color:var(--danger-text);font-size:24rpx;margin-bottom:40rpx}
.card{background:rgba(30,41,59,.8);border-radius:24rpx;padding:32rpx;margin-bottom:24rpx}
.row{display:flex;justify-content:space-between;padding:12rpx 0;border-bottom:1rpx solid rgba(255,255,255,.05)}
.label{color:#94a3b8;font-size:26rpx}.val{color:#fff;font-size:26rpx;font-weight:600}
.danger{color:var(--danger-text)}.btn-row{display:flex;gap:24rpx;margin-top:40rpx}
.btn-cancel{flex:1;text-align:center;padding:20rpx;background:rgba(255,255,255,.05);border-radius:48rpx;color:#94a3b8}
.btn-confirm{flex:1;text-align:center;padding:20rpx;background:#ef4444;border-radius:48rpx;color:#fff;font-weight:600}
.success{text-align:center;padding:60rpx 0}.success-icon{font-size:80rpx;margin-bottom:16rpx}
.success-title{font-size:32rpx;color:#22c55e;margin-bottom:24rpx}
.success-detail{font-size:26rpx;color:#94a3b8;line-height:2}
.back-btn{display:block;text-align:center;color:#eab308;font-size:28rpx;margin-top:48rpx;padding:24rpx}
