<view class="page">
  <view class="board-tabs"><view wx:for="{{boards}}" wx:key="id" class="tab {{ activeBoard === item.id ? 'active' : '' }}" bindtap="onBoardTap" data-board="{{item.id}}">{{item.icon}} {{item.name}}</view></view>
  <view class="my-rank-card" wx:if="{{ myRank }}">
    <text class="my-label">我</text><text class="my-rank">{{ myRank.rank > 0 ? '第' + myRank.rank + '名' : '未上榜' }}</text>
  </view>
  <view class="list">
    <view class="item" wx:for="{{ entries }}" wx:key="userId">
      <view class="rank {{ item.rankClass }}">{{ item.rankDisplay }}</view>
      <view class="avatar">{{ item.avatarText }}</view>
      <view class="info"><text class="name">{{ item.nickName }}</text><text class="sub">{{ item.realmName || '' }}</text></view>
      <view class="score">{{ item.score }}</view>
    </view>
  </view>
  <view class="empty" wx:if="{{ !entries.length }}">排行数据加载中...</view>
</view>
