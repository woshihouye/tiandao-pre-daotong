.page{min-height:100vh;background:#1a1a2e;color:#fff;padding:0 0 40rpx}
.board-tabs{display:flex;gap:0;background:#0f172a;position:sticky;top:0;z-index:10}
.tab{flex:1;text-align:center;padding:24rpx;font-size:26rpx;color:#64748b;border-bottom:3rpx solid transparent}
.tab.active{color:#eab308;border-bottom-color:#eab308;font-weight:600}
.my-rank-card{display:flex;align-items:center;gap:16rpx;padding:24rpx;background:rgba(234,179,8,.1);margin:16rpx}
.my-label{font-size:24rpx;color:#94a3b8}.my-rank{font-size:28rpx;color:#eab308;font-weight:700}
.list{padding:0 16rpx}
.item{display:flex;align-items:center;gap:16rpx;padding:20rpx 16rpx;border-bottom:1rpx solid rgba(255,255,255,.05)}
.rank{width:60rpx;text-align:center;font-size:24rpx;font-weight:600;color:#94a3b8}
.rank-gold{color:#efb810;font-size:30rpx}.rank-silver{color:#9ca3af;font-size:28rpx}.rank-bronze{color:#cd7f32;font-size:26rpx}
.avatar{width:64rpx;height:64rpx;border-radius:50%;background:linear-gradient(135deg,#3b82f6,#8b5cf6);display:flex;align-items:center;justify-content:center;color:#fff;font-size:28rpx;font-weight:700}
.info{flex:1}.name{font-size:28rpx}.sub{font-size:22rpx;color:#64748b}
.score{font-size:26rpx;font-weight:600;color:#22c55e}
.empty{text-align:center;padding:120rpx 0;color:#64748b}
