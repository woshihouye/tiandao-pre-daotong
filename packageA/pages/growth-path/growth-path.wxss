/* 成长路径页 — 时间线 */

.container {
  min-height: 100vh;
  padding: 20rpx 24rpx 0;
  background: var(--page-bg);
}

.card {
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
}

/* ===== 顶部 ===== */
.summary-card {
  text-align: center;
  padding: 28rpx 24rpx;
}

.summary-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.summary-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ===== 添加按钮 ===== */
.add-bar {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.add-btn {
  padding: 14rpx 40rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
  background: rgba(var(--primary-rgb), 0.08);
  border: 1rpx solid var(--primary);
}

/* ===== 录入表单 ===== */
.add-form {
  padding: 24rpx;
}

.form-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 72rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 14rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 140rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
  font-size: 26rpx;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.form-cancel {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--surface-soft);
}

.form-save {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  background: var(--primary);
}

/* ===== 加载中 ===== */
.loading-box {
  text-align: center;
  padding: 60rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
}

.loading-dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary);
  margin-right: 10rpx;
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

/* ===== 时间线主体 ===== */
.timeline {
  padding-left: 8rpx;
}

/* 日期分组头 */
.tl-date-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 0 10rpx;
}

.tl-date-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary);
  flex-shrink: 0;
}

.tl-date-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary);
}

/* 时间线条目 */
.tl-item {
  display: flex;
  gap: 14rpx;
  padding-bottom: 16rpx;
  position: relative;
}

.tl-item::after {
  content: '';
  position: absolute;
  left: 20rpx;
  top: 48rpx;
  bottom: 0;
  width: 2rpx;
  background: var(--border-color);
}

.tl-group:last-child .tl-item::after {
  display: none;
}

.tl-dot {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: var(--surface-soft);
  border: 2rpx solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  z-index: 1;
}

.tl-dot-big {
  width: 50rpx;
  height: 50rpx;
  background: rgba(245, 158, 11, 0.1);
  border-color: #f59e0b;
}

.tl-dot-emoji {
  font-size: 22rpx;
  line-height: 1;
}

.tl-card {
  flex: 1;
  min-width: 0;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}

.tl-card-highlight {
  background: rgba(245, 158, 11, 0.06);
  border-color: rgba(245, 158, 11, 0.25);
}

.tl-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4rpx;
}

.tl-card-label {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.tl-card-score {
  font-size: 22rpx;
  font-weight: 600;
}

.tl-card-score.pos { color: var(--primary); }
.tl-card-score.neg { color: var(--danger-text); }

.tl-card-name {
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.5;
  word-break: break-all;
}

.tl-card-big {
  font-size: 28rpx;
  font-weight: 600;
}

.tl-card-meta {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.tl-card-poem {
  font-size: 20rpx;
  color: var(--text-secondary);
  font-style: italic;
  margin-top: 6rpx;
  line-height: 1.6;
}

.tl-delete {
  font-size: 20rpx;
  color: var(--danger-text);
  opacity: 0.7;
}

/* ===== 空状态 ===== */
.empty-card {
  text-align: center;
  padding: 60rpx 24rpx;
}

.ec-icon {
  font-size: 64rpx;
  margin-bottom: 14rpx;
}

.ec-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.ec-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.ec-btn {
  display: inline-block;
  padding: 14rpx 40rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  background: var(--primary);
  border: none;
}
