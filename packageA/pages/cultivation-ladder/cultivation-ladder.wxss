.page{min-height:100vh;padding:40rpx;background:#1a1a2e;color:#fff}
.title{font-size:36rpx;font-weight:700;margin-bottom:32rpx}
.ladder{position:relative;padding-left:40rpx}
.ladder-line{position:absolute;left:19rpx;top:0;bottom:0;width:2rpx;background:linear-gradient(#3b82f6,#22c55e,#eab308,#efb810)}
.node{position:relative;padding:16rpx 0 16rpx 40rpx;display:flex;align-items:center;gap:16rpx}
.dot{position:absolute;left:-32rpx;width:16rpx;height:16rpx;border-radius:50%;background:#eab308;z-index:1}
.node-info{flex:1}.node-date{font-size:22rpx;color:#64748b}.node-text{font-size:26rpx;color:#fff}
.node-score{font-size:24rpx;color:#22c55e;font-weight:600}
.empty{text-align:center;color:#64748b;padding:120rpx 0}
