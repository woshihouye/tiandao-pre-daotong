/* 天道修行 - 自定义修行项目页 */

.container {
  min-height: 100vh;
  padding-bottom: 120rpx;
  background: var(--page-bg);
}

/* ===== 引导卡片 ===== */
.guide-card {
  margin: 20rpx 24rpx 8rpx;
  padding: 28rpx 28rpx 22rpx;
  border-radius: 16rpx;
  background: #FFFBF5;
  border: 1rpx solid #E8D5A3;
  box-shadow: 0 2rpx 12rpx rgba(139, 107, 20, 0.06);
}

.guide-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3d2e0a;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.guide-subtitle {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.6;
  margin-bottom: 20rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #f0e6cc;
}

.guide-features {
  display: flex;
  gap: 20rpx;
}

.guide-feat {
  flex: 1;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.guide-feat-icon {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #FAF0D7;
  font-size: 24rpx;
  color: #8B6914;
  flex-shrink: 0;
}

.guide-feat-info {
  flex: 1;
  min-width: 0;
}

.guide-feat-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #5a4010;
  margin-bottom: 4rpx;
}

.guide-feat-desc {
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.5;
}

/* ===== 分类 Tab ===== */
.category-tabs {
  display: flex;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: var(--card-bg);
  border-bottom: 1rpx solid var(--border-color);
}

.cat-tab {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
  white-space: nowrap;
}

.cat-tab.active {
  color: #fff;
  border-color: transparent;
}

/* ===== 预设卡片网格 ===== */
.preset-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding: 24rpx;
}

.preset-card {
  padding: 24rpx 20rpx;
  border-radius: 20rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
  transition: all 0.2s;
}

.preset-card:active {
  transform: scale(0.97);
  opacity: 0.8;
}

.preset-card.selected {
  border-width: 2rpx;
}

.preset-icon {
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.preset-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.4;
}

.preset-cname {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.3;
}

.preset-desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ===== 指标表单浮层 ===== */
.form-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.form-panel {
  width: 100%;
  max-height: 85vh;
  background: var(--card-bg);
  border-radius: 32rpx 32rpx 0 0;
  overflow-y: auto;
}

.form-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid var(--border-color);
  position: sticky;
  top: 0;
  background: var(--card-bg);
  z-index: 1;
}

.form-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.form-title-icon {
  font-size: 36rpx;
}

.form-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.form-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: var(--surface-soft);
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* 科学引用提示 */
.sci-ref {
  margin: 16rpx 32rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(99, 102, 241, 0.08);
  border-left: 3rpx solid #6366f1;
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.sci-ref text.s-label {
  font-weight: 700;
  color: #6366f1;
}

/* 指标项 */
.metrics-wrap {
  padding: 0 32rpx;
}

.metric-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.metric-item:last-child {
  border-bottom: none;
}

.metric-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.metric-label-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.metric-label-unit {
  font-size: 22rpx;
  color: var(--text-muted);
}

.metric-required {
  font-size: 20rpx;
  color: var(--danger-text);
  font-weight: 700;
}

.metric-tip {
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.4;
  margin-bottom: 10rpx;
}

.metric-input-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.metric-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
  font-size: 28rpx;
  color: var(--text-primary);
}

.metric-input-unit {
  font-size: 24rpx;
  color: var(--text-secondary);
  width: 60rpx;
  text-align: center;
}

/* Select */
.metric-picker {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
  font-size: 26rpx;
  color: var(--text-primary);
}

.metric-picker.placeholder {
  color: var(--text-muted);
}

.metric-picker-arrow {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* ===== 提交按钮 ===== */
.submit-area {
  padding: 24rpx 32rpx 40rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.submit-btn.disabled {
  opacity: 0.4;
}

/* ===== 结果展示 ===== */
.result-panel {
  margin: 0 24rpx 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
}

.result-score {
  text-align: center;
  margin-bottom: 20rpx;
}

.result-score-num {
  font-size: 64rpx;
  font-weight: 900;
  color: var(--primary);
  line-height: 1.2;
}

.result-score-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.result-metrics-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.result-metric-chip {
  padding: 10rpx 18rpx;
  border-radius: 14rpx;
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}

.chip-label {
  font-size: 20rpx;
  color: var(--text-muted);
}

.chip-value {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.chip-unit {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-left: 4rpx;
}

/* 积分明细 */
.breakdown-list {
  border-top: 1rpx solid var(--border-color);
  padding-top: 16rpx;
}

.breakdown-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.breakdown-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
  gap: 12rpx;
}

.breakdown-label {
  font-size: 24rpx;
  color: var(--text-primary);
  flex: 1;
}

.breakdown-detail {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-right: 12rpx;
}

.breakdown-contribution {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--primary);
  flex-shrink: 0;
}

/* ===== 历史记录 ===== */
.history-card {
  margin: 24rpx;
  border-radius: 20rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
  overflow: hidden;
}

.history-head {
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  border-bottom: 1rpx solid var(--border-color);
}

.history-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.history-item:last-child {
  border-bottom: none;
}

.history-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.history-info {
  flex: 1;
  min-width: 0;
}

.history-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.history-meta {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 2rpx;
}

.history-score {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--primary);
  flex-shrink: 0;
}

.history-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-muted);
}

/* ===== 根骨属性卡片 ===== */
/* 综合根骨条 */
.composite-strip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 12rpx 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(99, 102, 241, 0.1) 0%, rgba(139, 92, 246, 0.1) 100%);
  border: 1rpx solid rgba(99, 102, 241, 0.2);
}

.cs-label {
  font-size: 22rpx;
  color: var(--text-muted);
  flex-shrink: 0;
}

.cs-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
  flex: 1;
}

.cs-bonus {
  font-size: 22rpx;
  color: var(--primary);
  font-weight: 600;
}

.cs-score {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--primary);
}

/* 称号面板 */
.titles-panel {
  margin: 16rpx 24rpx;
}

.titles-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.titles-panel-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.titles-panel-close {
  font-size: 26rpx;
  color: var(--primary);
  padding: 8rpx 20rpx;
}

.titles-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.title-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
}

.title-card.unlocked {
  border-color: #f59e0b;
  background: rgba(245, 158, 11, 0.05);
}

.title-card.locked {
  opacity: 0.6;
}

.title-card-info {
  flex: 1;
  min-width: 0;
}

.title-card-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.title-card-desc {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.title-card-meta {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
}

.title-rarity {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: var(--surface-soft);
  color: var(--text-muted);
}

.title-rarity.top {
  background: #f59e0b;
  color: #fff;
}

.title-condition {
  font-size: 20rpx;
  color: var(--text-muted);
}

.title-card-status {
  flex-shrink: 0;
}

.title-unlocked {
  font-size: 32rpx;
  color: #f59e0b;
  font-weight: 700;
}

.title-locked {
  font-size: 28rpx;
  opacity: 0.4;
}
.bone-attr-card {
  margin: 16rpx 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
}

.bone-attr-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.bone-attr-icon {
  font-size: 48rpx;
  line-height: 1;
}

.bone-attr-info {
  flex: 1;
  min-width: 0;
}

.bone-attr-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.bone-attr-desc {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.bone-attr-badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.bone-attr-stats {
  display: flex;
  gap: 32rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-color);
}

.bone-stat-item {
  display: flex;
  flex-direction: column;
}

.bone-stat-val {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.bone-stat-label {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 2rpx;
}

.bone-attr-progress {
  margin-top: 16rpx;
}

.bone-attr-progress-bar {
  height: 10rpx;
  border-radius: 5rpx;
  background: var(--surface-soft);
  overflow: hidden;
}

.bone-attr-progress-fill {
  height: 100%;
  border-radius: 5rpx;
  transition: width 0.5s ease;
}

.bone-attr-progress-label {
  display: block;
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
  text-align: right;
}

/* ===== 添加项目栏 ===== */
.add-project-bar {
  padding: 16rpx 24rpx;
  text-align: center;
}

.add-project-btn {
  display: inline-block;
  padding: 16rpx 48rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
  background: var(--surface-soft);
  border: 1rpx dashed var(--primary);
  transition: all 0.2s;
}

.add-project-btn:active {
  background: var(--primary-light);
  border-color: var(--primary);
}

/* ===== 添加项目弹窗 ===== */
.add-picker-list {
  max-height: 600rpx;
  padding: 0 8rpx;
}

.add-picker-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 16rpx;
  border-radius: 14rpx;
  margin-bottom: 8rpx;
  background: var(--surface-soft);
  border: 1rpx solid transparent;
  transition: all 0.15s;
}

.add-picker-item.checked {
  background: var(--primary-light);
  border-color: var(--primary);
}

.add-picker-checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--border-color);
  font-size: 24rpx;
  color: var(--primary);
  flex-shrink: 0;
}

.add-picker-item.checked .add-picker-checkbox {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
}

.add-picker-info {
  flex: 1;
  min-width: 0;
}

.add-picker-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.add-picker-desc {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.add-picker-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-color);
}

.add-picker-cancel {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary);
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}

.add-picker-save {
  flex: 2;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.mp-search-box {
  padding: 0 16rpx;
}

.mp-search-input {
  height: 68rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
  font-size: 26rpx;
  color: var(--text-primary);
}

.mp-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-muted);
}
