.breakthrough-page{min-height:100vh;background:#0f172a;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;padding:40rpx;overflow:hidden}
.phase-prepare,.phase-animate,.phase-settle{display:flex;flex-direction:column;align-items:center;width:100%}
.ritual-title{font-size:36rpx;color:#eab308;text-align:center;margin-bottom:32rpx;line-height:1.6}
.ritual-poem{font-size:28rpx;color:#94a3b8;white-space:pre-line;text-align:center;margin-bottom:48rpx;line-height:2}
.ritual-btn{background:linear-gradient(135deg,#eab308,#f59e0b);color:#0f172a;padding:24rpx 80rpx;border-radius:48rpx;font-size:32rpx;font-weight:700}
.anim-container{width:400rpx;height:400rpx;position:relative;display:flex;align-items:center;justify-content:center}
.anim-core{width:80rpx;height:80rpx;background:radial-gradient(circle,#eab308,#b45309);border-radius:50%;display:flex;align-items:center;justify-content:center;z-index:3}
.anim-icon{font-size:40rpx;color:#fff}
@keyframes corePulse{0%,100%{transform:scale(1)}50%{transform:scale(1.2)}}
.anim-ring{position:absolute;border-radius:50%;border:2rpx solid rgba(234,179,8,.3);animation:ringExpand 3s ease-out infinite}
.r1{width:160rpx;height:160rpx}.r2{width:260rpx;height:260rpx}.r3{width:360rpx;height:360rpx}
@keyframes ringExpand{0%{transform:scale(.8);opacity:.6}100%{transform:scale(1.4);opacity:0}}
.anim-dot{position:absolute;width:8rpx;height:8rpx;background:#eab308;border-radius:50%;opacity:0;animation:dotFloat 3s ease-out infinite;animation-delay:var(--delay);left:50%;top:50%;transform:translate(-50%,-50%) rotate(calc(var(--i)*45deg)) translateY(-120rpx)}
@keyframes dotFloat{0%{opacity:0;transform:translate(-50%,-50%)rotate(0deg)translateY(-80rpx)}50%{opacity:.8}100%{opacity:0;transform:translate(-50%,-50%)rotate(360deg)translateY(-160rpx)}}
.anim-progress-bar{width:500rpx;height:6rpx;background:rgba(255,255,255,.1);border-radius:3rpx;margin-top:40rpx;overflow:hidden}
.anim-progress-fill{height:100%;background:linear-gradient(90deg,#eab308,#f59e0b);border-radius:3rpx;transition:width .2s}
.anim-text{color:#94a3b8;font-size:26rpx;margin-top:24rpx}
.skip-btn{color:#64748b;font-size:24rpx;margin-top:32rpx;padding:12rpx 32rpx;border:1rpx solid #334155;border-radius:24rpx}
.settle-header{text-align:center;margin-bottom:40rpx}
.settle-icon{font-size:80rpx;margin-bottom:16rpx}
.settle-title{font-size:40rpx;font-weight:700;color:#eab308;margin-bottom:12rpx}
.settle-new-realm{font-size:60rpx;font-weight:900;background:linear-gradient(135deg,#eab308,#f59e0b,#fff);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.settle-card{background:rgba(30,41,59,.8);border-radius:24rpx;padding:32rpx;width:100%;margin-bottom:24rpx}
.settle-section-title{font-size:28rpx;color:#94a3b8;margin-bottom:16rpx;font-weight:600}
.settle-row{display:flex;justify-content:space-between;align-items:center;padding:12rpx 0;border-bottom:1rpx solid rgba(255,255,255,.05)}
.settle-row:last-child{border:none}
.settle-label{font-size:26rpx;color:#94a3b8}
.settle-value{font-size:26rpx;color:#fff;font-weight:600}
.grade-xian{color:#efb810;font-size:30rpx}.grade-ji{color:#eab308}.grade-shang{color:#3b82f6}.grade-zhong{color:#22c55e}
.bonus{color:#22c55e}.new-feature{color:#eab308;flex:none}
.settle-error{color:var(--danger-text);text-align:center;margin:40rpx 0;font-size:28rpx}
.confirm-btn{background:linear-gradient(135deg,#1e293b,#0f172a);color:#eab308;padding:24rpx 80rpx;border-radius:48rpx;font-size:32rpx;font-weight:700;margin-top:40rpx;border:1rpx solid rgba(234,179,8,.3)}
