.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
  background: var(--page-bg);
}

.tabs {
  margin-bottom: 0;
  display: flex;
  gap: 12rpx;
  padding: 16rpx;
}

.tab {
  flex: 1;
  min-height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.06);
}

.tab.active {
  color: #ffffff;
  font-weight: 700;
  background: var(--primary);
}

.upload-card {
  overflow: hidden;
}

.upload-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
}

.upload-kicker {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.upload-title {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.5;
}

.upload-icon {
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--primary);
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}

.upload-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 26rpx;
}

.upload-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.upload-btn.primary {
  color: #ffffff;
  background: var(--primary);
}

.upload-btn.ghost {
  color: var(--text-primary);
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}

.upload-hint {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-secondary);
}

.preview-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.5;
}

.preview-image-wrap {
  width: 100%;
  height: 400rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
  margin-top: 18rpx;
}

.preview-image {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

/* 半透明 loading 遮罩：覆盖在图片上方，不隐藏图片 */
.preview-loading-mask {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  background: rgba(0, 0, 0, 0.35);
  z-index: 2;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-status-text {
  font-size: 26rpx;
  color: #ffffff;
  line-height: 1.5;
}

.upload-status {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}

.upload-status-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.upload-status-text.uploaded {
  color: var(--primary);
}

.upload-status-text.error {
  color: var(--danger-text);
}

.preview-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.preview-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.result-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.scene-badge {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--primary);
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
  line-height: 1.5;
}

.scene-switch {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.scene-btn {
  flex: 1;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}

.scene-btn.active {
  color: #ffffff;
  background: var(--primary);
}

.result-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.result-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.result-item {
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}

.result-top {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.result-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.result-source {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--primary);
  background: var(--surface-muted);
  line-height: 1.5;
}

.result-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx 16rpx;
  margin-top: 16rpx;
}

.result-field {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.result-bottom {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.result-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 26rpx;
}

.confirm-btn,
.cancel-btn {
  flex: 1;
  min-width: 210rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.confirm-btn {
  color: #ffffff;
  background: var(--primary);
}

.cancel-btn {
  color: var(--text-primary);
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}

.hidden-canvas {
  position: absolute;
  left: -9999px;
  top: -9999px;
  width: 10px;
  height: 10px;
}

.editor-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.7);
}

.editor-panel {
  width: 100%;
  max-height: 86vh;
  padding: 34rpx 24rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: var(--card-bg);
  box-sizing: border-box;
}

.editor-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.5;
}

.editor-form {
  max-height: 56vh;
  margin-top: 24rpx;
  overflow-y: auto;
}

.editor-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.editor-label {
  width: 150rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.editor-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
  color: var(--text-primary);
  font-size: 26rpx;
}

.editor-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 24rpx;
}

.editor-btn {
  flex: 1;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.editor-btn.primary {
  color: #ffffff;
  background: var(--primary);
}

.editor-btn.ghost {
  color: var(--text-primary);
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}

/* ============================================================ */
/* 批量上传模式样式 */
/* ============================================================ */

.upload-actions-batch {
  margin-top: 12rpx;
}

.batch-btn {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary);
  background: rgba(212, 175, 55, 0.08);
  border: 1rpx solid rgba(212, 175, 55, 0.25);
}

.batch-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.batch-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.batch-count {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.batch-progress-wrap {
  margin-top: 22rpx;
}

.batch-progress-bar {
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.batch-progress-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, var(--primary), #c9a84c);
  transition: width 0.3s ease;
}

.batch-progress-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: center;
}

.batch-complete-text {
  font-size: 26rpx;
  color: var(--text-primary);
  text-align: center;
  line-height: 1.5;
}

.batch-result-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.batch-result-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.batch-result-item:last-child {
  border-bottom: none;
}

.batch-result-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.04);
}

.batch-thumb-img {
  width: 100%;
  height: 100%;
}

.batch-result-body {
  flex: 1;
  min-width: 0;
}

.batch-result-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.4;
}

.batch-result-name.error-text {
  color: var(--danger-text);
}

.batch-result-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 6rpx;
}

.batch-type-badge {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.5;
  color: var(--primary);
  background: rgba(212, 175, 55, 0.1);
}

.batch-type-badge.sport { color: #3b82f6; background: rgba(59, 130, 246, 0.1); }
.batch-type-badge.diet { color: #22c55e; background: rgba(34, 197, 94, 0.1); }
.batch-type-badge.study { color: #8b5cf6; background: rgba(139, 92, 246, 0.1); }
.batch-type-badge.work { color: #f59e0b; background: rgba(245, 158, 11, 0.1); }
.batch-type-badge.debuff { color: var(--danger-text); background: rgba(239, 68, 68, 0.1); }
.batch-type-badge.error { color: var(--danger-text); background: rgba(239, 68, 68, 0.1); }

.batch-result-source {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.batch-result-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx 16rpx;
  margin-top: 8rpx;
}

.batch-result-field {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.batch-result-del {
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--danger-text);
  background: rgba(239, 68, 68, 0.08);
  flex-shrink: 0;
}

.batch-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-secondary);
}
