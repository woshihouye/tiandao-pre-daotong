.page{min-height:100vh;padding:40rpx;background:#1a1a2e;color:#fff}
.title{font-size:36rpx;font-weight:700;margin-bottom:24rpx}
.pill-card{background:rgba(30,41,59,.8);border-radius:24rpx;padding:24rpx;margin-bottom:20rpx}
.pill-header{display:flex;align-items:center;gap:12rpx;margin-bottom:12rpx}
.pill-icon{font-size:40rpx}.pill-name{font-size:28rpx;font-weight:600;flex:1}
.pill-qty{font-size:24rpx;color:#94a3b8;background:rgba(255,255,255,.1);padding:4rpx 16rpx;border-radius:16rpx}
.pill-desc{font-size:24rpx;color:#94a3b8;margin-bottom:16rpx}
.pill-footer{display:flex;justify-content:space-between;align-items:center}
.pill-effect{font-size:22rpx;color:#22c55e}
.pill-use-btn{padding:8rpx 32rpx;background:#eab308;color:#0f172a;border-radius:24rpx;font-size:24rpx;font-weight:600}
.pill-use-btn.disabled{background:#334155;color:#64748b}
.empty{text-align:center;color:#64748b;padding:120rpx 0;font-size:26rpx}
