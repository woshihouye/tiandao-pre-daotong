.page {
  min-height: 100vh;
  background: var(--page-bg);
  margin-top: 0;
  padding-top: 0;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

.card {
  margin: 24rpx 24rpx 0;
  padding: 26rpx;
  border-radius: 24rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
  box-sizing: border-box;
}

.overview {
  margin-top: 0;
}

.overview-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.overview-kicker {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.overview-title {
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.5;
}

.overview-badge {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
  background: var(--primary);
  line-height: 1.5;
}

.overview-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 22rpx;
}

.metric {
  padding: 18rpx;
  border-radius: 20rpx;
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}

.metric-value {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.5;
}

.metric-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.bar {
  margin-top: 22rpx;
}

.bar-track {
  width: 100%;
  height: 18rpx;
  border-radius: 999rpx;
  background: var(--surface-soft);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--primary);
}

.bar-note {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.hint {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}

.hint-text {
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-secondary);
}

.hint-btn {
  margin-top: 14rpx;
  height: 76rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #ffffff;
  background: var(--primary);
}

.tabbar {
  display: flex;
  gap: 12rpx;
  padding: 18rpx;
}

.tab {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
  line-height: 1.5;
}

.tab.active {
  color: #ffffff;
  font-weight: 700;
  background: var(--primary);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.5;
}

.section-subtitle {
  margin-top: 22rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.5;
}

.paragraph {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-primary);
}

.small-note {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-secondary);
}

.block {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}

.block-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.block-value {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-primary);
  word-break: break-all;
}

.block-value.highlight {
  color: var(--primary);
  font-weight: 700;
}

.goal-tabs {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.goal-tab {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
  line-height: 1.5;
}

.goal-tab.active {
  color: #ffffff;
  font-weight: 700;
  background: var(--primary);
}

.macro-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.macro {
  padding: 18rpx;
  border-radius: 20rpx;
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}

.macro-value {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.5;
}

.macro-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.compare {
  margin-top: 16rpx;
}

.compare-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.compare-row:last-child {
  border-bottom: none;
}

.compare-name {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.compare-value {
  font-size: 24rpx;
  color: var(--text-primary);
  line-height: 1.5;
}

.score-card {
  margin-top: 16rpx;
  display: flex;
  gap: 16rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}

.score-left {
  width: 220rpx;
  flex-shrink: 0;
}

.score-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.5;
}

.score-grade {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.score-right {
  flex: 1;
  min-width: 0;
}

.score-bonus {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.5;
}

.score-note {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-secondary);
}

.form {
  margin-top: 16rpx;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  width: 210rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.form-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
  color: var(--text-primary);
  font-size: 24rpx;
  box-sizing: border-box;
}

.picker-value {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 24rpx;
  color: var(--text-primary);
  line-height: 1.5;
}

.action {
  margin-top: 22rpx;
}

.btn {
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.btn.primary {
  color: #ffffff;
  background: var(--primary);
}

.btn.primary.disabled {
  opacity: 0.45;
}
