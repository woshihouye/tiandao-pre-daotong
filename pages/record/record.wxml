<!-- pages/record/record.wxml — 快速打卡+精细记录双模式 -->

<!-- ==================== 快速打卡模式 ==================== -->
<view class="page-container" wx:if="{{mode === 'fuzzy'}}">
  <!-- 顶部 Tab 栏 -->
  <view class="tab-bar">
    <view
      wx:for="{{tabs}}"
      wx:key="id"
      class="tab-item {{activeTab === item.id ? 'active' : ''}}"
      style="color: {{activeTab === item.id ? item.color : '#9CA3AF'}}; border-bottom-color: {{activeTab === item.id ? item.color : 'transparent'}}"
      data-tab="{{item.id}}"
      bindtap="onTabTap"
    >
      <text class="tab-text">{{item.name}}</text>
    </view>
  </view>

  <!-- 全屏卡片轮播区 -->
  <swiper
    class="card-swiper"
    current="{{currentTemplateIndex}}"
    previous-margin="15%"
    next-margin="15%"
    duration="280"
    easing-function="easeOutCubic"
    bindchange="onSwiperChange"
  >
    <swiper-item wx:for="{{templates}}" wx:key="id" wx:for-index="idx">
      <view
        class="template-card {{item.bgClass || ''}}"
        style="--card-bg: {{item.bgStyle || ''}}; --fill-height: {{item.totalProgress || 0}}%;"
        data-index="{{idx}}"
        bindtouchstart="onCardTouchStart"
        bindtouchmove="onCardTouchMove"
        bindtouchend="onCardTouchEnd"
        bindtap="onCardTap"
      >
        <!-- 背景填充层 -->
        <view class="card-fill" style="height: {{item.totalProgress || 0}}%; background: linear-gradient(to top, {{activeColor}}, {{activeColor}}88);"></view>
        <!-- 发光环 -->
        <view class="card-glow" wx:if="{{item.totalProgress >= 100}}"></view>
        <!-- 卡片内容 -->
        <view class="card-content">
          <text class="card-name {{item.totalProgress > 60 ? 'light-text' : ''}}">{{item.name}}</text>
          <text class="card-progress {{item.totalProgress > 40 ? 'light-text' : ''}}">{{item.totalProgress || 0}}%</text>
          <text class="card-score {{item.totalProgress > 60 ? 'light-text' : ''}}">预计修为 {{item.estimatedScore || '+0'}}</text>
          <text class="card-hint {{item.totalProgress > 60 ? 'light-text' : ''}}">点击精细记录</text>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{templates.length === 0}}">
    <text class="empty-icon">{{tabIcon}}</text>
    <text class="empty-text">暂无可用的修行模板</text>
    <text class="empty-sub">请先在活动库中选择活动组成模板</text>
  </view>

  <!-- 结果面板 -->
  <view class="result-section">
    <daily-result-panel activeCategory="{{activeTab}}" result="{{result}}" />
  </view>

  <!-- 底部提交按钮 -->
  <view class="submit-bar">
    <view class="submit-btn" style="background-color: {{activeColor}}" bindtap="onSubmit">
      <text class="submit-text">{{submitting ? '提交中...' : '确认今日修行'}}</text>
    </view>
  </view>
</view>

  <!-- 提交即时反馈轻提示 -->
  <view class="submit-feedback-mask" wx:if="{{submitFeedback}}" catchtap="">
    <view class="submit-feedback">
      <view class="sf-score">修为 {{submitFeedback.gongText}}</view>
      <view class="sf-formula" wx:for="{{submitFeedback.formulaList}}" wx:key="*this">{{item}}</view>
      <view class="sf-subtitle" wx:if="{{submitFeedback.totalCount && submitFeedback.totalCount > (submitFeedback.formulaList ? submitFeedback.formulaList.length : 999)}}">共 {{submitFeedback.totalCount}} 条，此处展示前 {{submitFeedback.formulaList ? submitFeedback.formulaList.length : 0}} 条</view>
      <view class="sf-primary-btn" catchtap="closeSubmitFeedback">知道了</view>
    </view>
  </view>

<!-- ==================== 精细记录模式 ==================== -->
<view class="page-container precise-mode" wx:if="{{mode === 'precise'}}">
  <!-- 顶部导航栏 -->
  <view class="precise-header">
    <view class="precise-back" bindtap="onPreciseBack">
      <text class="precise-back-icon">←</text>
      <text class="precise-back-text">返回</text>
    </view>
    <text class="precise-title">{{currentTemplate.name}}</text>
    <view class="precise-placeholder"></view>
  </view>

  <!-- 活动列表（按时段分组） -->
  <scroll-view class="precise-scroll" scroll-y>
    <view wx:if="{{currentTemplate && currentTemplate.schedule && currentTemplate.schedule.length > 0}}">
      <view wx:for="{{currentTemplate.schedule}}" wx:key="id" class="slot-group">
        <!-- 时段标题 -->
        <view class="slot-header">
          <view class="slot-header-bar" style="background-color: {{activeColor}}"></view>
          <text class="slot-header-name">{{item.name}}</text>
          <text class="slot-header-time" wx:if="{{item.startTime}}">{{item.startTime}} - {{item.endTime}}</text>
        </view>
        <!-- 该时段下的活动 -->
        <view wx:for="{{item.activities}}" wx:for-item="act" wx:key="id" class="activity-row"
          bindtouchstart="onActivityTouchStart"
          bindtouchmove="onActivityTouchMove"
          bindtouchend="onActivityTouchEnd"
          data-act-id="{{act.id}}">
          <!-- 进度填充背景 -->
          <view class="act-row-fill" style="width: {{activityProgress[act.id] || 0}}%; background: linear-gradient(to right, {{activeColor}}44, {{activeColor}}88);"></view>
          <!-- 活动信息 -->
          <view class="act-row-content">
            <view class="act-row-left">
              <text class="act-row-name">{{act.name}}</text>
              <text class="public-badge" wx:if="{{act.isPublicLibrary}}">+10% 公共</text>
              <text class="act-row-unit">{{act.scorePerUnit >= 0 ? '+' : ''}}{{act.scorePerUnit}}/{{act.unit}}</text>
            </view>
            <view class="act-row-right">
              <text class="act-row-progress">{{activityProgress[act.id] || 0}}%</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 无时段数据时的降级显示 -->
    <view class="slot-group" wx:if="{{currentTemplate && (!currentTemplate.schedule || currentTemplate.schedule.length === 0) && currentTemplate.activities && currentTemplate.activities.length > 0}}">
      <view class="slot-header">
        <view class="slot-header-bar" style="background-color: {{activeColor}}"></view>
        <text class="slot-header-name">全部活动</text>
      </view>
      <view wx:for="{{currentTemplate.activities}}" wx:for-item="act" wx:key="id" class="activity-row"
        bindtouchstart="onActivityTouchStart"
        bindtouchmove="onActivityTouchMove"
        bindtouchend="onActivityTouchEnd"
        data-act-id="{{act.id}}">
        <view class="act-row-fill" style="width: {{activityProgress[act.id] || 0}}%; background: linear-gradient(to right, {{activeColor}}44, {{activeColor}}88);"></view>
        <view class="act-row-content">
          <view class="act-row-left">
            <text class="act-row-name">{{act.name}}</text>
            <text class="public-badge" wx:if="{{act.isPublicLibrary}}">+10% 公共</text>
            <text class="act-row-unit">{{act.scorePerUnit >= 0 ? '+' : ''}}{{act.scorePerUnit}}/{{act.unit}}</text>
          </view>
          <view class="act-row-right">
            <text class="act-row-progress">{{activityProgress[act.id] || 0}}%</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 空活动提示 -->
    <view class="empty-state" wx:if="{{!currentTemplate || !currentTemplate.activities || currentTemplate.activities.length === 0}}">
      <text class="empty-text">该模板暂无活动</text>
    </view>
  </scroll-view>

  <!-- 结果面板 -->
  <view class="result-section">
    <daily-result-panel activeCategory="{{activeTab}}" result="{{result}}" />
  </view>

  <!-- 底部提交按钮 -->
  <view class="submit-bar">
    <view class="submit-btn" style="background-color: {{activeColor}}" bindtap="onSubmit">
      <text class="submit-text">{{submitting ? '提交中...' : '确认今日修行'}}</text>
    </view>
  </view>
</view>
