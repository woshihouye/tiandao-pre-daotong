/* 首页极简主题 */

.vision-entry,
.realm-card,
.template-status,
.timeline-card {
  overflow: hidden;
}

.vision-entry {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--space-md);
  margin-top: var(--space-xl);
}

.vision-left {
  flex: 1;
  min-width: 0;
}

.vision-kicker,
.realm-kicker,
.panel-title {
  font-size: var(--font-md);
  color: var(--text-secondary);
  letter-spacing: 2rpx;
  line-height: 1.5;
}

.vision-title,
.card-title {
  margin-top: var(--space-sm);
  font-size: var(--font-2xl);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  line-height: 1.5;
}

.vision-desc,
.status-empty,
.template-sub,
.record-category,
.record-time,
.ring-label,
.mini-label {
  margin-top: var(--space-xs);
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}

.vision-icon,
.action-emblem,
.empty-icon {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-xl);
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
  color: var(--primary);
  font-size: var(--font-2xl);
  font-weight: var(--weight-bold);
}

.action-emblem.danger {
  color: var(--danger-text);
}

.action-emblem.muted {
  background: var(--surface-muted);
  color: var(--text-muted);
  border-color: var(--border-color);
}

.action-card.disabled {
  opacity: 0.5;
}

.action-card.disabled .action-name {
  color: var(--text-muted);
}

.action-card.disabled .action-desc {
  color: var(--text-muted);
}

.realm-card {
  margin-top: var(--space-xl);
}

.realm-headline,
.template-panel-top,
.record-top,
.record-bottom,
.ability-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--space-md);
}

.realm-headline {
  margin-bottom: var(--space-xl);
}

.realm-title {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: var(--space-xs);
}

.realm-name,
.template-name {
  font-size: var(--font-2xl);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  line-height: 1.5;
}

.realm-stage {
  font-size: var(--font-lg);
  color: var(--text-secondary);
  line-height: 1.5;
}

.realm-number,
.template-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: var(--space-xs);
}

.realm-value,
.ring-value,
.mini-value {
  font-size: var(--font-2xl);
  font-weight: var(--weight-bold);
  color: var(--primary);
  line-height: 1.5;
}

.realm-unit {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}

.realm-progress-card,
.mini-stat,
.timeline-box,
.match-badge,
.status-chip,
.system-card {
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
  border-radius: var(--radius-lg);
}

.realm-progress-card {
  padding: var(--space-xl);
}

.realm-progress-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}

.remaining {
  color: var(--primary);
  font-weight: var(--weight-bold);
}

.realm-progress-bar {
  height: 18rpx;
}

.realm-foot {
  display: flex;
  gap: var(--space-md);
  padding-top: var(--space-xl);
}

.mini-stat {
  flex: 1;
  padding: var(--space-md) var(--space-lg);
}

.align-right {
  align-items: flex-end;
}

.system-card {
  padding-top: var(--space-xl);
  padding-bottom: var(--space-xl);
}

.system-message {
  font-size: var(--font-lg);
  line-height: 1.5;
  color: var(--text-primary);
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0;
}

/* 快捷录入横滑行（A1 顺序 3） */
.quick-row { padding: 20rpx 24rpx 4rpx; }
.quick-scroll { width: 100%; white-space: nowrap; }
.quick-list {
  display: inline-flex;
  gap: 18rpx;
  padding-right: 24rpx;
}
.quick-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  min-width: 144rpx;
  padding: 18rpx 10rpx 16rpx;
}
.quick-emblem {
  width: 84rpx; height: 84rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #10b981, #059669);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(16,185,129,0.25);
}
.qe-text { font-size: 34rpx; font-weight: 800; color: #fff; }
.quick-emblem.qe-orange { background: linear-gradient(135deg, #f59e0b, #d97706); box-shadow: 0 6rpx 18rpx rgba(245,158,11,0.25); }
.quick-emblem.qe-red    { background: linear-gradient(135deg, #ef4444, #b91c1c); box-shadow: 0 6rpx 18rpx rgba(239,68,68,0.25); }
.quick-emblem.qe-violet { background: linear-gradient(135deg, #8b5cf6, #6d28d9); box-shadow: 0 6rpx 18rpx rgba(139,92,246,0.25); }
.quick-emblem.qe-ink    { background: linear-gradient(135deg, #374151, #1f2937); box-shadow: 0 6rpx 18rpx rgba(55,65,81,0.25); }
.quick-emblem.qe-cyan   { background: linear-gradient(135deg, #06b6d4, #0891b2); box-shadow: 0 6rpx 18rpx rgba(6,182,212,0.25); }
.quick-label {
  font-size: 24rpx; font-weight: 600; color: #374151;
  white-space: nowrap;
}

/* 胶囊行（A1 顺序 6） */
.capsules-section {
  padding: 8rpx 20rpx 4rpx;
}
.capsules-scroll { width: 100%; white-space: nowrap; }
.capsules-list {
  display: inline-flex;
  gap: 18rpx;
  padding-right: 24rpx;
}
.capsule {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 22rpx;
  border-radius: 60rpx;
  background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.06);
  border: 1rpx solid #f3f4f6;
  min-width: 280rpx;
  max-width: 520rpx;
}
.cap-icon { font-size: 32rpx; flex-shrink: 0; }
.cap-body {
  display: inline-flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
  flex: 1;
  max-width: 420rpx;
}
.cap-title {
  font-size: 24rpx; font-weight: 700; color: #111827;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.cap-sub {
  font-size: 22rpx; color: #6b7280;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.cap-sub.poem-sub {
  white-space: normal;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.capsule.cap-bu     { background: linear-gradient(135deg, #fef3c7, #fff7ed); border-color: #fde68a; }
.capsule.cap-elite  { background: linear-gradient(135deg, #ede9fe, #f5f3ff); border-color: #c4b5fd; }
.capsule.cap-elite.entry { background: linear-gradient(135deg, #fef9c3, #fefce8); border-color: #fde047; }
.capsule.cap-fortune{ background: linear-gradient(135deg, #fee2e2, #fef2f2); border-color: #fecaca; }
.capsule.cap-tpl    { background: linear-gradient(135deg, #dbeafe, #eff6ff); border-color: #bfdbfe; }
.capsule.cap-poem   { background: linear-gradient(135deg, #ecfdf5, #f0fdf4); border-color: #a7f3d0; }

.action-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 220rpx;
  margin: 0 0 var(--space-xl);
  padding: var(--space-xl) var(--space-lg);
  text-align: center;
}

.action-name {
  margin-top: var(--space-md);
  font-size: var(--font-xl);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  line-height: 1.5;
}

.action-desc {
  margin-top: var(--space-xs);
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}

.status-chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-top: var(--space-lg);
}

.status-chip {
  max-width: 100%;
  padding: var(--space-xs) var(--space-md);
  font-size: var(--font-md);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.5;
}

.status-chip.buff {
  color: var(--success);
}

.status-chip.debuff {
  color: var(--danger-text);
}

.template-panel-body {
  display: flex;
  align-items: center;
  gap: var(--space-xl);
}

.match-badge {
  padding: var(--space-xs) var(--space-md);
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--primary);
}

.ring-shell {
  width: 208rpx;
  min-width: 208rpx;
  display: flex;
  justify-content: center;
}

.ring-progress {
  width: 192rpx;
  height: 192rpx;
  padding: var(--space-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}

.ring-inner {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--card-bg);
  border: 1rpx solid rgba(var(--primary-rgb), 0.16);
}

.ability-panel {
  flex: 1;
  min-width: 0;
}

.ability-row + .ability-row {
  margin-top: var(--space-md);
}

.ability-head {
  margin-bottom: var(--space-xs);
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}

.ability-track {
  width: 100%;
  height: 12rpx;
  overflow: hidden;
  border-radius: var(--radius-full);
  background: var(--surface-soft);
}

.ability-fill,
.ability-fill.soft,
.ability-fill.faint,
.ability-fill.solid {
  height: 100%;
  border-radius: inherit;
  background: var(--primary);
}

.timeline-card {
  min-height: 320rpx;
}

.card-header {
  margin-bottom: var(--space-xl);
}

.timeline-scroll {
  max-height: 640rpx;
}

.timeline {
  position: relative;
}

.timeline-item {
  position: relative;
  padding-left: var(--space-2xl);
}

.timeline-item + .timeline-item {
  margin-top: var(--space-md);
}

.timeline-line {
  position: absolute;
  left: var(--space-sm);
  top: 22rpx;
  bottom: -22rpx;
  width: 2rpx;
  background: var(--border-color);
}

.timeline-item:last-child .timeline-line {
  display: none;
}

.timeline-dot {
  position: absolute;
  left: 0;
  top: 10rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--success);
}

.timeline-dot.negative {
  background: var(--danger);
}

.timeline-box {
  padding: var(--space-lg) 22rpx;
}

.record-top,
.record-bottom {
  align-items: center;
}

.record-name {
  flex: 1;
  min-width: 0;
  font-size: var(--font-xl);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.5;
}

.record-score {
  font-size: var(--font-xl);
  font-weight: var(--weight-bold);
  line-height: 1.5;
}

.record-bottom {
  margin-top: var(--space-sm);
}

.empty-state {
  padding: 88rpx 0 64rpx;
  text-align: center;
}

.empty-text {
  margin-top: var(--space-md);
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}

@keyframes pulseScore {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.04); }
}

.animate-score {
  animation: pulseScore 0.3s ease-out;
}

/* ═══════════════════════════════════════════
   系统面板 - 每日任务
   ═══════════════════════════════════════════ */
.tasks-card {
  margin-top: var(--space-xl);
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: var(--space-md);
}

.task-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-lg) 22rpx;
  border-radius: var(--radius-md);
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
  transition: all 0.3s ease;
}

.task-item.task-done {
  opacity: 0.5;
  background: var(--surface-muted);
}

.task-left {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  flex: 1;
  min-width: 0;
}

.task-emoji {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
}

.task-body {
  flex: 1;
  min-width: 0;
}

.task-label {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  line-height: 1.5;
}

.task-reward {
  margin-top: 4rpx;
  font-size: var(--font-sm);
  color: var(--primary);
  line-height: 1.5;
}

.task-check {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 2rpx solid var(--border-color);
  font-size: var(--font-md);
  color: transparent;
  transition: all 0.3s ease;
}

.task-check.checked {
  border-color: var(--primary);
  background: var(--primary);
  color: #fff;
}

/* ═══════════════════════════════════════════
   系统面板 - 运势
   ═══════════════════════════════════════════ */
.fortune-card {
  margin-top: var(--space-xl);
}

.fortune-main {
  margin-top: var(--space-md);
  padding: var(--space-xl) var(--space-xl);
  border-radius: var(--radius-lg);
  background: var(--surface-soft);
  text-align: center;
}

.fortune-level {
  font-size: var(--font-4xl);
  font-weight: var(--weight-bold);
  line-height: 1.5;
}

.fortune-daji { color: var(--danger-text); }
.fortune-ji { color: #f59e0b; }
.fortune-ping { color: var(--text-secondary); }
.fortune-xiong { color: #8b5cf6; }
.fortune-daxiong { color: #1e1b4b; }

.fortune-desc {
  margin-top: var(--space-sm);
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.6;
}

/* ═══════════════════════════════════════════
   系统面板 - 定场诗
   ═══════════════════════════════════════════ */
.poem-card {
  margin-top: var(--space-xl);
  position: relative;
  padding: var(--space-2xl) var(--space-2xl);
  text-align: center;
  background: linear-gradient(135deg, var(--card-bg) 0%, var(--surface-soft) 100%);
  border: 1rpx solid rgba(var(--primary-rgb), 0.2);
}

.poem-deco {
  position: absolute;
  font-size: 48rpx;
  color: rgba(var(--primary-rgb), 0.15);
  font-weight: var(--weight-bold);
  line-height: 1;
}

.poem-deco:first-child {
  top: var(--space-md);
  left: var(--space-xl);
}

.poem-deco.right {
  bottom: var(--space-md);
  right: var(--space-xl);
}

.poem-text {
  font-size: var(--font-2xl);
  font-weight: var(--weight-medium);
  color: var(--text-primary);
  line-height: 2;
  letter-spacing: 2rpx;
}

/*
   系统面板 - 突破仪式弹窗
*/
/* v4.0: 突破预警条 */
.breakthrough-warn {
  position: relative;
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-lg) var(--space-xl);
  background: linear-gradient(135deg, rgba(234,179,8,0.15), rgba(245,158,11,0.08));
  border: 1rpx solid rgba(234,179,8,0.3);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-top: var(--space-md);
}
.bw-glow {
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(234,179,8,0.2), transparent);
  border-radius: 50%;
  animation: bwPulse 2s ease infinite;
}
@keyframes bwPulse {
  0%, 100% { transform: scale(1); opacity: 0.4; }
  50% { transform: scale(1.3); opacity: 0.8; }
}
.bw-icon { font-size: var(--font-3xl); z-index: 1; }
.bw-text { flex: 1; display: flex; flex-direction: column; z-index: 1; }
.bw-title { font-size: var(--font-xl); font-weight: var(--weight-bold); color: #eab308; }
.bw-sub { font-size: var(--font-sm); color: #94a3b8; margin-top: 4rpx; }
.bw-arrow { font-size: var(--font-xl); color: #eab308; z-index: 1; }

/* v4.0 补天计划入口 */
.butian-entry {
  padding: var(--space-xl);
  background: linear-gradient(135deg, rgba(139,92,246,0.1), rgba(234,179,8,0.08));
  border: 1rpx solid rgba(139,92,246,0.25);
  border-radius: var(--radius-lg);
  margin-top: var(--space-md);
}
.bte-header {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: var(--space-xs);
}
.bte-icon { font-size: var(--font-2xl); }
.bte-title { flex: 1; font-size: var(--font-xl); font-weight: var(--weight-bold); color: #eab308; }
.bte-arrow { font-size: var(--font-md); color: #8b5cf6; }
.bte-desc { font-size: var(--font-sm); color: #94a3b8; margin-bottom: var(--space-sm); }
.bte-phase { display: flex; align-items: center; gap: var(--space-sm); margin-bottom: var(--space-xs); }
.bte-phase-name { font-size: var(--font-sm); color: #8b5cf6; white-space: nowrap; }
.bte-progress-bg { flex: 1; height: 8rpx; background: rgba(255,255,255,.1); border-radius: 4rpx; overflow: hidden; }
.bte-progress-fill { height: 100%; background: linear-gradient(90deg, #8b5cf6, #eab308); border-radius: 4rpx; }
.bte-phase-pct { font-size: var(--font-xs); color: #94a3b8; }
.bte-reward { font-size: var(--font-xs); color: var(--success); }

.breakthrough-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.85);
  animation: fadeIn 0.3s ease;
}

.breakthrough-panel {
  position: relative;
  width: 600rpx;
  margin: 0 var(--space-2xl);
  padding: 48rpx var(--space-2xl) 36rpx;
  border-radius: var(--radius-xl);
  background: linear-gradient(160deg, #1a1020 0%, #0c0810 100%);
  border: 2rpx solid rgba(255, 215, 0, 0.4);
  text-align: center;
  animation: panelUp 0.4s ease;
}

.breakthrough-glow {
  position: absolute;
  inset: -4rpx;
  border-radius: var(--radius-xl);
  background: linear-gradient(135deg,
    rgba(255, 215, 0, 0.3) 0%,
    rgba(200, 100, 255, 0.3) 50%,
    rgba(255, 215, 0, 0.3) 100%);
  filter: blur(16rpx);
  z-index: -1;
  animation: pulseGlow 2s ease-in-out infinite;
}

.breakthrough-title {
  font-size: var(--font-3xl);
  font-weight: var(--weight-bold);
  color: #FFD700;
  letter-spacing: 6rpx;
  line-height: 1.5;
  animation: titlePulse 1.5s ease-in-out infinite;
}

.breakthrough-body {
  margin-top: var(--space-xl);
}

.breakthrough-realm {
  font-size: var(--font-lg);
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.5;
  letter-spacing: 2rpx;
}

.breakthrough-name {
  margin-top: var(--space-xs);
  font-size: 48rpx;
  font-weight: var(--weight-bold);
  color: #FFD700;
  line-height: 1.5;
  letter-spacing: 4rpx;
  text-shadow: 0 0 20rpx rgba(255, 215, 0, 0.5);
}

.breakthrough-poem {
  margin-top: var(--space-xl);
  padding: var(--space-xl) var(--space-xl);
  border-radius: var(--radius-md);
  background: rgba(255, 215, 0, 0.08);
  border: 1rpx solid rgba(255, 215, 0, 0.15);
  font-size: var(--font-xl);
  color: rgba(255, 255, 255, 0.85);
  line-height: 2;
  letter-spacing: 2rpx;
}

.breakthrough-desc {
  margin-top: var(--space-md);
  font-size: var(--font-md);
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.6;
}

.breakthrough-actions {
  display: flex;
  gap: var(--space-md);
  margin-top: var(--space-2xl);
}

.breakthrough-btn {
  flex: 1;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  line-height: 1.5;
}

.breakthrough-btn.primary {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #1a1020;
  box-shadow: 0 4rpx 20rpx rgba(255, 215, 0, 0.3);
}

.breakthrough-btn.ghost {
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.6);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

/* ═══════════════════════════════════════════
   系统面板 - 称号解锁弹窗
   ═══════════════════════════════════════════ */
.title-popup-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.85);
  animation: fadeIn 0.3s ease;
}

.title-popup-panel {
  text-align: center;
  animation: panelUp 0.4s ease;
}

.title-popup-seal {
  width: 280rpx;
  height: 280rpx;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 6rpx solid;
  border-radius: 50%;
  position: relative;
  animation: sealAppear 0.6s ease;
  transform: rotate(-8deg);
}

.seal-ring {
  position: absolute;
  inset: var(--space-md);
  border: 2rpx solid;
  border-radius: 50%;
  opacity: 0.4;
}

.seal-name {
  font-size: var(--font-3xl);
  font-weight: var(--weight-bold);
  line-height: 1.5;
  letter-spacing: 4rpx;
}

.seal-label {
  margin-top: 6rpx;
  font-size: var(--font-xs);
  letter-spacing: 6rpx;
  line-height: 1.5;
}

.title-popup-poem {
  margin-top: var(--space-xl);
  padding: var(--space-lg) var(--space-2xl);
  font-size: var(--font-xl);
  color: rgba(255, 255, 255, 0.8);
  line-height: 2;
  letter-spacing: 2rpx;
}

.title-popup-tip {
  margin-top: var(--space-md);
  font-size: var(--font-md);
  color: rgba(255, 255, 255, 0.4);
  line-height: 1.5;
}

/* ═══════════════════════════════════════════
   系统面板 - 动画关键帧
   ═══════════════════════════════════════════ */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes panelUp {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

@keyframes sealAppear {
  0% { transform: rotate(-8deg) scale(0); opacity: 0; }
  60% { transform: rotate(-8deg) scale(1.2); opacity: 1; }
  100% { transform: rotate(-8deg) scale(1); opacity: 1; }
}

@keyframes titlePulse {
  0%, 100% { text-shadow: 0 0 20rpx rgba(255, 215, 0, 0.4); }
  50% { text-shadow: 0 0 40rpx rgba(255, 215, 0, 0.8); }
}

@keyframes pulseGlow {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

/* ═══════════════════════════════════════════
   精英模板系统 - 首页卡片
   ═══════════════════════════════════════════ */
.sys-panel-wrapper {
  margin-top: var(--space-xl);
}

.elite-card {
  margin-top: var(--space-xl);
  overflow: hidden;
  position: relative;
}

.elite-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, var(--primary), transparent);
  opacity: 0.5;
}

.elite-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-lg);
}

.elite-kicker {
  font-size: var(--font-sm);
  color: var(--primary);
  letter-spacing: 2rpx;
  padding: 6rpx var(--space-md);
  border: 1rpx solid rgba(var(--primary-rgb), 0.3);
  border-radius: var(--radius-lg);
}

.elite-card-arrow {
  font-size: var(--font-xl);
  color: var(--text-secondary);
}

.elite-card-body {
  display: flex;
  align-items: flex-start;
  gap: var(--space-xl);
}

.elite-avatar-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.elite-avatar {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  border-radius: 50%;
  background: var(--surface-soft);
  border: 2rpx solid rgba(var(--primary-rgb), 0.3);
  position: relative;
  z-index: 1;
}

.elite-glow-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 2rpx solid rgba(var(--primary-rgb), 0.2);
  animation: eliteRingPulse 2s ease-in-out infinite;
}

@keyframes eliteRingPulse {
  0%, 100% { transform: scale(1); opacity: 0.3; }
  50% { transform: scale(1.2); opacity: 0.6; }
}

.elite-info {
  flex: 1;
  min-width: 0;
}

.elite-name {
  font-size: var(--font-2xl);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  line-height: 1.4;
}

.elite-intro {
  margin-top: 6rpx;
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}

.elite-progress-row {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  margin-top: 14rpx;
}

.elite-progress-bar-wrap {
  flex: 1;
  height: 10rpx;
  background: var(--surface-soft);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.elite-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--primary), var(--primary-soft));
  transition: width 0.5s ease;
  position: relative;
}

.elite-progress-fill::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
  animation: shimmer 2s ease-in-out infinite;
}

@keyframes shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

.elite-progress-num {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--primary);
  min-width: 56rpx;
  text-align: right;
}

.elite-phase-name {
  margin-top: var(--space-xs);
  font-size: var(--font-sm);
  color: var(--primary);
  line-height: 1.5;
  opacity: 0.8;
}

.elite-card-foot {
  display: flex;
  justify-content: space-around;
  margin-top: var(--space-xl);
  padding-top: var(--space-lg);
  border-top: 1rpx solid var(--border-color);
}

.elite-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.elite-stat-val {
  font-size: var(--font-2xl);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  line-height: 1.4;
}

.elite-stat-val.highlight {
  color: var(--primary);
}

.elite-stat-label {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.4;
}

/* 引导入口卡 */
.elite-entry-card {
  margin-top: var(--space-xl);
  cursor: pointer;
}

.elite-entry-inner {
  display: flex;
  align-items: center;
  gap: var(--space-lg);
}

.elite-entry-icon {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-4xl);
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, rgba(var(--primary-rgb), 0.15), rgba(var(--primary-rgb), 0.05));
  border: 1rpx solid rgba(var(--primary-rgb), 0.2);
}

.elite-entry-content {
  flex: 1;
  min-width: 0;
}

.elite-entry-title {
  font-size: var(--font-xl);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  line-height: 1.5;
}

.elite-entry-desc {
  margin-top: var(--space-xs);
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}

.elite-entry-arrow {
  font-size: var(--font-xl);
  color: var(--primary);
  flex-shrink: 0;
}

.onboard-container {
  min-height: 100vh;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  padding: 60rpx 40rpx;
}
.onboard-logo { font-size: 96rpx; margin-bottom: 24rpx; }
.onboard-title { font-size: 48rpx; font-weight: 700; color: #111827; }
.onboard-sub { font-size: 28rpx; color: #6b7280; margin-top: 12rpx; text-align: center; }
.onboard-primary {
  margin-top: 64rpx; width: 480rpx; height: 96rpx;
  background: #10B981; color: #fff; font-size: 34rpx; font-weight: 600;
  border-radius: 48rpx; display: flex; align-items: center; justify-content: center;
}
.onboard-dims-label { margin-top: 64rpx; font-size: 26rpx; color: #9ca3af; }
.onboard-dims { margin-top: 24rpx; white-space: nowrap; width: 100%; }
.onboard-dim {
  display: inline-block; margin-right: 24rpx; padding: 20rpx 36rpx;
  background: #fff; border-radius: 40rpx; font-size: 30rpx;
  color: #374151; border: 1rpx solid #e5e7eb;
}
.onboard-foot { margin-top: 64rpx; font-size: 24rpx; color: #d1d5db; text-align: center; }
