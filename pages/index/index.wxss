/* ═══════════════════════════════════════════
   系统面板 - 定场诗
   ═══════════════════════════════════════════ */
.poem-card {
  margin-top: 0;
  margin-bottom: 36rpx;
  position: relative;
  padding: 56rpx 48rpx;
  text-align: center;
  background: linear-gradient(135deg, rgba(255,255,255,0.96) 0%, rgba(250,251,251,0.92) 100%);
  border: 1rpx solid rgba(15, 169, 122, 0.22);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.95), 0 2rpx 4rpx rgba(0,0,0,0.04), 0 8rpx 12rpx rgba(15,169,122,0.06);
