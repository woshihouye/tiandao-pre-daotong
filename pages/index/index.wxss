}

.elite-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #1d1d1f;
  line-height: 1.3;
  letter-spacing: 0.6rpx;
}

.elite-intro {
  margin-top: 8rpx;
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}

.elite-progress-row {
  display: flex;
  align-items: center;
  gap: var(--space-md);
