/*
   系统面板 - 突破仪式弹窗
*/
/* v4.0: 突破预警条 */
.breakthrough-warn {
  position: relative;
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-lg) var(--space-xl);
  background: linear-gradient(135deg, rgba(184,136,46,0.18), rgba(201,164,92,0.10));
  border: 1rpx solid rgba(201,164,92,0.35);
  border-radius: 32rpx;
  overflow: hidden;
  margin-top: 24rpx;
  z-index: 1;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.60), 0 4rpx 12rpx rgba(201,164,92,0.14);
}
.bw-glow {
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(201,164,92,0.28), transparent);
  border-radius: 50%;
  animation: bwPulse 2s ease infinite;
}
@keyframes bwPulse {
  0%, 100% { transform: scale(1); opacity: 0.4; }
  50% { transform: scale(1.3); opacity: 0.8; }
}
.bw-icon { font-size: var(--font-3xl); z-index: 1; }
.bw-text { flex: 1; display: flex; flex-direction: column; z-index: 1; }
.bw-title { font-size: var(--font-xl); font-weight: 800; color: #b8882e; letter-spacing: 1rpx; }
.bw-sub { font-size: var(--font-sm); color: #8b7355; margin-top: 4rpx; }
.bw-arrow { font-size: var(--font-xl); color: #b8882e; z-index: 1; }

/* v4.0 补天计划入口 */
.butian-entry {
  padding: var(--space-xl);
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.10), rgba(15, 169, 122, 0.06));
  border: 1rpx solid rgba(15, 169, 122, 0.22);
  border-radius: 32rpx;
  margin-top: var(--space-md);
  position: relative;
  z-index: 1;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.70), 0 4rpx 12rpx rgba(139,92,246,0.08);
  margin-bottom: 36rpx;
}
.bte-header {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: var(--space-xs);
}
.bte-icon { font-size: var(--font-2xl); }
.bte-title { flex: 1; font-size: var(--font-xl); font-weight: 700; color: #0d8a66; }
.bte-arrow { font-size: var(--font-md); color: #8b5cf6; }
.bte-desc { font-size: var(--font-sm); color: #94a3b8; margin-bottom: var(--space-sm); }
.bte-phase { display: flex; align-items: center; gap: var(--space-sm); margin-bottom: var(--space-xs); }
.bte-phase-name { font-size: var(--font-sm); color: #8b5cf6; white-space: nowrap; font-weight: 600; }
.bte-progress-bg { flex: 1; height: 10rpx; background: rgba(15, 169, 122, 0.12); border-radius: 4rpx; overflow: hidden; }
.bte-progress-fill { height: 100%; background: linear-gradient(90deg, #8b5cf6, #0fa97a); border-radius: 4rpx; }
.bte-phase-pct { font-size: var(--font-xs); color: #94a3b8; }
.bte-reward { font-size: var(--font-xs); color: #c9a45c; font-weight: 700; text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.05), 0 0 12rpx rgba(201,164,92,0.20); }

.breakthrough-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.85);
  animation: fadeIn 0.3s ease;
}

.breakthrough-panel {
  position: relative;
  width: 600rpx;
  margin: 0 var(--space-2xl);
  padding: 48rpx var(--space-2xl) 36rpx;
  border-radius: var(--radius-xl);
  background: linear-gradient(160deg, #1a1020 0%, #0c0810 100%);
  border: 2rpx solid rgba(255, 215, 0, 0.4);
  text-align: center;
  animation: panelUp 0.4s ease;
}

.breakthrough-glow {
  position: absolute;
  inset: -4rpx;
  border-radius: var(--radius-xl);
  background: linear-gradient(135deg,
    rgba(255, 215, 0, 0.3) 0%,
    rgba(200, 100, 255, 0.3) 50%,
    rgba(255, 215, 0, 0.3) 100%);
  filter: blur(16rpx);
  z-index: -1;
  animation: pulseGlow 2s ease-in-out infinite;
}

.breakthrough-title {
  font-size: var(--font-3xl);
  font-weight: var(--weight-bold);
  color: #FFD700;
  letter-spacing: 6rpx;
  line-height: 1.5;
  animation: titlePulse 1.5s ease-in-out infinite;
}

.breakthrough-body {
  margin-top: var(--space-xl);
}

.breakthrough-realm {
  font-size: var(--font-lg);
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.5;
  letter-spacing: 2rpx;
}

.breakthrough-name {
  margin-top: var(--space-xs);
  font-size: 48rpx;
  font-weight: var(--weight-bold);
  color: #FFD700;
  line-height: 1.5;
  letter-spacing: 4rpx;
  text-shadow: 0 0 20rpx rgba(255, 215, 0, 0.5);
}

.breakthrough-poem {
  margin-top: var(--space-xl);
  padding: var(--space-xl) var(--space-xl);
  border-radius: var(--radius-md);
  background: rgba(255, 215, 0, 0.08);
  border: 1rpx solid rgba(255, 215, 0, 0.15);
  font-size: var(--font-xl);
  color: rgba(255, 255, 255, 0.85);
  line-height: 2;
  letter-spacing: 2rpx;
}

.breakthrough-desc {
  margin-top: var(--space-md);
  font-size: var(--font-md);
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.6;
}

.breakthrough-actions {
  display: flex;
  gap: var(--space-md);
  margin-top: var(--space-2xl);
}

.breakthrough-btn {
  flex: 1;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  line-height: 1.5;
}

.breakthrough-btn.primary {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #1a1020;
  box-shadow: 0 4rpx 20rpx rgba(255, 215, 0, 0.3);
}

.breakthrough-btn.ghost {
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.6);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

/* ═══════════════════════════════════════════
   系统面板 - 称号解锁弹窗
   ═══════════════════════════════════════════ */
.title-popup-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.85);
  animation: fadeIn 0.3s ease;
}

.title-popup-panel {
  text-align: center;
  animation: panelUp 0.4s ease;
}

.title-popup-seal {
  width: 280rpx;
  height: 280rpx;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 6rpx solid;
  border-radius: 50%;
  position: relative;
  animation: sealAppear 0.6s ease;
  transform: rotate(-8deg);
}

.seal-ring {
  position: absolute;
  inset: var(--space-md);
  border: 2rpx solid;
  border-radius: 50%;
  opacity: 0.4;
}

.seal-name {
  font-size: var(--font-3xl);
  font-weight: var(--weight-bold);
  line-height: 1.5;
  letter-spacing: 4rpx;
}

.seal-label {
  margin-top: 6rpx;
  font-size: var(--font-xs);
  letter-spacing: 6rpx;
  line-height: 1.5;
}

.title-popup-poem {
  margin-top: var(--space-xl);
  padding: var(--space-lg) var(--space-2xl);
  font-size: var(--font-xl);
  color: rgba(255, 255, 255, 0.8);
  line-height: 2;
  letter-spacing: 2rpx;
}

.title-popup-tip {
  margin-top: var(--space-md);
  font-size: var(--font-md);
  color: rgba(255, 255, 255, 0.4);
  line-height: 1.5;
}

/* ═══════════════════════════════════════════
   系统面板 - 动画关键帧
   ═══════════════════════════════════════════ */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes panelUp {
  from { transform: translateY(40rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

@keyframes sealAppear {
  0% { transform: rotate(-8deg) scale(0); opacity: 0; }
  60% { transform: rotate(-8deg) scale(1.2); opacity: 1; }
  100% { transform: rotate(-8deg) scale(1); opacity: 1; }
}

@keyframes titlePulse {
  0%, 100% { text-shadow: 0 0 20rpx rgba(255, 215, 0, 0.4); }
  50% { text-shadow: 0 0 40rpx rgba(255, 215, 0, 0.8); }
}

@keyframes pulseGlow {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

@keyframes shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

/* ═══════════════════════════════════════════
   【5. 精英模板系统 · 镀金天阙】
   ═══════════════════════════════════════════ */
.sys-panel-wrapper {
  margin-top: 0;
  margin-bottom: 36rpx;
  position: relative;
  z-index: 1;
}

.elite-card {
  margin-top: 0;
  margin-bottom: 36rpx;
  padding: 36rpx 32rpx;
  overflow: hidden;
  position: relative;
  background: linear-gradient(135deg, rgba(255,255,255,0.98) 0%, rgba(255,253,246,0.94) 100%);
  border: 1rpx solid rgba(201,164,92,0.22);
  border-radius: 36rpx;
  box-shadow: inset 0 0 0 1rpx rgba(255,255,255,0.75), inset 0 0 0 3rpx rgba(201,164,92,0.30), 0 4rpx 10rpx rgba(0,0,0,0.05), 0 12rpx 24rpx rgba(201,164,92,0.12);
  z-index: 1;
}

.elite-card::before {
  content: '';
