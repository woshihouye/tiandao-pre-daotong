  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.60);
}

.elite-entry-content {
  flex: 1;
  min-width: 0;
}

.elite-entry-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1d1d1f;
  line-height: 1.4;
  letter-spacing: 0.4rpx;
}

.elite-entry-desc {
  margin-top: var(--space-xs);
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}

.elite-entry-arrow {
  font-size: var(--font-xl);
  color: #b8882e;
  flex-shrink: 0;
}

/* ═══════════════════════════════════════════
   【6. 引导 + 扫尾】
   ═══════════════════════════════════════════ */
.onboard-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  position: relative;
  z-index: 1;
  background: linear-gradient(180deg, #f5f5f7 0%, #eef6f2 100%);
}

.onboard-container::before {
  content: '';
  position: absolute;
  top: 120rpx;
  right: 80rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.90);
  box-shadow: 0 0 56rpx rgba(18,201,144,0.18), 0 0 100rpx rgba(201,164,92,0.12);
  pointer-events: none;
}

.onboard-logo {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
  filter: drop-shadow(0 4rpx 16rpx rgba(15,169,122,0.18));
}
.onboard-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #1d1d1f;
  letter-spacing: 4rpx;
  position: relative;
  z-index: 1;
}
.onboard-sub {
  font-size: 28rpx;
  color: #5d5d62;
  margin-top: 16rpx;
  text-align: center;
  line-height: 1.7;
  max-width: 520rpx;
  position: relative;
  z-index: 1;
}
.onboard-primary {
  margin-top: 72rpx;
  width: 500rpx;
  height: 104rpx;
  background: linear-gradient(135deg, #12c990 0%, #0fa97a 45%, #0d8a66 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 4rpx;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.35), 0 4rpx 12rpx rgba(13,138,102,0.16), 0 12rpx 20rpx rgba(15,169,122,0.18);
  position: relative;
  z-index: 1;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}
.onboard-primary:active {
  transform: scale(0.96);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.30), 0 2rpx 8rpx rgba(13,138,102,0.12), 0 6rpx 14rpx rgba(15,169,122,0.14);
}

.onboard-dims-label {
  margin-top: 80rpx;
  font-size: 26rpx;
  color: #9ca3af;
  letter-spacing: 4rpx;
  position: relative;
  z-index: 1;
}
.onboard-dims {
  margin-top: 28rpx;
  white-space: nowrap;
  width: 100%;
  position: relative;
  z-index: 1;
}
.onboard-dim {
  display: inline-block;
  margin-right: 20rpx;
  padding: 22rpx 40rpx;
  background: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  color: #0d8a66;
  font-weight: 600;
  border: 1rpx solid rgba(15,169,122,0.22);
  background: linear-gradient(135deg, #e8f4ef, rgba(232,244,239,0.5));
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.95), 0 4rpx 12rpx rgba(15,169,122,0.08);
  transition: transform 0.18s ease;
}
.onboard-dim:active {
  transform: scale(0.96);
}

.onboard-foot {
  margin-top: 80rpx;
  font-size: 22rpx;
  color: #9ca3af;
  text-align: center;
  line-height: 1.8;
  letter-spacing: 1rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  max-width: 560rpx;
  position: relative;
  z-index: 1;
}

/* 通用卡片间距兜底 */
.card {
  margin-bottom: 0;
}

.card-premium {
  margin-bottom: 36rpx;
}

.today-summary-card { margin-bottom: 24rpx; }
.sum-section { padding: 16rpx 0; border-bottom: 1rpx solid var(--border-color, #f0f0f0); }
.sum-section:last-child { border-bottom: none; }
.sum-sec-title { font-size: 26rpx; color: var(--text-secondary, #86868b); margin-bottom: 12rpx; }
.sum-row { display: flex; flex-direction: column; gap: 10rpx; }
.sum-row-item { display: flex; align-items: center; gap: 12rpx; }
.sum-label { width: 72rpx; font-size: 24rpx; color: var(--text-secondary, #86868b); }
.sum-bar { flex: 1; height: 12rpx; background: #f0f0f0; border-radius: 8rpx; overflow: hidden; }
.sum-fill { height: 100%; border-radius: 8rpx; transition: width .4s ease; }
.sum-protein { background: #3b82f6; }
.sum-carbs { background: #f59e0b; }
.sum-fat { background: #ef4444; }
.sum-val { width: 80rpx; font-size: 24rpx; text-align: right; color: var(--text-primary, #1d1d1f); }
.sum-score { margin-top: 14rpx; font-size: 26rpx; color: var(--text-primary, #1d1d1f); }
.sum-score-num { font-size: 34rpx; font-weight: 600; color: #0fa97a; }
.sum-inline { display: block; font-size: 26rpx; color: var(--text-primary, #1d1d1f); padding: 4rpx 0; }
