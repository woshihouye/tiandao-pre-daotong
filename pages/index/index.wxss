/* 首页 · 英雄仙域 - 现代简约 + 青绿 + 克制仙气 */

page {
  background: #f5f5f7;
  position: relative;
}

page::after {
  content: '';
  position: absolute;
  left: -10%;
  right: -10%;
  bottom: -2rpx;
  height: 240rpx;
  z-index: 0;
  background: linear-gradient(180deg, rgba(9,104,74,0.04) 0%, rgba(9,104,74,0.10) 60%, rgba(9,104,74,0.16) 100%);
  border-radius: 50% 50% 0 0 / 72% 72% 0 0;
  pointer-events: none;
}

.container {
  position: relative;
  z-index: 1;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.vision-entry,
.realm-card,
.template-status,
.timeline-card {
  overflow: hidden;
}

.vision-entry {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--space-md);
  margin-top: var(--space-xl);
  position: relative;
  z-index: 1;
}

.vision-left {
  flex: 1;
  min-width: 0;
}

.vision-kicker,
.realm-kicker,
.panel-title {
  font-size: var(--font-md);
  color: var(--text-secondary);
  letter-spacing: 2rpx;
  line-height: 1.5;
}

.vision-title,
.card-title {
  margin-top: var(--space-sm);
  font-size: 40rpx;
  font-weight: 700;
  color: #1d1d1f;
  line-height: 1.4;
  letter-spacing: 0.6rpx;
}

.vision-desc,
.status-empty,
.template-sub,
.record-category,
.record-time,
.ring-label,
.mini-label {
  margin-top: var(--space-xs);
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}

.vision-icon,
.action-emblem,
.empty-icon {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-xl);
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
  color: #0fa97a;
  font-size: var(--font-2xl);
  font-weight: var(--weight-bold);
}

.action-emblem.danger {
  color: var(--danger-text);
}

.action-emblem.muted {
  background: var(--surface-muted);
  color: var(--text-muted);
  border-color: var(--border-color);
}

.action-card.disabled {
  opacity: 0.5;
}

.action-card.disabled .action-name {
  color: var(--text-muted);
}

.action-card.disabled .action-desc {
  color: var(--text-muted);
}

/* ═══════════════════════════════════════════
   【1. 修为面板 · 青穹宫阙】
   ═══════════════════════════════════════════ */
.realm-card {
  margin-top: 0;
  margin-bottom: 36rpx;
  position: relative;
  z-index: 2;
  min-height: 500rpx;
  padding: 56rpx 40rpx 48rpx;
  background: linear-gradient(160deg, #12c990 0%, #0fa97a 35%, #0d8a66 72%, #09684a 100%);
  border-radius: 0 0 48rpx 48rpx;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.35), 0 12rpx 24rpx rgba(9,104,74,0.18);
}

/* realm-card 修为面板 hero：所有主题下固定青绿背景，不被主题 .card 覆盖成浅色（修复半秒闪烁 + 白字看不清） */
.theme-hongchen .realm-card,
.theme-xianjie .realm-card,
.theme-diyu .realm-card,
.theme-xiuxing .realm-card {
  background: linear-gradient(160deg, #12c990 0%, #0fa97a 35%, #0d8a66 72%, #09684a 100%);
}

.realm-headline,
.template-panel-top,
.record-top,
.record-bottom,
.ability-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--space-md);
}

.realm-headline {
  margin-bottom: 40rpx;
  position: relative;
  z-index: 3;
}

.realm-title {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: var(--space-xs);
}

.realm-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1.4;
  padding: 12rpx 32rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
  letter-spacing: 2rpx;
}

.realm-stage {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.95);
  line-height: 1.5;
  padding-left: 16rpx;
  letter-spacing: 1rpx;
}

.realm-number,
.template-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.realm-value {
  font-size: 120rpx;
  font-weight: 800;
  color: #c9a45c;
  line-height: 1;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.20);
}

.ring-value,
.mini-value {
  font-size: var(--font-2xl);
  font-weight: var(--weight-bold);
  color: #c9a45c;
  line-height: 1.5;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.05), 0 0 12rpx rgba(201,164,92,0.20);
}

.realm-unit {
  font-size: 24rpx;
  color: rgba(255,255,255,0.72);
  line-height: 1.5;
  letter-spacing: 4rpx;
}

.realm-kicker {
  font-size: 22rpx;
  color: rgba(255,255,255,0.68);
  letter-spacing: 6rpx;
  margin-bottom: 8rpx;
  text-transform: uppercase;
}

.realm-progress-card,
.mini-stat,
.timeline-box,
.match-badge,
.status-chip,
.system-card {
  background: rgba(255,255,255,0.90);
  border: 1rpx solid rgba(255,255,255,0.60);
  border-radius: 32rpx;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.90), 0 2rpx 4rpx rgba(0,0,0,0.04), 0 8rpx 12rpx rgba(0,0,0,0.05);
}

.realm-progress-card {
  padding: 28rpx 32rpx;
  background: rgba(255,255,255,0.14);
  border: 1rpx solid rgba(255,255,255,0.22);
  backdrop-filter: blur(2rpx);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.25), 0 4rpx 16rpx rgba(0,0,0,0.10);
}

.realm-progress-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.78);
  line-height: 1.5;
}

.remaining {
  color: rgba(255, 255, 255, 0.95);
  font-weight: 700;
  letter-spacing: 1rpx;
}

.progress-bar.realm-progress-bar {
  height: 16rpx;
  background: rgba(255,255,255,0.18);
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-bar.realm-progress-bar .progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #e8d5a0 0%, #c9a45c 40%, #b8882e 100%);
  border-radius: 999rpx;
  box-shadow: 0 0 16rpx rgba(201,164,92,0.40);
  position: relative;
}

.progress-bar.realm-progress-bar .progress-fill::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.5), transparent);
  animation: shimmer 2.4s ease-in-out infinite;
}

.realm-foot {
  display: flex;
  gap: 16rpx;
  padding-top: 24rpx;
}

.mini-stat {
  flex: 1;
  padding: 20rpx 24rpx;
  background: rgba(255,255,255,0.92);
  border-radius: 28rpx;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.95), 0 2rpx 4rpx rgba(0,0,0,0.04), 0 8rpx 12rpx rgba(9,104,74,0.08);
}

.mini-label {
  font-size: 22rpx;
  color: #5d5d62;
  letter-spacing: 1rpx;
  margin-top: 0;
}

.mini-value {
  font-size: 34rpx;
  font-weight: 800;
  margin-top: 4rpx;
  display: block;
}

.align-right {
  align-items: flex-end;
}

.system-card {
  padding-top: var(--space-xl);
  padding-bottom: var(--space-xl);
}

.system-message {
  font-size: var(--font-lg);
  line-height: 1.5;
  color: var(--text-primary);
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0;
}

/* ═══════════════════════════════════════════
   【2. 快捷录入 · 仙篆符印】
   ═══════════════════════════════════════════ */
.quick-row {
  padding: 8rpx 24rpx 16rpx;
  position: relative;
  z-index: 1;
  margin-bottom: 32rpx;
}
.quick-scroll { width: 100%; white-space: nowrap; }
.quick-list {
  display: inline-flex;
  gap: 22rpx;
  padding-right: 24rpx;
}
.quick-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  min-width: 144rpx;
  padding: 8rpx 8rpx 10rpx;
}
.quick-emblem {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 40rpx 24rpx 40rpx 24rpx;
  background: #e8f4ef;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #0d8a66;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.85), 0 2rpx 4rpx rgba(0,0,0,0.03), 0 6rpx 12rpx rgba(13,138,102,0.10);
  transition: transform 0.18s ease, box-shadow 0.18s ease;
  overflow: hidden;
}

.quick-emblem::before {
  content: '';
  position: absolute;
  top: 18rpx;
  left: 20%;
  width: 60%;
  height: 20rpx;
  background: radial-gradient(ellipse at center, rgba(255,255,255,0.40) 0%, transparent 70%);
  pointer-events: none;
}

.quick-emblem:active {
  transform: scale(0.94);
  box-shadow: inset 0 0 0 2rpx rgba(255,255,255,0.55), 0 1rpx 2rpx rgba(0,0,0,0.04), 0 4rpx 8rpx rgba(13,138,102,0.08);
}

.qe-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #0d8a66;
  position: relative;
  z-index: 1;
}

.quick-emblem.qe-orange {
  background: #faf2e2;
  border-color: #c9a45c;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.85), 0 2rpx 4rpx rgba(0,0,0,0.03), 0 6rpx 12rpx rgba(201,164,92,0.10);
}
.quick-emblem.qe-orange .qe-text { color: #c9a45c; }

.quick-emblem.qe-red {
  background: #fce9e6;
  border-color: #c94a3a;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.85), 0 2rpx 4rpx rgba(0,0,0,0.03), 0 6rpx 12rpx rgba(201,74,58,0.10);
}
.quick-emblem.qe-red .qe-text { color: #c94a3a; }

.quick-emblem.qe-violet {
  background: #ece7fa;
  border-color: #7a5fc0;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.85), 0 2rpx 4rpx rgba(0,0,0,0.03), 0 6rpx 12rpx rgba(122,95,192,0.10);
}
.quick-emblem.qe-violet .qe-text { color: #7a5fc0; }

.quick-emblem.qe-ink {
  background: #f3f3f5;
  border-color: #5d5d62;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.85), 0 2rpx 4rpx rgba(0,0,0,0.03), 0 6rpx 12rpx rgba(93,93,98,0.08);
}
.quick-emblem.qe-ink .qe-text { color: #5d5d62; }

.quick-emblem.qe-cyan {
  background: #e4f5fa;
  border-color: #0891b2;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.85), 0 2rpx 4rpx rgba(0,0,0,0.03), 0 6rpx 12rpx rgba(8,145,178,0.10);
}
.quick-emblem.qe-cyan .qe-text { color: #0891b2; }

.quick-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #374151;
  white-space: nowrap;
  letter-spacing: 0.4rpx;
}

/* ═══════════════════════════════════════════
   胶囊行
   ═══════════════════════════════════════════ */
.capsules-section {
  padding: 8rpx 20rpx 4rpx;
  position: relative;
  z-index: 1;
  margin-bottom: 32rpx;
}
.capsules-scroll { width: 100%; white-space: nowrap; }
.capsules-list {
  display: inline-flex;
  gap: 18rpx;
  padding-right: 24rpx;
}
.capsule {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 26rpx;
  border-radius: 60rpx;
  background: rgba(255,255,255,0.92);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.95), 0 2rpx 4rpx rgba(0,0,0,0.04), 0 8rpx 12rpx rgba(0,0,0,0.05);
  border: 1rpx solid rgba(255,255,255,0.70);
  min-width: 280rpx;
  max-width: 520rpx;
}
.cap-icon { font-size: 32rpx; flex-shrink: 0; }
.cap-body {
  display: inline-flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
  flex: 1;
  max-width: 420rpx;
}
.cap-title {
  font-size: 26rpx; font-weight: 700; color: #1d1d1f;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  letter-spacing: 0.4rpx;
}
.cap-sub {
  font-size: 22rpx; color: #6b7280;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.cap-sub.poem-sub {
  white-space: normal;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.capsule.cap-bu     { background: rgba(255,255,255,0.92); border-color: rgba(13,138,102,0.15); }
.capsule.cap-elite  { background: rgba(255,255,255,0.92); border-color: rgba(201,164,92,0.18); }
.capsule.cap-elite.entry { background: rgba(255,255,255,0.92); border-color: rgba(201,164,92,0.18); }
.capsule.cap-fortune{ background: rgba(255,255,255,0.92); border-color: rgba(13,138,102,0.15); }
.capsule.cap-tpl    { background: rgba(255,255,255,0.92); border-color: rgba(13,138,102,0.15); }
.capsule.cap-poem   { background: rgba(255,255,255,0.92); border-color: rgba(201,164,92,0.18); }

.action-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 220rpx;
  margin: 0 0 var(--space-xl);
  padding: var(--space-xl) var(--space-lg);
  text-align: center;
}

.action-name {
  margin-top: var(--space-md);
  font-size: var(--font-xl);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  line-height: 1.5;
}

.action-desc {
  margin-top: var(--space-xs);
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}

.status-chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-top: var(--space-lg);
}

.status-chip {
  max-width: 100%;
  padding: var(--space-xs) var(--space-md);
  font-size: var(--font-md);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.5;
}

.status-chip.buff {
  color: var(--success);
}

.status-chip.debuff {
  color: var(--danger-text);
}

.template-panel-body {
  display: flex;
  align-items: center;
  gap: var(--space-xl);
}

.match-badge {
  padding: var(--space-xs) var(--space-md);
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: #0fa97a;
  background: #e8f4ef;
  border-color: rgba(15, 169, 122, 0.2);
  box-shadow: none;
}

.ring-shell {
  width: 208rpx;
  min-width: 208rpx;
  display: flex;
  justify-content: center;
}

.ring-progress {
  width: 192rpx;
  height: 192rpx;
  padding: var(--space-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}

.ring-inner {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffff;
  border: 1rpx solid rgba(15, 169, 122, 0.16);
}

.ability-panel {
  flex: 1;
  min-width: 0;
}

.ability-row + .ability-row {
  margin-top: var(--space-md);
}

.ability-head {
  margin-bottom: var(--space-xs);
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}

.ability-track {
  width: 100%;
  height: 12rpx;
  overflow: hidden;
  border-radius: var(--radius-full);
  background: var(--surface-soft);
}

.ability-fill,
.ability-fill.soft,
.ability-fill.faint,
.ability-fill.solid {
  height: 100%;
  border-radius: inherit;
  background: #0fa97a;
}

/* ═══════════════════════════════════════════
   【3. 时间轴 · 玉轴】
   ═══════════════════════════════════════════ */
.timeline-card {
  min-height: 320rpx;
  margin-bottom: 36rpx;
  padding: 32rpx 28rpx 36rpx;
  background: rgba(255,255,255,0.92);
  border-radius: 36rpx;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.95), 0 2rpx 4rpx rgba(0,0,0,0.04), 0 8rpx 12rpx rgba(0,0,0,0.05);
  border: 1rpx solid rgba(255,255,255,0.70);
}

.card-header {
  margin-bottom: 28rpx;
}

.timeline-scroll {
  max-height: 640rpx;
}

.timeline {
  position: relative;
  padding-left: 16rpx;
}

.timeline-item {
  position: relative;
  padding-left: 56rpx;
}

.timeline-item + .timeline-item {
  margin-top: 22rpx;
}

.timeline-line {
  position: absolute;
  left: 7rpx;
  top: 22rpx;
  bottom: -22rpx;
  width: 4rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #0d8a66 0%, #0fa97a 50%, #12c990 100%);
}

.timeline-item:last-child .timeline-line {
  display: none;
}

.timeline-dot {
  position: absolute;
  left: 0;
  top: 10rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #0d8a66;
  border: 2rpx solid #ffffff;
  box-shadow: 0 0 0 2rpx rgba(13,138,102,0.25);
}

.timeline-dot.negative {
  background: #c94a3a;
  box-shadow: 0 0 0 2rpx rgba(201,74,58,0.22);
}

.timeline-dot.positive {
  background: #0d8a66;
}

.timeline-box {
  padding: 22rpx 26rpx;
  background: rgba(255,255,255,0.90);
  border: 1rpx solid rgba(255,255,255,0.65);
  border-radius: 28rpx;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.90), 0 2rpx 4rpx rgba(0,0,0,0.03), 0 8rpx 12rpx rgba(0,0,0,0.04);
}

.record-top,
.record-bottom {
  align-items: center;
}

.record-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #1d1d1f;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.5;
}

.record-score {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.5;
  color: #c9a45c;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.05), 0 0 12rpx rgba(201,164,92,0.20);
}

.text-green-buff {
  color: #0d8a66 !important;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.04), 0 0 12rpx rgba(15,169,122,0.18) !important;
}

.text-red-debuff {
  color: #c94a3a !important;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.04), 0 0 12rpx rgba(201,74,58,0.16) !important;
}

.record-bottom {
  margin-top: 10rpx;
}

.record-category,
.record-time {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 0;
}

.empty-state {
  padding: 88rpx 0 64rpx;
  text-align: center;
}

.empty-icon {
  margin: 0 auto;
}

.empty-text {
  margin-top: var(--space-md);
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}

@keyframes pulseScore {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.06); }
}

.animate-score {
  animation: pulseScore 0.3s ease-out;
}

/* ═══════════════════════════════════════════
   【4. 每日任务 · 玉璧】
   ═══════════════════════════════════════════ */
.tasks-card {
  margin-top: 0;
  margin-bottom: 36rpx;
  padding: 32rpx 28rpx 36rpx;
  position: relative;
  z-index: 1;
  background: rgba(255,255,255,0.92);
  border-radius: 36rpx;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.95), 0 2rpx 4rpx rgba(0,0,0,0.04), 0 8rpx 12rpx rgba(0,0,0,0.05);
  border: 1rpx solid rgba(255,255,255,0.70);
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
}

.task-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
  border-radius: 36rpx;
  background: rgba(255,255,255,0.90);
  border: 1rpx solid rgba(255,255,255,0.80);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.95), 0 2rpx 4rpx rgba(0,0,0,0.03), 0 8rpx 12rpx rgba(0,0,0,0.04);
  transition: all 0.22s ease;
}

.task-item.task-done {
  background: linear-gradient(135deg, rgba(18,201,144,0.16) 0%, rgba(15,169,122,0.12) 100%);
  border: 2rpx solid rgba(13,138,102,0.32);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.70), 0 2rpx 4rpx rgba(13,138,102,0.04), 0 8rpx 12rpx rgba(13,138,102,0.08);
  opacity: 1;
}

.task-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.task-emoji {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(13,138,102,0.08), rgba(18,201,144,0.05));
  border: 1rpx solid rgba(13,138,102,0.18);
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
}

.task-body {
  flex: 1;
  min-width: 0;
}

.task-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d1d1f;
  line-height: 1.5;
}

.task-item.task-done .task-label {
  color: #0d8a66;
  font-weight: 700;
}

.task-reward {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #c9a45c;
  font-weight: 700;
  line-height: 1.5;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.05), 0 0 12rpx rgba(201,164,92,0.20);
}

.task-check {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 2rpx solid rgba(13,138,102,0.35);
  box-shadow: inset 0 0 0 1rpx rgba(255,255,255,0.95);
  font-size: 26rpx;
  font-weight: 800;
  color: transparent;
  transition: all 0.22s ease;
}

.task-check.checked {
  border: 2rpx solid #0d8a66;
  background: linear-gradient(135deg, #0fa97a 0%, #0d8a66 100%);
  color: #ffffff;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.35), 0 0 12rpx rgba(15,169,122,0.30);
}

/* ═══════════════════════════════════════════
   系统面板 - 运势
