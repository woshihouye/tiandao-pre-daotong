<!-- 人生模板系统首页 - 精英模板系统版 -->
<import src="/templates/theme-deco.wxml"/>
<view class="container theme-page {{themeClass}}" wx:if="{{!isNewUser}}">

  <template is="theme-deco" data="{{themeClass}}"/>

  <!-- 1. 修为面板 realm-card（最顶，保持原位置） -->
  <view class="realm-card card-premium card" bindtap="goToCultivationPage">
    <view class="realm-headline">
      <view class="realm-copy">
        <view class="realm-kicker">修为面板</view>
        <view class="realm-title">
          <text class="realm-name">{{currentRealm.name}}</text>
          <text class="realm-stage">第{{currentRealm.stage}}阶</text>
        </view>
      </view>
      <view class="realm-number">
        <text class="realm-value">{{totalCultivation}}</text>
        <text class="realm-unit">修为</text>
      </view>
    </view>

    <view class="realm-progress-card">
      <view class="realm-progress-top">
        <text class="progress-caption">距下一阶尚差</text>
        <text class="remaining">{{currentRealm.remaining}} 点</text>
      </view>
      <view class="progress-bar realm-progress-bar">
        <view class="progress-fill" style="width: {{realmProgress}}%;"></view>
      </view>
    </view>

    <view class="realm-foot">
      <view class="mini-stat">
        <text class="mini-label">今日预估</text>
        <text class="mini-value text-green-buff">+{{todayEstimation}}</text>
      </view>
      <view class="mini-stat align-right" wx:if="{{meritData && meritData.totalMerit > 0}}">
        <text class="mini-label">功德·{{meritData.levelInfo.name}}</text>
        <text class="mini-value" style="color:{{meritData.levelInfo.color}}">{{meritData.totalMerit}}</text>
      </view>
      <view class="mini-stat align-right" wx:else>
        <text class="mini-label">今日修为</text>
        <text class="mini-value {{animateScore ? 'animate-score' : ''}}">{{todayScore}}</text>
      </view>
    </view>
    <!-- v4.0: 突破预警提示 -->
    <view class="breakthrough-warn" wx:if="{{breakthroughWarning && breakthroughWarning.nearBreakthrough}}" bindtap="onBreakthroughWarningTap">
      <view class="bw-glow"></view>
      <text class="bw-icon">⚡</text>
      <view class="bw-text">
        <text class="bw-title">突破在即</text>
        <text class="bw-sub">修为已达瓶颈 {{ breakthroughWarning.warningPercent }}% · 点击准备突破</text>
      </view>
      <view class="bw-arrow">→</view>
    </view>
  </view>

  <!-- 2. 今日修为记录 timeline（上移到第 2 位） -->
  <view class="timeline-card card">
    <view class="card-header">
      <view class="card-title">今日修为记录</view>
    </view>

    <scroll-view scroll-y="true" class="timeline-scroll" wx:if="{{records.length > 0}}">
      <view class="timeline">
        <view class="timeline-item" wx:for="{{records}}" wx:key="_id">
          <view class="timeline-line"></view>
          <view class="timeline-dot {{item.score > 0 ? 'positive' : 'negative'}}"></view>
          <view class="timeline-box">
            <view class="record-top">
              <view class="record-name">{{item.name}}</view>
              <view class="record-score {{item.score > 0 ? 'text-green-buff' : 'text-red-debuff'}}">
                {{item.score > 0 ? '+' : ''}}{{item.score}}
              </view>
            </view>
            <view class="record-bottom">
              <text class="record-category">{{item.category}}</text>
              <text class="record-time">{{item.timeStr}}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="empty-state" wx:else>
      <view class="empty-icon">卷</view>
      <view class="empty-text text-secondary">暂无记录，今日尚未开卷修为</view>
    </view>
  </view>

  <!-- 3. 快捷录入横滑行（scroll-view scroll-x，6 入口）-->
  <view class="quick-row card">
    <scroll-view class="quick-scroll" scroll-x="true" show-scrollbar="false">
      <view class="quick-list">
        <view class="quick-item" bindtap="goToRecord" data-type="sport">
          <view class="quick-emblem"><text class="qe-text">武</text></view>
          <text class="quick-label">武·录入</text>
        </view>
        <view class="quick-item" bindtap="goToRecord" data-type="diet">
          <view class="quick-emblem qe-orange"><text class="qe-text">食</text></view>
          <text class="quick-label">食·丹食</text>
        </view>
        <view class="quick-item" bindtap="goToRecord" data-type="debuff">
          <view class="quick-emblem qe-red"><text class="qe-text">煞</text></view>
          <text class="quick-label">煞·心魔</text>
        </view>
        <view class="quick-item" bindtap="goToDaoChat">
          <view class="quick-emblem qe-violet"><text class="qe-text">童</text></view>
          <text class="quick-label">童·道童</text>
        </view>
        <view class="quick-item" bindtap="goToDaoEdit">
          <view class="quick-emblem qe-ink"><text class="qe-text">卷</text></view>
          <text class="quick-label">卷·道则</text>
        </view>
        <view class="quick-item" bindtap="goToVision">
          <view class="quick-emblem qe-cyan"><text class="qe-text">眼</text></view>
          <text class="quick-label">眼·灵鉴识物</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 4. 每日任务（保持） -->
  <view class="tasks-card card" wx:if="{{dailyTasks.length > 0}}">
    <view class="card-title">叮，今日道途指引</view>
    <view class="task-list">
      <view 
        class="task-item {{item.done ? 'task-done' : ''}}" 
        wx:for="{{dailyTasks}}" 
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onTapTask"
      >
        <view class="task-left">
          <view class="task-emoji">{{item.emoji}}</view>
          <view class="task-body">
            <view class="task-label">{{item.label}}</view>
            <view class="task-reward">{{item.rewardText}}</view>
          </view>
        </view>
        <view class="task-check {{item.done ? 'checked' : ''}}">
          {{item.done ? '✓' : ''}}
        </view>
      </view>
    </view>
  </view>

  <!-- 5. 系统提示（保持，原 L67-79） -->
  <!-- >>> 系统提示面板（使用 system-panel 组件） -->
  <view wx:if="{{eliteSystemMsg}}" class="sys-panel-wrapper">
    <system-panel
      level="{{eliteSystemMsg.level}}"
      title="{{eliteSystemMsg.title}}"
      message="{{eliteSystemMsg.message}}"
      showIcon="{{true}}"
    />
  </view>
  <view wx:else class="system-card card">
    <view class="panel-title">叮，系统提示</view>
    <view class="system-message">{{slogan}}</view>
  </view>

  <!-- 6. 功能入口胶囊行（scroll-view scroll-x，5 胶囊，按需渲染）-->
  <view class="capsules-section" wx:if="{{buTianSummary || eliteJourney || !eliteJourney || fortune || learningTemplate || titlePoem}}">
    <scroll-view class="capsules-scroll" scroll-x="true" show-scrollbar="false">
      <view class="capsules-list">
        <!-- 补天计划 -->
        <view class="capsule cap-bu" wx:if="{{buTianSummary}}" bindtap="onBuTianTap">
          <text class="cap-icon">🪨</text>
          <view class="cap-body">
            <text class="cap-title">{{buTianSummary.title}}</text>
            <text class="cap-sub">{{buTianSummary.phaseName}}阶段 {{buTianSummary.progressPercent}}%</text>
          </view>
        </view>
        <!-- 精英引路人（有→显示精英名+跳 Journey；无→「追随一位引路人」→跳 Market） -->
        <view class="capsule cap-elite" wx:if="{{eliteJourney && eliteTemplate}}" bindtap="goToEliteJourney">
          <text class="cap-icon">👤</text>
          <view class="cap-body">
            <text class="cap-title">精英引路人</text>
            <text class="cap-sub">{{eliteTemplate.eliteName}}</text>
          </view>
        </view>
        <view class="capsule cap-elite entry" wx:if="{{!eliteJourney}}" bindtap="goToEliteMarket">
          <text class="cap-icon">🌟</text>
          <view class="cap-body">
            <text class="cap-title">精英引路人</text>
            <text class="cap-sub">追随一位引路人</text>
          </view>
        </view>
        <!-- 今日运势 -->
        <view class="capsule cap-fortune" wx:if="{{fortune}}">
          <text class="cap-icon">🎴</text>
          <view class="cap-body">
            <text class="cap-title">今日运势</text>
            <text class="cap-sub">{{fortune.label}}</text>
          </view>
        </view>
        <!-- 模板修习 -->
        <view class="capsule cap-tpl" wx:if="{{learningTemplate}}">
          <text class="cap-icon">📘</text>
          <view class="cap-body">
            <text class="cap-title">模板修习</text>
            <text class="cap-sub">修习中：{{learningTemplate.name}}</text>
          </view>
        </view>
        <!-- 定场诗 -->
        <view class="capsule cap-poem" wx:if="{{titlePoem}}">
          <text class="cap-icon">🏮</text>
          <view class="cap-body">
            <text class="cap-title">定场诗</text>
            <text class="cap-sub poem-sub">{{titlePoem}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 【已删除】当前状态卡（L208-223 整块移除） -->

</view>

  <view class="onboard-container" wx:if="{{isNewUser}}">
    <view class="onboard-logo">🌱</view>
    <view class="onboard-title">天道修行</view>
    <view class="onboard-sub">记录每天的修行，累积修为，突破境界</view>

    <view class="onboard-primary" bindtap="startFirstRecord">记下第一笔</view>

    <view class="onboard-dims-label">想从哪一维开始？</view>
    <scroll-view class="onboard-dims" scroll-x="true">
      <view class="onboard-dim" bindtap="startFirstRecord" data-dim="sport">🏋️ 健身</view>
      <view class="onboard-dim" bindtap="startFirstRecord" data-dim="study">📚 学习</view>
      <view class="onboard-dim" bindtap="startFirstRecord" data-dim="diet">🥗 饮食</view>
      <view class="onboard-dim" bindtap="startFirstRecord" data-dim="work">✍️ 写作</view>
    </scroll-view>

    <view class="onboard-foot">拍照识物 · 道童对话 · 模板广场，记下第一笔后解锁完整首页</view>
  </view>

  <!-- 突破仪式弹窗 -->
  <view class="breakthrough-mask" wx:if="{{showBreakthrough && !isNewUser}}" catchtap="postponeBreakthrough">
    <view class="breakthrough-panel" catchtap="">
      <view class="breakthrough-glow"></view>
      <view class="breakthrough-title">⚡ 天道感应 ⚡</view>
      <view class="breakthrough-body">
        <view class="breakthrough-realm">即将突破至</view>
        <view class="breakthrough-name">{{breakthroughData.nextRealm}}</view>
        <view class="breakthrough-poem" wx:if="{{breakthroughData.poem}}">{{breakthroughData.poem}}</view>
        <view class="breakthrough-desc">{{breakthroughData.description || '修为已至临界，天地灵气涌动，正是突破之机！'}}</view>
      </view>
      <view class="breakthrough-actions">
        <view class="breakthrough-btn ghost" bindtap="postponeBreakthrough">暂缓 · 继续积累</view>
        <view class="breakthrough-btn primary" bindtap="confirmBreakthrough">引天劫 · 强行突破</view>
      </view>
    </view>
  </view>

  <!-- 称号解锁弹窗 -->
  <view class="title-popup-mask" wx:if="{{unlockedTitlePopup && !isNewUser}}" catchtap="closeTitlePopup">
    <view class="title-popup-panel" catchtap="">
      <view class="title-popup-seal" style="border-color:{{unlockedTitlePopup.color}}; color:{{unlockedTitlePopup.color}}">
        <view class="seal-ring"></view>
        <view class="seal-name">{{unlockedTitlePopup.name}}</view>
        <view class="seal-label">道 牒 解 锁</view>
      </view>
      <view class="title-popup-poem" wx:if="{{unlockedTitlePopup.poem}}">{{unlockedTitlePopup.poem}}</view>
      <view class="title-popup-tip" wx:if="{{unlockedTitlePopup.count > 1}}">共解锁 {{unlockedTitlePopup.count}} 个新称号</view>
    </view>
  </view>

<dao-spirit wx:if="{{!isNewUser}}" />
