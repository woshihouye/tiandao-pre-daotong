/* 运动修行记录页 UI */

.form-card {
  margin-top: 0;
}

.form-kicker {
  font-size: var(--font-md);
  letter-spacing: 4rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.5;
}

.form-title {
  margin: var(--space-sm) 0 var(--space-2xl);
  text-align: center;
  font-size: var(--font-2xl);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  line-height: 1.5;
}

.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-lg) 0;
  border-bottom: 1rpx solid var(--border-color);
}

.form-label {
  flex-shrink: 0;
  font-size: var(--font-lg);
  color: var(--text-primary);
  line-height: 1.5;
}

.form-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 var(--space-lg);
  text-align: right;
  font-size: var(--font-lg);
  color: var(--text-primary);
  border-radius: var(--radius-md);
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}

.picker-placeholder {
  color: var(--text-tertiary);
}

.picker-arrow {
  margin-left: var(--space-xs);
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

.picker {
  min-width: 220rpx;
  padding: var(--space-md) var(--space-lg);
  text-align: right;
  font-size: var(--font-lg);
  color: var(--text-primary);
  border-radius: var(--radius-md);
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}

/* 积分预览 */
.score-preview {
  margin: var(--space-lg) 0 10rpx;
  padding: var(--space-xl) var(--space-xl);
  text-align: center;
  border-radius: var(--radius-lg);
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}

.preview-label {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}

.preview-meta {
  margin-bottom: var(--space-xs);
  text-align: center;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.5;
}

.preview-score {
  margin-left: var(--space-sm);
  font-size: 48rpx;
  font-weight: var(--weight-bold);
}

.text-positive {
  color: var(--primary);
}

.submit-btn {
  width: 100%;
  margin-top: 22rpx;
  font-size: var(--font-2xl);
  background: var(--primary);
  color: #ffffff;
}

.submit-btn[disabled] {
  opacity: 0.45;
  pointer-events: none;
}

/* 配额提示 */
.quota-bar {
  margin-top: var(--space-lg);
  padding: var(--space-md) var(--space-lg);
  background: var(--surface-soft);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.quota-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.quota-label {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}

.quota-val {
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--primary);
  line-height: 1.5;
}

.quota-val.quota-0 {
  color: var(--danger-text);
}

.exhausted-bar {
  margin-top: var(--space-md);
  padding: var(--space-md) var(--space-lg);
  border-radius: var(--radius-sm);
  background: rgba(var(--danger-rgb), 0.08);
  border: 1rpx solid rgba(var(--danger-rgb), 0.2);
  font-size: var(--font-md);
  color: var(--danger-text);
  line-height: 1.6;
}

/* 自动印证提示 */
.sync-notice {
  display: flex;
  align-items: flex-start;
  gap: var(--space-sm);
  padding: var(--space-md) 22rpx;
  border-radius: var(--radius-sm);
  background: rgba(99, 102, 241, 0.06);
  border: 1rpx solid rgba(99, 102, 241, 0.15);
  margin-bottom: var(--space-sm);
}

.sync-notice-icon {
  font-size: var(--font-xl);
  flex-shrink: 0;
}

.sync-notice-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}

.sync-hl {
  font-weight: var(--weight-bold);
  color: #6366f1;
}

/* ========== 适配度分析卡片 ========== */
.fit-card {
  margin-top: var(--space-xl);
  padding: var(--space-xl);
  border-radius: var(--radius-md);
  border: 2rpx solid var(--primary);
  border-left-width: 6rpx;
  background: var(--surface-soft);
  animation: fitCardIn 0.35s ease;
}

@keyframes fitCardIn {
  from { opacity: 0; transform: translateY(12rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.fit-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: var(--space-sm);
}

.fit-icon {
  font-size: var(--font-2xl);
}

.fit-label {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  line-height: 1.5;
}

.fit-message {
  font-size: var(--font-md);
  color: var(--text-primary);
  line-height: 1.7;
}

.fit-warning {
  margin-top: 10rpx;
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-sm);
  background: rgba(var(--danger-rgb), 0.06);
  font-size: var(--font-md);
  color: var(--danger-text);
  line-height: 1.5;
}

/* ========== 运动选择搜索弹窗 ========== */

.movement-picker-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 300;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.movement-picker-panel {
  width: 100%;
  max-height: 75vh;
  background: var(--bg-primary, #fff);
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  animation: mpSlideUp 0.25s ease;
}

@keyframes mpSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.mp-search-box {
  display: flex;
  align-items: center;
  padding: var(--space-lg);
  border-bottom: 1rpx solid var(--border-color);
  position: sticky;
  top: 0;
  background: var(--bg-primary, #fff);
  z-index: 2;
}

.mp-search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 var(--space-md);
  font-size: var(--font-lg);
  background: var(--surface-soft);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-color);
}

.mp-search-clear {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: var(--space-sm);
  font-size: var(--font-lg);
  color: var(--text-tertiary);
}

.mp-list {
  flex: 1;
  overflow-y: auto;
  padding-bottom: var(--space-lg);
}

.mp-group-title {
  padding: var(--space-md) var(--space-xl) 6rpx;
  font-size: var(--font-md);
  font-weight: var(--weight-bold);
  color: var(--primary);
  background: var(--surface-soft);
}

.mp-group-desc {
  padding: 2rpx var(--space-xl) var(--space-sm);
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  background: var(--surface-soft);
}

.mp-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md) var(--space-xl);
  border-bottom: 1rpx solid var(--border-color);
}

.mp-item:active {
  background: var(--surface-soft);
}

.mp-item-active {
  background: rgba(var(--primary-rgb), 0.06);
}

.mp-item-name {
  font-size: var(--font-lg);
  color: var(--text-primary);
}

.mp-empty {
  padding: var(--space-xxl) var(--space-xl);
  text-align: center;
  font-size: var(--font-md);
  color: var(--text-tertiary);
}

.mp-close-btn {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-secondary);
  border-top: 1rpx solid var(--border-color);
  background: var(--bg-primary, #fff);
}

.mp-close-btn:active {
  background: var(--surface-soft);
}

/* ========== 预测数据卡片 ========== */

.predict-card {
  margin-top: var(--space-lg);
  padding: var(--space-lg);
  border-radius: var(--radius-md);
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}

.predict-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.predict-cell {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 14rpx var(--space-md);
  border-radius: var(--radius-sm);
  background: var(--card-bg);
}

.pcell-icon {
  font-size: var(--font-3xl);
  line-height: 1.4;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.pcell-body {
  flex: 1;
  min-width: 0;
}

.pcell-value {
  font-size: var(--font-2xl);
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.4;
}

.pcell-unit {
  font-size: var(--font-sm);
  font-weight: var(--weight-medium);
  color: var(--text-secondary);
}

.pcell-label {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.5;
  margin-top: 2rpx;
}

.pcell-sub {
  color: var(--text-muted);
  font-size: var(--font-xs);
  margin-left: 4rpx;
}

/* 超限告警标记（预测卡片底部） */
.predict-overlimit-tag {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  padding: 10rpx 14rpx;
  border-radius: 10rpx;
  background: rgba(var(--danger-rgb), 0.08);
  border: 1rpx solid rgba(var(--danger-rgb), 0.15);
}

.polt-icon {
  font-size: var(--font-md);
  line-height: 1;
}

.polt-text {
  font-size: var(--font-sm);
  color: var(--danger-text);
  font-weight: var(--weight-medium);
  line-height: 1.5;
}

/* ========== 超限确认弹窗 ========== */

.overlimit-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  animation: olMaskIn 0.2s ease;
}

@keyframes olMaskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.overlimit-panel {
  position: fixed;
  left: var(--space-xl);
  right: var(--space-xl);
  top: 50%;
  transform: translateY(-50%) scale(0.9);
  background: var(--card-bg);
  border-radius: var(--radius-xl);
  z-index: 1001;
  opacity: 0;
  overflow: hidden;
  pointer-events: none;
  transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s ease;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}

.overlimit-panel.ol-show {
  transform: translateY(-50%) scale(1);
  opacity: 1;
  pointer-events: auto;
}

.ol-header {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: var(--space-xl) var(--space-xl) var(--space-lg);
  border-bottom: 1rpx solid var(--border-color);
}

.ol-header-icon {
  font-size: var(--font-4xl);
  line-height: 1;
}

.ol-header-text {
  font-size: var(--font-2xl);
  font-weight: 800;
  color: var(--text-primary);
}

.ol-body {
  padding: var(--space-xl) var(--space-xl);
  max-height: 50vh;
  overflow-y: auto;
}

.ol-desc {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: var(--space-md);
}

.ol-warnings {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.ol-warn-item {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 14rpx var(--space-md);
  border-radius: var(--radius-sm);
  background: var(--surface-soft);
}

.ol-warn-item.ol-critical {
  background: rgba(var(--danger-rgb), 0.06);
  border: 1rpx solid rgba(var(--danger-rgb), 0.15);
}

.ol-warn-item.ol-warning {
  background: rgba(245, 158, 11, 0.06);
  border: 1rpx solid rgba(245, 158, 11, 0.15);
}

.ol-warn-item.ol-info {
  background: rgba(59, 130, 246, 0.06);
  border: 1rpx solid rgba(59, 130, 246, 0.15);
}

.ol-warn-sev {
  font-size: var(--font-md);
  line-height: 1.5;
  flex-shrink: 0;
}

.ol-warn-msg {
  font-size: var(--font-md);
  color: var(--text-primary);
  line-height: 1.6;
  flex: 1;
  min-width: 0;
}

.ol-footer {
  display: flex;
  gap: 14rpx;
  padding: var(--space-lg) var(--space-xl) var(--space-xl);
}

.ol-btn {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  text-align: center;
  border: none;
  padding: 0;
}

.ol-btn.ol-btn-cancel {
  background: var(--surface-soft);
  color: var(--text-secondary);
  border: 1rpx solid var(--border-color);
}

.ol-btn.ol-btn-confirm {
  background: var(--danger-text);
  color: #fff;
}

/* ========== v4.0 里程碑弹窗 ========== */

.milestone-popup { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; }
.ms-overlay { position: absolute; inset: 0; background: rgba(0,0,0,.6); }
.ms-card { position: relative; z-index: 1; background: linear-gradient(135deg,#1a1a2e,#1e293b); border-radius: var(--radius-xl); padding: 48rpx var(--space-2xl); text-align: center; border: 1rpx solid rgba(234,179,8,.3); display: flex; flex-direction: column; align-items: center; gap: var(--space-sm); width: 580rpx; box-shadow: 0 20rpx 60rpx rgba(0,0,0,.5); }
.ms-icon { font-size: 72rpx; }
.ms-title { font-size: var(--font-3xl); font-weight: var(--weight-bold); color: #eab308; }
.ms-sub { font-size: var(--font-lg); color: #94a3b8; }
.ms-prefix { font-size: var(--font-lg); color: #fff; }
.ms-prefix-val { color: #eab308; font-weight: var(--weight-semibold); }
.ms-pill { font-size: var(--font-md); color: var(--success); padding: var(--space-sm) var(--space-xl); background: rgba(var(--primary-rgb), 0.1); border-radius: var(--radius-md); }
.ms-btn { padding: var(--space-md) 80rpx; background: #eab308; color: #0f172a; border-radius: 48rpx; font-size: var(--font-xl); font-weight: var(--weight-bold); margin-top: var(--space-md); }
