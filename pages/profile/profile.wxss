/* 个人主页 — v2 六大模块重构 + 现代简约·仙气视觉统一 */

/* ═══════════════════════════════════════════ */
/*  根容器：顶部渐变 banner + 仙气山峦伪元素     */
/* ═══════════════════════════════════════════ */
.container {
  position: relative;
  z-index: 1;
}

.container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 520rpx;
  border-radius: 0 0 48rpx 48rpx;
  z-index: 0;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.30),
    0 16rpx 24rpx rgba(10, 122, 88, 0.16);
  background:
    radial-gradient(circle at 72rpx 72rpx, rgba(255,255,255,0.96) 0 50rpx, transparent 51rpx),
    radial-gradient(circle at 72rpx 72rpx, rgba(255,255,255,0.55) 0 72rpx, transparent 73rpx),
    radial-gradient(circle at 72rpx 72rpx, rgba(18,201,144,0.14) 0 90rpx, transparent 91rpx),
    radial-gradient(circle at 204rpx 96rpx, rgba(232,213,160,0.88) 0 20rpx, transparent 21rpx),
    radial-gradient(circle at 204rpx 96rpx, rgba(201,164,92,0.32) 0 30rpx, transparent 31rpx),
    radial-gradient(ellipse 55% 50% at 50% calc(100% - 120rpx), rgba(255,255,255,0.42) 0%, rgba(255,255,255,0.10) 55%, transparent 100%),
    radial-gradient(ellipse 65% 50% at 50% calc(100% - 90rpx), rgba(255,255,255,0.50) 0%, rgba(255,255,255,0.14) 55%, transparent 100%),
    radial-gradient(ellipse 75% 50% at 50% calc(100% - 60rpx), rgba(255,255,255,0.58) 0%, rgba(255,255,255,0.18) 55%, transparent 100%),
    linear-gradient(160deg, #0a7a58 0%, #0fa97a 38%, #12c990 72%, #cdeee0 100%);
}

.container::after {
  content: '';
  position: absolute;
  left: -10%;
  right: -10%;
  bottom: -2rpx;
  height: 180rpx;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 50% 50% 0 0 / 82% 82% 0 0;
  z-index: 0;
  pointer-events: none;
}

.section-more {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}

.section-link {
  margin-left: 24rpx;
}

/* ═══════════════════════════════════════════ */
/*  模块1: 形象头区                                 */
/* ═══════════════════════════════════════════ */
.hero-card {
  position: relative;
  z-index: 1;
  margin: 400rpx 24rpx 28rpx;
  padding: 36rpx;
  padding-top: 0;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.80),
    0 8rpx 20rpx rgba(10, 122, 88, 0.08);
  overflow: visible;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  gap: 28rpx;
}

.hero-avatar {
  width: 184rpx;
  height: 184rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(145deg, #e8f4ef 0%, #d4ebe0 100%);
  font-size: 72rpx;
  font-weight: 800;
  color: #0fa97a;
  flex-shrink: 0;
  position: relative;
  z-index: 3;
  margin-top: -120rpx;
  margin-bottom: 0;
  box-shadow:
    inset 0 0 0 4rpx #ffffff,
    inset 0 0 0 8rpx rgba(201, 164, 92, 0.85),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.60),
    0 6rpx 14rpx rgba(0, 0, 0, 0.10),
    0 12rpx 24rpx rgba(201, 164, 92, 0.22);
}

.hero-meta {
  flex: 1;
  min-width: 0;
  padding-top: 24rpx;
}

.hero-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #1d1d1f;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}
.hero-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.hero-alias-chip {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  color: #92400e;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 30rpx;
  border: 1rpx solid #fcd34d;
  box-shadow: 0 2rpx 6rpx rgba(252, 211, 77, 0.25);
}

.hero-realm {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6e6e73;
  line-height: 1.5;
}

.hero-edit-icon {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #0d8a66;
  border-radius: 50%;
  background: linear-gradient(145deg, rgba(18, 201, 144, 0.10) 0%, rgba(15, 169, 122, 0.06) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.80);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.90),
    0 4rpx 10rpx rgba(15, 169, 122, 0.10);
  margin-top: 24rpx;
}

.hero-chips {
  display: flex;
  gap: 14rpx;
  margin-top: 28rpx;
  flex-wrap: wrap;
  padding-left: 212rpx;
}

.hero-chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #0d8a66;
  background: linear-gradient(145deg, rgba(18, 201, 144, 0.12) 0%, rgba(15, 169, 122, 0.08) 100%);
  border: 1rpx solid rgba(15, 169, 122, 0.20);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.70);
  line-height: 1.5;
}

.hero-chip:active {
  transform: scale(0.96);
  background: linear-gradient(135deg, rgba(18, 201, 144, 0.18), rgba(15, 169, 122, 0.12));
}

/* ═══════════════════════════════════════════ */
/*  模块2: 定场诗专区                              */
/* ═══════════════════════════════════════════ */
.poem-zone {
  position: relative;
  z-index: 1;
  min-height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 68rpx;
  margin: 0 24rpx 28rpx;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.80),
    0 8rpx 20rpx rgba(10, 122, 88, 0.08);
}

.poem-zone:active {
  background: linear-gradient(135deg, rgba(18, 201, 144, 0.12), rgba(15, 169, 122, 0.08));
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.60),
    0 0 0 2rpx rgba(13, 138, 102, 0.30),
    0 8rpx 20rpx rgba(10, 122, 88, 0.08);
  padding: 38rpx 66rpx;
}

.poem-deco-left,
.poem-deco-right {
  position: absolute;
  font-size: 56rpx;
  color: rgba(15, 169, 122, 0.18);
  font-weight: 800;
  line-height: 1;
}

.poem-deco-left {
  top: 20rpx;
  left: 40rpx;
}

.poem-deco-right {
  bottom: 20rpx;
  right: 40rpx;
}

.poem-body {
  font-size: 32rpx;
  font-weight: 500;
  color: #1d1d1f;
  line-height: 2;
  letter-spacing: 2rpx;
  text-align: center;
}

.poem-placeholder {
  color: #8e8e93;
  font-weight: 400;
  opacity: 0.7;
}

.poem-edit-hint {
  position: absolute;
  top: 20rpx;
  right: 32rpx;
  font-size: 22rpx;
  color: #0d8a66;
  opacity: 0.6;
}

.stats-card {
  position: relative;
  z-index: 1;
  margin: 0 24rpx 28rpx;
  padding: 36rpx;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.80),
    0 8rpx 20rpx rgba(10, 122, 88, 0.08);
}

.stats-card:active {
  transform: scale(0.995);
}

.stats-cultivation {
  margin-bottom: 32rpx;
}

.stats-cv-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.stats-cv-label {
  font-size: 26rpx;
  color: #6e6e73;
  font-weight: 500;
}

.stats-cv-value {
  font-size: 44rpx;
  font-weight: 800;
  color: #c9a45c;
  letter-spacing: 1rpx;
  line-height: 1;
  text-shadow:
    0 1rpx 2rpx rgba(0, 0, 0, 0.06),
    0 0 10rpx rgba(201, 164, 92, 0.22);
}

.stats-progress {
  margin-top: 18rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(15, 169, 122, 0.08);
  overflow: hidden;
}

.stats-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #0a7a58 0%, #0fa97a 50%, #12c990 100%);
  border-radius: 6rpx;
  transition: width 0.5s ease;
  box-shadow: 0 0 8rpx rgba(18, 201, 144, 0.35);
}

.stats-cv-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8e8e93;
  line-height: 1.5;
}

.stats-quad {
  display: flex;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.stats-quad-item {
  flex: 1;
  text-align: center;
  padding: 22rpx 10rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, rgba(18, 201, 144, 0.06) 0%, rgba(255, 255, 255, 0.90) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.90);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 1.0),
    0 2rpx 8rpx rgba(15, 169, 122, 0.05);
}

.stats-quad-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #c9a45c;
  letter-spacing: 1rpx;
  line-height: 1.3;
  text-shadow:
    0 1rpx 2rpx rgba(0, 0, 0, 0.06),
    0 0 10rpx rgba(201, 164, 92, 0.22);
}

.stats-quad-label {
  font-size: 22rpx;
  color: #6e6e73;
  line-height: 1.4;
  margin-top: 4rpx;
}

.stats-realm-detail {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #8e8e93;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

/* ═══════════════════════════════════════════ */
/*  模块4: 道牒成就墙                              */
/* ═══════════════════════════════════════════ */
.title-wall {
  position: relative;
  z-index: 1;
  margin: 0 24rpx 28rpx;
  padding: 36rpx;
  padding-bottom: 36rpx;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.80),
    0 8rpx 20rpx rgba(10, 122, 88, 0.08);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1d1d1f;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #0a7a58 0%, #12c990 100%);
  box-shadow: 0 0 8rpx rgba(18, 201, 144, 0.30);
}

.title-current {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
  padding: 18rpx 22rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.80) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.90);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.title-current-badge {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  border-width: 2rpx;
  border-style: solid;
  font-size: 28rpx;
  font-weight: 800;
  background: rgba(255, 255, 255, 0.60);
}

.title-current-bonus {
  font-size: 24rpx;
  font-weight: 600;
}

.title-poem-mini {
  margin-bottom: 24rpx;
  font-size: 26rpx;
  color: #6e6e73;
  line-height: 1.8;
  letter-spacing: 1rpx;
  padding-left: 8rpx;
}

.title-scroll {
  width: 100%;
  white-space: nowrap;
}

.title-scroll-row {
  display: inline-flex;
  gap: 14rpx;
  padding: 4rpx 0;
}

.title-chip {
  display: inline-flex;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border-width: 1rpx;
  border-style: solid;
  font-size: 24rpx;
  font-weight: 600;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.80) 100%);
  white-space: nowrap;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 1.0);
}

.title-chip.active {
  border-width: 2rpx;
  background: linear-gradient(135deg, rgba(18, 201, 144, 0.12), rgba(15, 169, 122, 0.08));
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.60),
    0 0 0 2rpx rgba(13, 138, 102, 0.30);
}

.title-empty {
  text-align: center;
  font-size: 26rpx;
  color: #8e8e93;
  padding: 32rpx 0;
  border-radius: 24rpx;
  background: rgba(15, 169, 122, 0.04);
}

.trail-card {
  position: relative;
  z-index: 1;
  margin: 0 24rpx 28rpx;
  padding: 36rpx;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.80),
    0 8rpx 20rpx rgba(10, 122, 88, 0.08);
}

.dim-rings {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-bottom: 32rpx;
}

.dim-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 14rpx 18rpx;
  border-radius: 22rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 255, 255, 0.85) 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 1.0);
}

.dim-bar-wrap {
  position: relative;
  height: 12rpx;
  border-radius: 6rpx;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.04);
}

.dim-bar-bg {
  position: absolute;
  inset: 0;
  border-radius: 6rpx;
}

.dim-bar-fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  border-radius: 6rpx;
  transition: width 0.5s ease;
  box-shadow: 0 0 6rpx currentColor;
  opacity: 0.9;
}

.dim-label-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
}

.dim-icon {
  width: 44rpx;
  height: 44rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  text-align: center;
  background: linear-gradient(145deg, #12c990 0%, #0a7a58 100%);
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.90);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.35),
    0 2rpx 8rpx rgba(10, 122, 88, 0.25);
  font-size: 22rpx;
}

.dim-name {
  flex: 1;
  color: #6e6e73;
  font-weight: 500;
}

.dim-pct {
  font-weight: 800;
  color: #1d1d1f;
  font-size: 26rpx;
}

.week-chart {
  margin-bottom: 32rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, rgba(18, 201, 144, 0.04) 0%, rgba(255, 255, 255, 0.95) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.90);
}

.chart-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1d1d1f;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

.chart-row {
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  height: 220rpx;
  padding: 0 8rpx;
}

.bar-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  width: 68rpx;
}

.bar-emoji {
  font-size: 26rpx;
}

.bar-val {
  font-size: 20rpx;
  font-weight: 700;
  color: #6e6e73;
}

.bar-track {
  width: 40rpx;
  height: 130rpx;
  border-radius: 10rpx;
  background: rgba(15, 169, 122, 0.06);
  position: relative;
  overflow: hidden;
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
}

.bar-inner {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  border-radius: 10rpx;
  min-height: 6rpx;
  transition: height 0.5s ease;
  box-shadow: 0 0 8rpx rgba(0, 0, 0, 0.08);
}

.bar-date {
  font-size: 20rpx;
  color: #8e8e93;
  margin-top: 4rpx;
  font-weight: 500;
}

.cat-row {
  display: flex;
  justify-content: space-around;
  margin-bottom: 28rpx;
  padding: 18rpx 10rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 255, 255, 0.85) 100%);
}

.cat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.cat-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #c9a45c;
  letter-spacing: 1rpx;
  line-height: 1.2;
  text-shadow:
    0 1rpx 2rpx rgba(0, 0, 0, 0.06),
    0 0 10rpx rgba(201, 164, 92, 0.22);
}

.cat-name {
  font-size: 22rpx;
  opacity: 0.75;
  font-weight: 500;
}

.spirit-mini {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  padding: 24rpx 0 8rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  cursor: pointer;
}

.spirit-mini:active {
  background: linear-gradient(135deg, rgba(18, 201, 144, 0.10), rgba(15, 169, 122, 0.06));
  border-radius: 20rpx;
}

.spirit-mini-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.spirit-mini-label {
  width: 44rpx;
  height: 44rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 800;
  background: linear-gradient(145deg, #12c990 0%, #0a7a58 100%);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.35),
    0 2rpx 8rpx rgba(10, 122, 88, 0.25),
    0 0 0 1rpx rgba(255, 255, 255, 0.90);
}

.spirit-mini-val {
  font-size: 44rpx;
  font-weight: 800;
  color: #c9a45c;
  letter-spacing: 1rpx;
  text-shadow:
    0 1rpx 2rpx rgba(0, 0, 0, 0.06),
    0 0 10rpx rgba(201, 164, 92, 0.22);
}

.spirit-mini-divider {
  color: rgba(0, 0, 0, 0.08);
  font-size: 32rpx;
  font-weight: 300;
}

/* ═══════════════════════════════════════════ */
/*  模块7: 师徒                                        */
/* ═══════════════════════════════════════════ */
.mentor-card {
  position: relative;
  z-index: 1;
  margin: 0 24rpx 28rpx;
  padding: 36rpx;
  background: linear-gradient(145deg, rgba(139, 92, 246, 0.06) 0%, rgba(255, 255, 255, 0.94) 100%);
  border: 1rpx solid rgba(139, 92, 246, 0.15);
  border-radius: 44rpx;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.80),
    0 8rpx 20rpx rgba(10, 122, 88, 0.08);
}
.mentor-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.mentor-section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1d1d1f;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.mentor-btn {
  padding: 14rpx 28rpx;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #0a7a58 0%, #0fa97a 50%, #12c990 100%);
  color: #ffffff;
  border: none;
  line-height: 1.4;
  box-shadow:
    0 4rpx 12rpx rgba(10, 122, 88, 0.25),
    0 0 20rpx rgba(18, 201, 144, 0.18);
  transition: transform 0.15s ease;
}
.mentor-btn:active {
  transform: scale(0.96);
}
.mentor-btn.mini {
  padding: 10rpx 22rpx;
  font-size: 22rpx;
}
.mentor-btn.danger {
  background: linear-gradient(135deg, #ef4444 0%, #f97316 100%);
  box-shadow: 0 4rpx 12rpx rgba(239, 68, 68, 0.25);
}
.mentor-btn.ghost {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.80) 100%);
  color: #1d1d1f;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 1.0);
}

.mentor-info-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx;
