<!-- 人生模板库 -->
<import src="/templates/theme-deco.wxml"/>
<view class="container theme-page {{themeClass}}">
  <template is="theme-deco" data="{{themeClass}}"/>
  <view class="library-hero card-premium card" bindtap="goToActivityLibrary">
    <view class="hero-kicker">大道之行</view>
    <view class="hero-title">修行库</view>
    <view class="hero-desc">汇总所有日常修行行为，正向行为增加修为，负面行为扣除修为，点击进入可查看和管理全部修行条目。</view>
  </view>

  <!-- 模板标签切换 -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'mytmpl' ? 'active' : ''}}" data-tab="mytmpl" bindtap="switchTab">我的模板</view>
    <view class="tab-item {{activeTab === 'plaza' ? 'active' : ''}}" data-tab="plaza" bindtap="switchTab">模板广场</view>
    <view class="tab-item {{activeTab === 'wish' ? 'active' : ''}}" data-tab="wish" bindtap="switchTab">求模板</view>
  </view>

  <!-- ===== 我的模板 ===== -->
  <view wx:if="{{activeTab === 'mytmpl'}}">
  <!-- 自建模板区域 -->
  <view class="custom-tmpl-section" wx:if="{{hasCustomTemplates}}">
    <view class="ct-filter-tabs">
      <view class="ct-filter-tab {{customFilterType === 'all' ? 'active' : ''}}" data-type="all" bindtap="filterCustomType">全部</view>
      <view class="ct-filter-tab {{customFilterType === 'daily' ? 'active' : ''}}" data-type="daily" bindtap="filterCustomType">日模板</view>
      <view class="ct-filter-tab {{customFilterType === 'weekly' ? 'active' : ''}}" data-type="weekly" bindtap="filterCustomType">周模板</view>
      <view class="ct-filter-tab {{customFilterType === 'hedao' ? 'active' : ''}}" data-type="hedao" bindtap="filterCustomType">合道模板</view>
    </view>
    <view class="ct-list">
      <view
        wx:for="{{customTemplatesFiltered}}" wx:key="id"
        class="ct-card card"
        data-id="{{item.id}}"
        bindtap="enableTemplate"
        bindlongpress="showTemplateActions"
      >
        <view class="ct-card-left">
          <view class="ct-card-name">{{item.name}}</view>
          <view class="ct-card-meta">
            <text class="ct-type-tag">{{item.type === 'daily' ? '日模板' : (item.type === 'weekly' ? '周模板' : '合道模板')}}</text>
            <text class="ct-hedao-tag" wx:if="{{item.type === 'hedao'}}">☯ 合道</text>
            <text class="ct-count">· {{item.type === 'daily' ? (item.timeSlots ? item.timeSlots.length : 0) + '时段' : (item.type === 'weekly' ? '7天' : (item.type === 'hedao' ? (item.timeSlots ? '全天' : '周期') : ''))}}</text>
          </view>
        </view>
        <view class="ct-card-right">
          <text class="ct-more-btn" data-id="{{item.id}}" catchtap="showTemplateActions">⋯</text>
        </view>
      </view>
      <view wx:if="{{customTemplatesFiltered.length === 0}}" class="empty-tip">暂无此类模板</view>
    </view>
  </view>

  <!-- D2 / P2-11：我的模板空状态 -->
  <view class="mytmpl-empty card" wx:else bindtap="switchTab" data-tab="plaza">
    <text class="mte-icon">📭</text>
    <text class="mte-text">还没有模板，去广场逛逛 →</text>
  </view>

  </view>

  <!-- 云端模板广场 -->
  <view class="plaza-section" wx:if="{{activeTab === 'plaza'}}">
    <!-- 排序筛选（template-config.js） -->
    <view class="plaza-filters">
      <view class="filter-group">
        <view class="filter-item {{cloudSortKey === item.key ? 'active' : ''}}" wx:for="{{sortTabs}}" wx:key="key" data-key="{{item.key}}" bindtap="changeSort">{{item.label}}</view>
      </view>
    </view>

    <!-- 分类筛选栏（6 大道则） -->
    <view class="plaza-cat-bar">
      <view class="cat-item {{cloudCategory === '' ? 'active' : ''}}" data-category="" bindtap="changeCategory">全部</view>
      <view class="cat-item {{cloudCategory === item.key ? 'active' : ''}}" wx:for="{{categoryTabs}}" wx:key="key" data-category="{{item.key}}" bindtap="changeCategory">{{item.label}}</view>
    </view>

    <!-- 搜索框 -->
    <view class="plaza-search">
      <input class="search-input" placeholder="搜索道则名称或描述..." bindinput="onSearchInput" bindconfirm="onSearchConfirm" confirm-type="search"/>
    </view>

    <!-- 模板列表：结缘滑动卡片 -->
    <view class="plaza-list">
      <view class="swipe-deck" wx:if="{{cloudTemplates.length > 0}}">
        <view
          wx:for="{{deckCards}}"
          wx:key="id"
          class="swipe-card {{index === 0 ? 'top' : ''}}"
          style="z-index: {{deckCards.length - index}}; transform: {{item.offset}};"
          data-index="{{index}}"
          data-id="{{item.id}}"
          bindtouchstart="onCardTouchStart"
          bindtouchmove="onCardTouchMove"
          bindtouchend="onCardTouchEnd"
        >
          <view class="sc-bg" style="background: {{item.bgStyle}};"></view>
          <view class="sc-shade"></view>
          <view class="sc-top">
            <text class="sc-chip">{{item.categoryLabel}}</text>
            <text class="sc-src">背景：{{item.creatorName}}主页</text>
          </view>
          <view class="sc-info">
            <view class="sc-title">{{item.name}}</view>
            <view class="sc-sub">{{item.subtitle || item.description}}</view>
            <view class="sc-score"><text class="sc-num">{{item.score}}</text><text class="sc-unit">修为/日</text></view>
            <view class="sc-outs">
              <text class="sc-out" wx:for="{{item.outputs}}" wx:for-item="out" wx:key="label">{{out.emoji}} {{out.label}} {{out.val}}</text>
            </view>
            <view class="sc-more">
              <text class="sc-by">道法由 <text class="b">{{item.creatorName}}</text> 分享</text>
              <text class="sc-detail" catchtap="openCloudTemplate" data-id="{{item.id}}">查看完整时段 ›</text>
            </view>
          </view>
          <view class="sc-stamp like" style="opacity: {{item._likeOpacity || 0}};">结缘</view>
          <view class="sc-stamp nope" style="opacity: {{item._nopeOpacity || 0}};">无缘</view>
        </view>
      </view>
      <view wx:else class="plaza-empty">今日道法已览尽，明日再来或有新的仙缘</view>
    </view>

    <!-- 加载更多 -->
    <view class="plaza-loadmore" wx:if="{{cloudHasMore}}" bindtap="loadMoreCloud">
      <text>加载更多...</text>
    </view>
    <view class="plaza-empty" wx:if="{{cloudTemplates.length === 0 && !cloudLoading}}">
      <text>暂无模板，去自定义一个吧！</text>
    </view>
    <view class="plaza-total" wx:if="{{cloudTotal > 0}}">
      <text>共 {{cloudTotal}} 条道则</text>
    </view>
  </view>

  <!-- 底部操作按钮（结缘滑动卡片） -->
  <view class="swipe-actions" wx:if="{{activeTab === 'plaza' && cloudTemplates.length > 0}}">
    <view class="sa-btn undo" bindtap="onSwipeUndo">↺</view>
    <view class="sa-btn nope" bindtap="onSwipeNope">✕</view>
    <view class="sa-btn like" bindtap="onSwipeLike">♥</view>
    <view class="sa-btn super" bindtap="onSwipeSuper">★</view>
  </view>

  <!-- ===== 许愿池 ===== -->
  <view wx:if="{{activeTab === 'wish'}}">

    <!-- 顶部发布框 -->
    <view class="wish-publish-wrap card">
      <textarea
        class="wish-publish-input"
        placeholder="说一句你想要的模板吧（1-100字）"
        value="{{wishContent}}"
        bindinput="onWishInput"
        maxlength="100"
        auto-height
      />
      <view class="wish-publish-footer">
        <text class="wish-publish-count">{{wishContent.length}}/100</text>
        <view class="wish-publish-btn" bindtap="onPublishWish">许愿</view>
      </view>
    </view>

    <!-- 许愿排序 tab -->
    <view class="wish-sort-row">
      <text class="wish-sort-btn {{wishSortBy === 'hot' ? 'active' : ''}}" data-sort="hot" bindtap="onSwitchWishSort">🔥 热度</text>
      <text class="wish-sort-btn {{wishSortBy === 'new' ? 'active' : ''}}" data-sort="new" bindtap="onSwitchWishSort">🕐 最新</text>
    </view>

    <!-- 许愿卡列表 -->
    <view class="wish-list" wx:if="{{wishes.length > 0}}">
      <view
        class="wish-card card"
        wx:for="{{wishes}}"
        wx:key="wishId"
        data-id="{{item.wishId}}"
        bindtap="goWishDetail"
      >
        <view class="wish-card-header">
          <view data-user-id="{{item.userId}}" catchtap="goToUserHome" class="wish-user-info">
            <image class="wish-avatar" src="{{item.avatar || '/assets/images/default-avatar.png'}}" mode="aspectFill"/>
            <text class="wish-nickname">{{item.nickName || '无名修士'}}</text>
          </view>
          <text class="wish-status" wx:if="{{item.status === 'fulfilled'}}">已满足</text>
        </view>
        <view class="wish-card-content">{{item.content}}</view>
        <view class="wish-card-footer">
          <view class="wish-card-stats">
            <text class="wish-stat">❤ {{item.likeCount || 0}}</text>
            <text class="wish-stat">💬 {{item.commentCount || 0}}</text>
            <text class="wish-stat">⭐ {{item.favCount || 0}}</text>
          </view>
          <view class="wish-card-actions">
            <text class="wish-like-btn {{item._isLiked ? 'liked' : ''}}" catchtap="onLikeWish" data-id="{{item.wishId}}">{{item._isLiked ? '♥' : '♡'}}</text>
            <text class="wish-comment-entry">评论</text>
          </view>
        </view>
      </view>
      <view class="wish-loadmore" wx:if="{{wishHasMore}}" bindtap="_loadWishes" data-reset="false">加载更多...</view>
    </view>

    <!-- 空态 -->
    <view class="wish-empty" wx:if="{{wishes.length === 0 && !wishLoading}}">
      <text>还没有许愿，来许第一个愿吧</text>
    </view>

  </view>

  <!-- 悬浮创建按钮（非空状态） -->
  <view class="fab-create-btn" wx:if="{{hasCustomTemplates}}" bindtap="openTypeSheet">
    <text class="fab-create-icon">+</text>
  </view>

  <!-- 模板类型选择面板 -->
  <view class="sheet-overlay {{showTypeSheet ? 'show' : ''}}" bindtap="closeTypeSheet">
    <view class="sheet-panel" catchtap="preventBubble">
      <view class="sheet-title">选择模板类型</view>
      <view class="sheet-cards">
        <view class="sheet-card" data-type="daily" bindtap="goToTemplateBuilder">
          <view class="sc-icon">☀️</view>
          <view class="sc-name">日模板</view>
          <view class="sc-desc">单日24小时分段计划</view>
        </view>
        <view class="sheet-card" data-type="weekly" bindtap="goToTemplateBuilder">
          <view class="sc-icon">📅</view>
          <view class="sc-name">周模板</view>
          <view class="sc-desc">整周周期循环计划</view>
        </view>
        <view class="sheet-card" data-type="hedao" bindtap="goToTemplateBuilder">
          <view class="sc-icon">☯</view>
          <view class="sc-name">合道模板</view>
          <view class="sc-desc">全天综合计划，所有时段填满</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 模板操作菜单 -->
  <view class="sheet-overlay {{showTemplateMenu ? 'show' : ''}}" bindtap="closeTemplateMenu">
    <view class="sheet-panel menu-panel" catchtap="preventBubble">
      <view class="sheet-title">操作 — {{menuTemplate.name}}</view>
      <view class="menu-items">
        <view class="menu-item" data-id="{{menuTemplate.id}}" catchtap="enableTemplate">
          <text class="mi-icon">▶</text>
          <text class="mi-text">启用</text>
        </view>
        <view class="menu-item" data-id="{{menuTemplate.id}}" catchtap="editCustomTemplate">
          <text class="mi-icon">✎</text>
          <text class="mi-text">编辑</text>
        </view>
        <view class="menu-item" catchtap="duplicateCustomTemplate">
          <text class="mi-icon">📋</text>
          <text class="mi-text">另存为新模板</text>
        </view>
        <view class="menu-item danger" catchtap="deleteCustomTemplate">
          <text class="mi-icon">✕</text>
          <text class="mi-text">删除</text>
        </view>
      </view>
      <view class="menu-cancel" bindtap="closeTemplateMenu">取消</view>
    </view>
  </view>

</view>
