/* ═══════════════════════════════════════════════════════════
   天道修行 · 全局设计系统 v3
   三界归一：仙界·金箔仙域 | 红尘·修行人间 | 地狱·业火炼狱 | 修行·墨韵
   ═══════════════════════════════════════════════════════════ */

/* ── 设计令牌：间距 ── */
page {
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 16rpx;
  --space-lg: 24rpx;
  --space-xl: 32rpx;
  --space-2xl: 40rpx;

  /* ── 设计令牌：字号 ── */
  --font-xs: 20rpx;
  --font-sm: 22rpx;
  --font-md: 24rpx;
  --font-lg: 26rpx;
  --font-xl: 28rpx;
  --font-2xl: 32rpx;
  --font-3xl: 36rpx;
  --font-4xl: 40rpx;

  /* ── 设计令牌：圆角 ── */
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 20rpx;
  --radius-xl: 24rpx;
  --radius-full: 999rpx;

  /* ── 设计令牌：字重 ── */
  --weight-normal: 400;
  --weight-medium: 500;
  --weight-semibold: 600;
  --weight-bold: 700;

  /* ── 基础主题（浅色 / 修行主题默认） ── */
  --color-page-bg: #f7f8fa;
  --color-card-bg: #ffffff;
  --color-surface-soft: #f3f4f6;
  --color-surface-muted: #edf0f4;
  --color-border: #e8eaed;
  --color-border-strong: #d1d5db;
  --color-divider: #e8eaed;
  --color-primary: #10b981;
  --color-primary-soft: #34d399;
  --color-primary-rgb: 16, 185, 129;
  --color-text-primary: #1f2937;
  --color-text-secondary: #6b7280;
  --color-text-muted: #9ca3af;
  --color-text-tertiary: #9ca3af;
  --color-success: #10b981;
  --color-danger: #ef4444;
  --color-danger-text: #ef4444;
  --color-danger-rgb: 239, 68, 68;
  --color-silver: #9ca3af;
  --color-blue: #60a5fa;

  --color-primary-mist: #ecfdf5;
  --color-primary-mist-strong: #d1fae5;
  --color-danger-mist: #fee2e2;
  --color-info-mist: #dbeafe;
  --color-warning: #f59e0b;
  --color-warning-mist: #fef3c7;

  --primary-mist: var(--color-primary-mist);
  --primary-mist-strong: var(--color-primary-mist-strong);
  --danger-mist: var(--color-danger-mist);
  --info-mist: var(--color-info-mist);
  --warning: var(--color-warning);
  --warning-mist: var(--color-warning-mist);

  /* ── 别名（向后兼容旧代码） ── */
  --page-bg: var(--color-page-bg);
  --card-bg: var(--color-card-bg);
  --surface-soft: var(--color-surface-soft);
  --surface-muted: var(--color-surface-muted);
  --border-color: var(--color-border);
  --border-strong: var(--color-border-strong);
  --divider-color: var(--color-divider);
  --primary: var(--color-primary);
  --primary-soft: var(--color-primary-soft);
  --primary-rgb: var(--color-primary-rgb);
  --text-primary: var(--color-text-primary);
  --text-secondary: var(--color-text-secondary);
  --text-muted: var(--color-text-muted);
  --text-tertiary: var(--color-text-tertiary);
  --success: var(--color-success);
  --danger: var(--color-danger);
  --danger-text: var(--color-danger-text);
  --danger-rgb: var(--color-danger-rgb);
  --silver: var(--color-silver);
  --blue: var(--color-blue);

  /* ── 基础全局样式 ── */
  min-height: 100vh;
  background: var(--color-page-bg);
  color: var(--color-text-primary);
  font-family: 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: var(--font-lg);
  line-height: 1.6;
}

/* ── 统一盒模型 ── */
view, text, input, textarea, button, picker, scroll-view {
  box-sizing: border-box;
}

/* ═══════════════════════════════════════════════════════════
   主题页面容器
   ═══════════════════════════════════════════════════════════ */
.theme-page {
  min-height: 100vh;
  background-color: var(--page-bg);
  color: var(--text-primary);
  position: relative;
}

.theme-page,
.theme-page view,
.theme-page text,
.theme-page input,
.theme-page textarea,
.theme-page button {
  transition: background-color 0.5s ease, color 0.5s ease, border-color 0.5s ease, box-shadow 0.6s ease;
}

/* ── 统一页面容器（所有页面使用） ── */
.container {
  min-height: 100vh;
  padding: var(--space-lg) 0 var(--space-2xl);
  background: var(--page-bg);
}

/* ═══════════════════════════════════════════════════════════
   通用 UI 组件样式
   ═══════════════════════════════════════════════════════════ */

/* ── 卡片 ── */
.card {
  position: relative;
  margin: 0 var(--space-lg) var(--space-lg);
  padding: var(--space-xl);
  border-radius: var(--radius-xl);
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
  overflow: hidden;
}
.card-premium {
  border-color: rgba(var(--primary-rgb), 0.2);
}
.card-flush {
  margin-left: 0;
  margin-right: 0;
}
.card-tight {
  padding: var(--space-lg);
}

/* ── 区块标题 ── */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-md);
}
.section-title {
  font-size: var(--font-xl);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  line-height: 1.5;
}
.section-subtitle {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}
.section-more {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}

/* ── 按钮 ── */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 var(--space-xl);
  border: none;
  border-radius: var(--radius-lg);
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  line-height: 1.5;
}
.btn-primary {
  color: #ffffff;
  background: var(--primary);
}
.btn-ghost {
  color: var(--text-primary);
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}
.btn-danger {
  color: #ffffff;
  background: var(--danger);
}

/* ── 标签 ── */
.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: var(--space-xs) 18rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-md);
  line-height: 1.5;
  margin: 4rpx;
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
  color: var(--text-secondary);
}

/* ── 进度条 ── */
.progress-bar {
  width: 100%;
  height: 12rpx;
  overflow: hidden;
  border-radius: var(--radius-full);
  background: var(--surface-soft);
}
.progress-fill {
  height: 100%;
  border-radius: var(--radius-full);
  background: var(--primary);
  transition: width 0.4s ease;
}

/* ── 列表项 ── */
.list-item {
  padding: var(--space-lg) 0;
  border-bottom: 1rpx solid var(--divider-color);
}
.list-item:last-child {
  border-bottom: none;
}

/* ── 空状态 ── */
.empty-state {
  padding: 80rpx 0 60rpx;
  text-align: center;
}
.empty-icon {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto var(--space-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-xl);
  font-size: var(--font-2xl);
  font-weight: var(--weight-bold);
  color: var(--primary);
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}
.empty-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}

/* ── 分割线 ── */
.divider {
  width: 100%;
  height: 1rpx;
  background: var(--divider-color);
}

/* ── 辅助文字色 ── */
.text-primary { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-muted { color: var(--text-muted); }
.text-positive { color: var(--success); }
.text-negative { color: var(--danger-text); }
.text-accent { color: var(--primary); }

