/* ═══════════════════════════════════════════════════════════
   主题装饰元素（WXML 驱动）
   ═══════════════════════════════════════════════════════════ */
.theme-deco {
  position: fixed;
  pointer-events: none;
  z-index: 1;
}

/* 仙界 —— 金箔粒子 */
.theme-deco.foil {
  border-radius: 50%;
  background: radial-gradient(circle, rgba(200,160,100,0.35) 0%, transparent 70%);
  animation: foilFloat 4s ease-in-out infinite;
}
@keyframes foilFloat {
  0%, 100% { transform: translateY(0); opacity: 0.6; }
  50% { transform: translateY(-4rpx); opacity: 1; }
}
.theme-deco.foil-1 { top: 6%; left: 8%; width: 8rpx; height: 8rpx; animation-delay: 0s; }
.theme-deco.foil-2 { top: 8%; left: 24%; width: 6rpx; height: 6rpx; animation-delay: 0.5s; }
.theme-deco.foil-3 { top: 3%; left: 42%; width: 10rpx; height: 10rpx; animation-delay: 1s; }
.theme-deco.foil-4 { top: 12%; left: 58%; width: 5rpx; height: 5rpx; animation-delay: 1.5s; }
.theme-deco.foil-5 { top: 5%; left: 76%; width: 7rpx; height: 7rpx; animation-delay: 2s; }
.theme-deco.foil-6 { top: 10%; left: 90%; width: 8rpx; height: 8rpx; animation-delay: 2.5s; }
.theme-deco.foil-7 { top: 20%; left: 14%; width: 6rpx; height: 6rpx; animation-delay: 3s; }
.theme-deco.foil-8 { top: 16%; left: 68%; width: 9rpx; height: 9rpx; animation-delay: 3.5s; }

/* 仙界 —— 云雾 */
.theme-deco.cloud {
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(255,255,255,0.4) 0%, transparent 70%);
  animation: cloudDrift 8s ease-in-out infinite;
}
@keyframes cloudDrift {
  0%, 100% { transform: translateX(0); }
  50% { transform: translateX(20rpx); }
}
.theme-deco.cloud-1 { top: 5%; left: -5%; width: 400rpx; height: 100rpx; animation-delay: 0s; }
.theme-deco.cloud-2 { top: 12%; right: -8%; width: 350rpx; height: 80rpx; animation-delay: 3s; }
.theme-deco.cloud-3 { top: 78%; left: 10%; width: 300rpx; height: 70rpx; animation-delay: 6s; }

/* 仙界 —— 金日光轮 */
.theme-deco.golden-sun {
  top: -60rpx; right: -60rpx;
  width: 300rpx; height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,240,200,0.3) 0%, rgba(255,220,160,0.06) 40%, transparent 70%);
  box-shadow: 0 0 120rpx 60rpx rgba(230,200,140,0.04);
}

/* 仙界 —— 远山 */
.theme-deco.mountains {
  bottom: 0; left: 0; right: 0; height: 30%;
  background: linear-gradient(to top, rgba(140,130,115,0.06) 0%, transparent 70%);
  -webkit-mask-image: linear-gradient(to top, #000 40%, transparent);
  mask-image: linear-gradient(to top, #000 40%, transparent);
}

/* 红尘 —— 灵光粒子 */
.theme-deco.spark {
  border-radius: 50%;
  background: radial-gradient(circle, rgba(220,160,80,0.3) 0%, transparent 70%);
  animation: sparkPulse 3s ease-in-out infinite;
}
@keyframes sparkPulse {
  0%, 100% { opacity: 0.4; transform: scale(1); }
  50% { opacity: 0.8; transform: scale(1.3); }
}
.theme-deco.spark-1 { top: 8%; left: 12%; width: 8rpx; height: 8rpx; animation-delay: 0s; }
.theme-deco.spark-2 { top: 5%; left: 35%; width: 6rpx; height: 6rpx; animation-delay: 0.4s; }
.theme-deco.spark-3 { top: 15%; left: 55%; width: 10rpx; height: 10rpx; animation-delay: 0.8s; }
.theme-deco.spark-4 { top: 6%; left: 72%; width: 5rpx; height: 5rpx; animation-delay: 1.2s; }
.theme-deco.spark-5 { top: 12%; left: 88%; width: 7rpx; height: 7rpx; animation-delay: 1.6s; }
.theme-deco.spark-6 { top: 22%; left: 20%; width: 6rpx; height: 6rpx; animation-delay: 2s; }
.theme-deco.spark-7 { top: 18%; left: 45%; width: 8rpx; height: 8rpx; animation-delay: 2.4s; }
.theme-deco.spark-8 { top: 28%; left: 80%; width: 9rpx; height: 9rpx; animation-delay: 2.8s; }

/* 红尘 —— 暖霞辉光 */
.theme-deco.warm-glow {
  top: 0; left: 0; right: 0; height: 50%;
  background: linear-gradient(180deg, rgba(255,190,120,0.1) 0%, rgba(255,170,90,0.03) 40%, transparent 80%);
}

/* 红尘 —— 修行灯影 */
.theme-deco.lantern-glow {
  bottom: 8%; right: 6%;
  width: 160rpx; height: 160rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,160,70,0.12) 0%, rgba(255,140,50,0.03) 50%, transparent 70%);
  box-shadow: 0 0 60rpx 30rpx rgba(255,150,60,0.04);
}

/* 地狱 —— 灰烬粒子 */
.theme-deco.ash {
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,80,25,0.3) 0%, transparent 70%);
  animation: ashFall 4s ease-in-out infinite;
}
@keyframes ashFall {
  0%, 100% { transform: translateY(0); opacity: 0.4; }
  50% { transform: translateY(6rpx); opacity: 0.8; }
}
.theme-deco.ash-1 { top: 6%; left: 8%; width: 6rpx; height: 6rpx; animation-delay: 0s; }
.theme-deco.ash-2 { top: 10%; left: 20%; width: 8rpx; height: 8rpx; animation-delay: 0.5s; }
.theme-deco.ash-3 { top: 4%; left: 38%; width: 5rpx; height: 5rpx; animation-delay: 1s; }
.theme-deco.ash-4 { top: 8%; left: 52%; width: 9rpx; height: 9rpx; animation-delay: 1.5s; }
.theme-deco.ash-5 { top: 12%; left: 70%; width: 6rpx; height: 6rpx; animation-delay: 2s; }
.theme-deco.ash-6 { top: 5%; left: 85%; width: 7rpx; height: 7rpx; animation-delay: 2.5s; }
.theme-deco.ash-7 { top: 18%; left: 14%; width: 8rpx; height: 8rpx; animation-delay: 3s; }
.theme-deco.ash-8 { top: 24%; left: 32%; width: 5rpx; height: 5rpx; animation-delay: 0.3s; }
.theme-deco.ash-9 { top: 16%; left: 60%; width: 7rpx; height: 7rpx; animation-delay: 0.8s; }
.theme-deco.ash-10 { top: 22%; left: 78%; width: 9rpx; height: 9rpx; animation-delay: 1.3s; }

/* 地狱 —— 熔岩辉光 */
.theme-deco.lava-glow {
  bottom: 0; left: 0; right: 0; height: 45%;
  background: linear-gradient(to top, rgba(255,50,5,0.08) 0%, rgba(200,30,10,0.03) 30%, transparent 70%);
}

/* 地狱 —— 龟裂纹 */
.theme-deco.cracks {
  bottom: 0; left: 0; right: 0; height: 35%;
}
.theme-deco.cracks::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0; height: 100%;
  background:
    linear-gradient(100deg, transparent 26%, rgba(255,80,20,0.08) 26%, rgba(255,100,30,0.14) 28%, rgba(255,80,20,0.04) 30%, transparent 30%),
    linear-gradient(95deg, transparent 54%, rgba(255,60,15,0.06) 54%, rgba(255,90,25,0.10) 56%, rgba(255,60,15,0.04) 58%, transparent 58%),
    linear-gradient(88deg, transparent 70%, rgba(255,70,18,0.08) 70%, rgba(255,100,30,0.12) 72%, rgba(255,70,18,0.04) 74%, transparent 74%);
}

/* 地狱 —— 鬼影 */
.theme-deco.ghost {
  top: 3%; right: 2%;
  width: 120rpx; height: 240rpx;
  border-radius: 45% 45% 50% 50%;
  background: radial-gradient(ellipse 30rpx 40rpx at 50% 18%, rgba(200,180,170,0.5) 0%, transparent 60%),
              radial-gradient(ellipse 36rpx 70rpx at 50% 55%, rgba(200,180,170,0.3) 0%, transparent 55%);
  box-shadow: 0 0 50rpx 15rpx rgba(255,50,10,0.04),
              -22rpx -38rpx 0 -12rpx rgba(255,80,20,0.16),
              22rpx -38rpx 0 -12rpx rgba(255,80,20,0.16);
  animation: ghostSway 8s ease-in-out infinite;
}
@keyframes ghostSway {
  0%, 100% { transform: translateX(0) translateY(0); }
  25% { transform: translateX(6rpx) translateY(-5rpx); }
  50% { transform: translateX(-4rpx) translateY(-8rpx); }
  75% { transform: translateX(-6rpx) translateY(-2rpx); }
}

/* 地狱 —— 血月 */
.theme-deco.blood-moon {
  top: 4%; left: 6%;
  width: 100rpx; height: 100rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(180,30,20,0.14) 0%, rgba(120,20,10,0.06) 50%, transparent 70%);
  box-shadow: 0 0 50rpx 15rpx rgba(180,20,10,0.06);
}
