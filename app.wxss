/* ═══════════════════════════════════════════════════════════
   天道修行 · 全局设计系统 v3
   三界归一：仙界·金箔仙域 | 红尘·修行人间 | 地狱·业火炼狱 | 修行·墨韵
   ═══════════════════════════════════════════════════════════ */

/* ── 设计令牌：间距 ── */
page {
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 16rpx;
  --space-lg: 24rpx;
  --space-xl: 32rpx;
  --space-2xl: 40rpx;

  /* ── 设计令牌：字号（大胆层级：大标题 + 小辅助 + 强对比）── */
  --font-xs: 20rpx;
  --font-sm: 22rpx;
  --font-md: 28rpx;
  --font-lg: 30rpx;
  --font-xl: 34rpx;
  --font-2xl: 42rpx;
  --font-3xl: 52rpx;
  --font-4xl: 72rpx;

  /* ── 设计令牌：圆角（超级圆润派：全 pill + 大 XL）── */
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 40rpx;
  --radius-full: 999rpx;

  /* ── 设计令牌：字重 ── */
  --weight-normal: 400;
  --weight-medium: 500;
  --weight-semibold: 600;
  --weight-bold: 700;

  /* ── 玉青三主色（渐深：玉青 → 碧青 → 翠青） + 仙金三级（吝啬+金徽章双用）── */
  --color-primary-deep: #0d8a66;
  --color-primary: #0fa97a;
  --color-primary-light: #12c990;
  --color-primary-rgb: 15, 169, 122;
  --color-gold-deep: #b8882e;
  --color-gold: #c9a45c;
  --color-gold-light: #e8d5a0;
  --color-gold-rgb: 201, 164, 92;

  /* ── 基础主题（青霭仙天：顶部青雾 → 中央浅灰 → 底部近雪白，天地三叠）── */
  --color-page-bg: #f5f5f7;
  --color-card-bg: rgba(255, 255, 255, 0.94);
  --color-surface-soft: #f7f7f8;
  --color-surface-muted: #ececf0;
  --color-border: #e5e5ea;
  --color-border-strong: #d1d1d6;
  --color-divider: #e5e5ea;
  --color-text-primary: #1d1d1f;
  --color-text-secondary: #5d5d62;
  --color-text-muted: #aeaeb2;
  --color-text-tertiary: #aeaeb2;
  --color-success: #0fa97a;
  --color-danger: #e05a4a;
  --color-danger-text: #e05a4a;
  --color-danger-rgb: 224, 90, 74;
  --color-silver: #aeaeb2;
  --color-blue: #3a6db5;

  --color-primary-mist: #e8f4ef;
  --color-primary-mist-strong: #cdeee0;
  --color-danger-mist: #fcebe9;
  --color-info-mist: #e8f0fb;
  --color-warning: #f5a623;
  --color-warning-mist: #fdf0e0;

  --primary-mist: var(--color-primary-mist);
  --primary-mist-strong: var(--color-primary-mist-strong);
  --danger-mist: var(--color-danger-mist);
  --info-mist: var(--color-info-mist);
  --warning: var(--color-warning);
  --warning-mist: var(--color-warning-mist);

  /* ── 阴影（大胆版：玻璃卡内光 + 青绿投影 + 英雄发光；全部合规：列表12/单卡24/按钮20）── */
  --shadow-sm: 0 2rpx 4rpx rgba(0, 0, 0, 0.03), 0 6rpx 12rpx rgba(13, 138, 102, 0.05);
  --shadow-card: 0 -1rpx 0 rgba(255, 255, 255, 0.95) inset,
                 0 2rpx 4rpx rgba(0, 0, 0, 0.03),
                 0 8rpx 20rpx rgba(13, 138, 102, 0.06);
  --shadow-hero: 0 -1rpx 0 rgba(255, 255, 255, 0.98) inset,
                 0 4rpx 10rpx rgba(13, 138, 102, 0.10),
                 0 12rpx 24rpx rgba(201, 164, 92, 0.08);

  /* ── 别名（向后兼容旧代码） ── */
  --page-bg: var(--color-page-bg);
  --card-bg: var(--color-card-bg);
  --surface-soft: var(--color-surface-soft);
  --surface-muted: var(--color-surface-muted);
  --border-color: var(--color-border);
  --border-strong: var(--color-border-strong);
  --divider-color: var(--color-divider);
  --primary: var(--color-primary);
  --primary-soft: var(--color-primary-light);
  --primary-rgb: var(--color-primary-rgb);
  --text-primary: var(--color-text-primary);
  --text-secondary: var(--color-text-secondary);
  --text-muted: var(--color-text-muted);
  --text-tertiary: var(--color-text-tertiary);
  --success: var(--color-success);
  --danger: var(--color-danger);
  --danger-text: var(--color-danger-text);
  --danger-rgb: var(--color-danger-rgb);
  --silver: var(--color-silver);
  --blue: var(--color-blue);

  /* ── 基础全局样式：仙穹天地三层（1底色+2伪元素云+山）── */
  min-height: 100vh;
  background: linear-gradient(180deg, #eef6f2 0%, #f5f5f7 38%, #fafcfc 100%);
  color: var(--color-text-primary);
  font-family: 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: var(--font-lg);
  line-height: 1.65;
  position: relative;
  overflow-x: hidden;
}

/* ── 仙穹：左上 + 右上双层霭云（看得见的轻云，不是若有若无）── */
page::before {
  content: '';
  position: absolute;
  left: -20%;
  top: 40rpx;
  width: 68%;
  height: 320rpx;
  background:
    radial-gradient(60% 60% at 25% 70%, rgba(255,255,255,0.82) 0%, rgba(255,255,255,0.20) 48%, transparent 70%),
    radial-gradient(45% 45% at 72% 50%, rgba(255,255,255,0.68) 0%, rgba(255,255,255,0.18) 48%, transparent 72%);
  pointer-events: none;
  z-index: 0;
}

/* ── 仙穹：双层仙山（后山远淡210rpx + 前山主峰290rpx，中央弧顶更高）── */
page::after {
  content: '';
  position: absolute;
  left: -15%;
  right: -15%;
  bottom: 0;
  height: 380rpx;
  background:
    radial-gradient(68% 56% at 28% 100%, rgba(20,180,130,0.10) 0%, transparent 68%),
    radial-gradient(74% 76% at 72% 100%, rgba(13,138,102,0.16) 0%, transparent 68%);
  border-top-left-radius: 54% 92%;
  border-top-right-radius: 58% 88%;
  pointer-events: none;
  z-index: 0;
}

/* ── 统一盒模型 ── */
view, text, input, textarea, button, picker, scroll-view {
  box-sizing: border-box;
}

/* ═══════════════════════════════════════════════════════════
   主题页面容器
   ═══════════════════════════════════════════════════════════ */
.theme-page {
  min-height: 100vh;
  background-color: var(--page-bg);
  color: var(--text-primary);
  position: relative;
}

.theme-page,
.theme-page view,
.theme-page text,
.theme-page input,
.theme-page textarea,
.theme-page button {
  transition: background-color 0.5s ease, color 0.5s ease, border-color 0.5s ease, box-shadow 0.6s ease;
}

/* ── 统一页面容器（所有页面使用） ── */
.container {
  min-height: 100vh;
  padding: var(--space-lg) 0 var(--space-2xl);
  background: var(--page-bg);
}

/* ═══════════════════════════════════════════════════════════
   通用 UI 组件样式
   ═══════════════════════════════════════════════════════════ */

/* ── 卡片：玻璃仙卡（半透明+内顶白光+外层青绿柔影+超级圆角）── */
.card {
  position: relative;
  margin: 0 var(--space-lg) var(--space-2xl);
  padding: 36rpx;
  border-radius: 40rpx;
  background: var(--card-bg);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  overflow: hidden;
  box-shadow: 0 -1rpx 0 rgba(255, 255, 255, 0.95) inset,
              0 2rpx 4rpx rgba(0, 0, 0, 0.03),
              0 10rpx 24rpx rgba(13, 138, 102, 0.08);
  z-index: 1;
}
.card-premium {
  border: 1rpx solid rgba(var(--gold-rgb), 0.40);
  box-shadow: 0 -1rpx 0 rgba(255, 255, 255, 0.98) inset,
              0 0 0 1rpx rgba(var(--gold-rgb), 0.16) inset,
              0 3rpx 6rpx rgba(0, 0, 0, 0.04),
              0 12rpx 24rpx rgba(201, 164, 92, 0.14);
}
.card-flush {
  margin-left: 0;
  margin-right: 0;
}
.card-tight {
  padding: 28rpx;
}

/* ── 区块标题 ── */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-md);
}
.section-title {
  font-size: var(--font-xl);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  line-height: 1.5;
}
.section-subtitle {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}
.section-more {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}

/* ── 按钮：超级圆角 pill + 玉青 3 级渐变 + 主色发光（20rpx 合规）── */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  padding: 0 40rpx;
  border: none;
  border-radius: 999rpx;
  font-size: var(--font-xl);
  font-weight: var(--weight-semibold);
  line-height: 1.5;
  letter-spacing: 0.5rpx;
  transition: transform 0.12s ease, box-shadow 0.2s ease, opacity 0.2s ease;
}
.btn::after {
  border: none;
}
.btn:active {
  transform: scale(0.96);
  opacity: 0.92;
}
.btn-primary {
  color: #ffffff;
  background: linear-gradient(135deg, #0d8a66 0%, #0fa97a 40%, #12c990 100%);
  box-shadow: 0 4rpx 10rpx rgba(15, 169, 122, 0.20),
              0 10rpx 20rpx rgba(15, 169, 122, 0.18);
}
.btn-ghost {
  color: var(--text-primary);
  background: var(--surface-soft);
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.03);
}
.btn-danger {
  color: #ffffff;
  background: linear-gradient(135deg, #c94a3a 0%, #e05a4a 55%, #ef7a6a 100%);
  box-shadow: 0 4rpx 10rpx rgba(224, 90, 74, 0.20),
              0 10rpx 20rpx rgba(224, 90, 74, 0.16);
}

/* ── 标签：全圆角 pill + 3 级徽章（玉青/仙金/素银）+ 轻透底 ── */
.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: var(--font-md);
  font-weight: var(--weight-medium);
  line-height: 1.5;
  margin: 6rpx;
  background: rgba(13, 138, 102, 0.08);
  border: 1rpx solid rgba(13, 138, 102, 0.18);
  color: #0d8a66;
}
.tag-gold {
  color: #8a6422;
  background: linear-gradient(135deg, rgba(201,164,92,0.16), rgba(232,213,160,0.22));
  border-color: rgba(var(--gold-rgb), 0.40);
  box-shadow: 0 2rpx 8rpx rgba(201, 164, 92, 0.08);
}
.tag-silver {
  color: var(--text-secondary);
  background: rgba(0, 0, 0, 0.04);
  border-color: rgba(0, 0, 0, 0.08);
}

/* ═══════════════════════════════════════════════════════════
   全局统一工具类（大胆版 · 看得见的仙气）
   ═══════════════════════════════════════════════════════════ */

/* ── 仙金徽章（圆/方 pill 通用：玉霄境界/关键数字/结缘数值）── */
.hero-badge,
.hero-badge-circle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #fffdf6;
  font-weight: var(--weight-bold);
  letter-spacing: 0.6rpx;
  text-shadow: 0 1rpx 2rpx rgba(90, 52, 10, 0.20);
  background: linear-gradient(135deg, #b8882e 0%, #c9a45c 42%, #e8d5a0 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: 0 -1rpx 0 rgba(255, 255, 255, 0.55) inset,
              0 4rpx 10rpx rgba(201, 164, 92, 0.26),
              0 10rpx 22rpx rgba(201, 164, 92, 0.18);
}
.hero-badge {
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  font-size: var(--font-xl);
}
.hero-badge-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  padding: 0;
  font-size: var(--font-2xl);
}

/* ── 仙金数字（吝啬原则：仅 value/score/realm 等数字类直接挂）── */
.num-gold,
.value-gold,
.stat-gold {
  color: #c9a45c;
  font-weight: var(--weight-bold);
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.05), 0 0 12rpx rgba(201, 164, 92, 0.22);
}

/* ── 选中态（玉青浅底+深字+细边 · 统一 Tab/筛选/分类/勾选）── */
.active-mist,
.active-jade {
  background: linear-gradient(135deg, rgba(18,201,144,0.14), rgba(15,169,122,0.10));
  color: #0d8a66;
  border: 1rpx solid rgba(13,138,102,0.30);
  font-weight: var(--weight-semibold);
}

/* ── 底部安全区 ── */
.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* ── 全局统一仙气：玉阙仙山（theme-page 兜底，防 page 父未 relative 时失效）── */
.theme-page::after,
.page-root::after {
  content: '';
  position: absolute;
  left: -10%;
  right: -10%;
  bottom: 0;
  height: 260rpx;
  background:
    radial-gradient(62% 54% at 32% 100%, rgba(20,180,130,0.12) 0%, transparent 68%),
    radial-gradient(72% 74% at 68% 100%, rgba(13,138,102,0.18) 0%, transparent 68%);
  border-top-left-radius: 56% 92%;
  border-top-right-radius: 58% 90%;
  pointer-events: none;
  z-index: 0;
}
.theme-page,
.page-root {
  position: relative;
  overflow-x: hidden;
}

/* ── 进度条：玉青 3 级渐变 + 条内高光 inset + 柔边 ── */
.progress-bar {
  width: 100%;
  height: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.05) inset;
}
.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #0d8a66 0%, #0fa97a 45%, #12c990 100%);
  box-shadow: 0 -1rpx 0 rgba(255, 255, 255, 0.28) inset;
  transition: width 0.4s ease;
}

/* ── 列表项 ── */
.list-item {
  padding: var(--space-lg) 0;
  border-bottom: 1rpx solid var(--divider-color);
}
.list-item:last-child {
  border-bottom: none;
}

/* ── 空状态 ── */
.empty-state {
  padding: 80rpx 0 60rpx;
  text-align: center;
}
.empty-icon {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto var(--space-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-xl);
  font-size: var(--font-2xl);
  font-weight: var(--weight-bold);
  color: var(--primary);
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
}
.empty-text {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}

/* ── 分割线 ── */
.divider {
  width: 100%;
  height: 1rpx;
  background: var(--divider-color);
}

/* ── 辅助文字色 ── */
.text-primary { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-muted { color: var(--text-muted); }
.text-positive { color: var(--success); }
.text-negative { color: var(--danger-text); }
.text-accent { color: var(--primary); }

/* ═══════════════════════════════════════════════════════════
   ✦ 仙界 · 金箔仙域
   ═══════════════════════════════════════════════════════════ */
.theme-xianjie {
  --color-page-bg: #faf7f0;
  --color-card-bg: #fffdfa;
  --color-surface-soft: #f7f2ea;
  --color-surface-muted: #efe9dd;
  --color-border: #e8e1d4;
  --color-border-strong: #d6cdbb;
  --color-divider: #e8e1d4;
  --color-primary: #c9a45c;
  --color-primary-soft: #a8843a;
  --color-primary-rgb: 201, 164, 92;
  --color-text-primary: #2a2622;
  --color-text-secondary: #6b645c;
  --color-text-muted: #a89f93;
  --color-text-tertiary: #a89f93;
  --color-success: #6a9e78;
  --color-danger: #c96a5a;
  --color-danger-text: #c96a5a;
  --color-danger-rgb: 201, 106, 90;
  --color-silver: #a89f93;
  --color-blue: #8a7a5e;

  --color-primary-mist: #f7f2e8;
  --color-primary-mist-strong: #e8dfcd;
  --color-danger-mist: #f7e8e6;
  --color-info-mist: #f0ece2;
  --color-warning: #c9a45c;
  --color-warning-mist: #f5eeda;

  --primary-mist: var(--color-primary-mist);
  --primary-mist-strong: var(--color-primary-mist-strong);
  --danger-mist: var(--color-danger-mist);
  --info-mist: var(--color-info-mist);
  --warning: var(--color-warning);
  --warning-mist: var(--color-warning-mist);

  --page-bg: var(--color-page-bg);
  --card-bg: var(--color-card-bg);
  --surface-soft: var(--color-surface-soft);
  --surface-muted: var(--color-surface-muted);
  --border-color: var(--color-border);
  --border-strong: var(--color-border-strong);
  --divider-color: var(--color-divider);
  --primary: var(--color-primary);
  --primary-soft: var(--color-primary-soft);
  --primary-rgb: var(--color-primary-rgb);
  --text-primary: var(--color-text-primary);
  --text-secondary: var(--color-text-secondary);
  --text-muted: var(--color-text-muted);
  --text-tertiary: var(--color-text-tertiary);
  --success: var(--color-success);
  --danger: var(--color-danger);
  --danger-text: var(--color-danger-text);
  --danger-rgb: var(--color-danger-rgb);
  --silver: var(--color-silver);
  --blue: var(--color-blue);
}

.theme-page.theme-xianjie {
  background: linear-gradient(175deg, #faf7f2 0%, #f5f0e5 40%, #efe8d8 70%, #faf7f2 100%);
  color: #3c3028;
}

.theme-xianjie,
.theme-xianjie view,
.theme-xianjie text {
  font-weight: 350;
  line-height: 1.75;
  letter-spacing: 0.5rpx;
}

.theme-xianjie .card {
  background: linear-gradient(135deg, #fffdfa 0%, #fefcf3 100%);
  border-color: rgba(201, 164, 92, 0.20);
  box-shadow: 0 2rpx 20rpx rgba(201, 164, 92, 0.04);
}
.theme-xianjie .card-premium {
  border-color: rgba(201, 164, 92, 0.30);
  box-shadow: 0 2rpx 24rpx rgba(201, 164, 92, 0.06);
}
.theme-xianjie .btn-primary {
  background: linear-gradient(135deg, #c9a45c 0%, #a8843a 100%);
  color: #fffdf6;
  box-shadow: 0 2rpx 14rpx rgba(201, 164, 92, 0.22);
  font-weight: 500;
  letter-spacing: 1rpx;
}
.theme-xianjie .progress-fill {
  background: linear-gradient(90deg, #c9a45c 0%, #a8843a 60%, #e8d5a0 100%);
  box-shadow: 0 0 10rpx rgba(201, 164, 92, 0.12);
}
.theme-xianjie .tag {
  background: rgba(255, 253, 250, 0.75);
  border-color: rgba(201, 164, 92, 0.22);
  color: #6b645c;
}

/* ═══════════════════════════════════════════════════════════
   ❂ 红尘 · 修行人间
   ═══════════════════════════════════════════════════════════ */
.theme-hongchen {
  --color-page-bg: #faf5f0;
  --color-card-bg: #fffdfa;
  --color-surface-soft: #f7f0e8;
  --color-surface-muted: #efe6da;
  --color-border: #e8ded0;
  --color-border-strong: #d6cbb8;
  --color-divider: #e8ded0;
  --color-primary: #0fa97a;
  --color-primary-soft: #0b8a63;
  --color-primary-rgb: 15, 169, 122;
  --color-text-primary: #2a2522;
  --color-text-secondary: #6b625c;
  --color-text-muted: #a89a8f;
  --color-text-tertiary: #a89a8f;
  --color-success: #6a9e78;
  --color-danger: #c96a5a;
  --color-danger-text: #c96a5a;
  --color-danger-rgb: 201, 106, 90;
  --color-silver: #a89a8f;
  --color-blue: #8a6a5e;
  --color-primary-mist: #e8f4ef;
  --color-primary-mist-strong: #cdeee0;
