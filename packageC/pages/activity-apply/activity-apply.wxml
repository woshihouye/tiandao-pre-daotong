<!-- 申请添加活动 -->
<view class="page">
  <view class="form">
    <!-- 活动名称 -->
    <view class="form-item">
      <text class="form-label">活动名称</text>
      <input class="form-input" placeholder="请输入活动名称" value="{{name}}" bindinput="onNameInput" maxlength="20" />
    </view>

    <!-- 分类（6 大道则） -->
    <view class="form-item">
      <text class="form-label">分类（6 大道则）</text>
      <picker mode="selector" range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="form-picker">
          <text>{{categories[categoryIndex].name}}</text>
          <text class="picker-arrow">▾</text>
        </view>
      </picker>
    </view>

    <!-- 单位 -->
    <view class="form-item">
      <text class="form-label">单位</text>
      <input class="form-input" placeholder="如 组/分钟/次/份" value="{{unit}}" bindinput="onUnitInput" maxlength="10" />
    </view>

    <!-- 建议分值 -->
    <view class="form-item">
      <text class="form-label">建议分值（每单位修为）</text>
      <input class="form-input" type="number" placeholder="输入数值，如 1" value="{{scorePerUnit}}" bindinput="onScoreInput" />
    </view>

    <!-- 介绍说明 -->
    <view class="form-item">
      <text class="form-label">介绍说明</text>
      <textarea class="form-textarea" placeholder="为什么值得进公共库、适合谁" value="{{description}}" bindinput="onDescInput" maxlength="200" />
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="bottom-bar">
    <button class="btn-submit" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">提交申请</button>
  </view>
</view>
