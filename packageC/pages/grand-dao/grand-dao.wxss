/* 大道详情页 - 玄幻修仙风格 */

/* ===== 大道介绍区 ===== */
.dao-hero {
  margin: var(--space-lg) var(--space-xl) var(--space-md);
  padding: var(--space-2xl) var(--space-xl);
  border-left: 4rpx solid var(--primary);
  text-align: center;
}

.dao-hero-cover {
  display: flex;
  justify-content: center;
  margin-bottom: var(--space-lg);
}

.dao-cover-badge {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 56rpx;
  font-weight: var(--weight-bold);
  color: var(--primary);
  background: rgba(var(--primary-rgb), 0.08);
  border: 2rpx solid rgba(var(--primary-rgb), 0.2);
  box-shadow: 0 0 40rpx rgba(var(--primary-rgb), 0.1);
}

.dao-hero-info {
  margin-bottom: var(--space-md);
}

.dao-hero-name {
  font-size: 44rpx;
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  line-height: 1.3;
  margin-bottom: var(--space-xs);
}

.dao-hero-slogan {
  font-size: var(--font-xl);
  color: var(--primary);
  font-weight: var(--weight-semibold);
  line-height: 1.4;
}

.dao-hero-desc {
  font-size: var(--font-lg);
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: var(--space-lg);
  padding: 0 var(--space-md);
}

/* 境界体系 */
.dao-realm-section {
  margin-bottom: var(--space-lg);
}

.dao-section-title {
  font-size: var(--font-lg);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: var(--space-md);
  text-align: center;
}

.dao-realm-list {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 0;
}

.dao-realm-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.dao-realm-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--border-color);
  flex-shrink: 0;
}

.dao-realm-dot.active {
  background: var(--primary);
  box-shadow: 0 0 8rpx rgba(var(--primary-rgb), 0.4);
}

.dao-realm-name {
  font-size: var(--font-md);
  color: var(--text-secondary);
  white-space: nowrap;
}

.dao-realm-line {
  width: 32rpx;
  height: 2rpx;
  background: var(--border-color);
  margin: 0 8rpx;
  flex-shrink: 0;
}

/* 大道元数据 */
.dao-meta-grid {
  display: flex;
  justify-content: center;
  gap: var(--space-lg);
  padding-top: var(--space-lg);
  border-top: 1rpx solid var(--border-color);
}

.dao-meta-item {
  text-align: center;
  flex: 1;
}

.dao-meta-value {
  font-size: var(--font-lg);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  line-height: 1.4;
}

.dao-meta-label {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  margin-top: 4rpx;
  line-height: 1.4;
}

/* ===== 功法列表 ===== */
.gongfa-section {
  padding: 0 var(--space-xl) var(--space-lg);
}

.gongfa-section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--space-md);
}

.gongfa-section-title {
  font-size: var(--font-2xl);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  line-height: 1.5;
}

.gongfa-section-count {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 功法卡片 */
.gongfa-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

.gongfa-card {
  display: flex;
  gap: var(--space-lg);
  padding: var(--space-xl);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--border-color);
  border-left: 4rpx solid var(--primary);
  transition: all 0.15s;
}

.gongfa-card:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.gongfa-card-cover {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-sm);
  flex-shrink: 0;
  width: 100rpx;
}

.gongfa-cover-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-xl);
  font-size: var(--font-3xl);
  font-weight: var(--weight-bold);
  color: var(--primary);
  background: rgba(var(--primary-rgb), 0.08);
  border: 1rpx solid rgba(var(--primary-rgb), 0.2);
}

.gongfa-cover-tag {
  padding: 2rpx 12rpx;
  border-radius: var(--radius-full);
  font-size: 20rpx;
  color: var(--primary);
  background: rgba(var(--primary-rgb), 0.08);
  border: 1rpx solid rgba(var(--primary-rgb), 0.15);
  line-height: 1.4;
}

.gongfa-card-body {
  flex: 1;
  min-width: 0;
}

.gongfa-card-name {
  font-size: var(--font-2xl);
  font-weight: var(--weight-bold);
  color: var(--text-primary);
  line-height: 1.4;
  margin-bottom: 4rpx;
}

.gongfa-card-goal {
  font-size: var(--font-md);
  color: var(--primary);
  font-weight: var(--weight-semibold);
  line-height: 1.4;
  margin-bottom: var(--space-sm);
}

.gongfa-card-desc {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: var(--space-md);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.gongfa-card-meta {
  display: flex;
  gap: var(--space-lg);
  margin-bottom: var(--space-md);
}

.gongfa-meta-item {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.5;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.gongfa-meta-icon {
  font-size: var(--font-md);
}

/* 功法卡片底部 */
.gongfa-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: var(--space-md);
  border-top: 1rpx solid var(--border-color);
}

.gongfa-card-tags {
  display: flex;
  gap: var(--space-xs);
  flex-wrap: wrap;
}

.gongfa-tag {
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-xs);
  color: var(--text-secondary);
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
  line-height: 1.4;
}

.gongfa-card-arrow {
  font-size: var(--font-md);
  color: var(--primary);
  font-weight: var(--weight-medium);
  white-space: nowrap;
  flex-shrink: 0;
}

/* 空状态 */
.gongfa-empty {
  text-align: center;
  padding: 64rpx var(--space-2xl);
}

.gongfa-empty-icon {
  font-size: 64rpx;
  margin-bottom: var(--space-md);
}

.gongfa-empty-title {
  font-size: var(--font-xl);
  font-weight: var(--weight-semibold);
  color: var(--text-primary);
  margin-bottom: var(--space-xs);
  line-height: 1.5;
}

.gongfa-empty-desc {
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 底部提示 */
.dao-tip {
  text-align: center;
  padding: var(--space-lg) var(--space-xl) var(--space-3xl);
  font-size: var(--font-md);
  color: var(--text-secondary);
  line-height: 1.5;
}
