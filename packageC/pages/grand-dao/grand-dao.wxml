<!-- 大道详情 · 功法列表 -->
<view class="container theme-page {{themeClass}}">

  <!-- ===== 大道介绍区 ===== -->
  <view class="card dao-hero" wx:if="{{dao}}">
    <view class="dao-hero-cover">
      <view class="dao-cover-badge">{{dao.cover}}</view>
    </view>
    <view class="dao-hero-info">
      <view class="dao-hero-name">{{dao.name}}</view>
      <view class="dao-hero-slogan">{{dao.subtitle || dao.goal || '择一而终，日修不辍'}}</view>
    </view>
    <view class="dao-hero-desc">{{dao.description}}</view>

    <!-- 境界体系 -->
    <view class="dao-realm-section" wx:if="{{dao.realmNames && dao.realmNames.length > 0}}">
      <view class="dao-section-title">境界体系</view>
      <view class="dao-realm-list">
        <view class="dao-realm-item" wx:for="{{dao.realmNames}}" wx:key="*this" wx:for-index="ri">
          <view class="dao-realm-dot {{ri === 0 ? 'active' : ''}}"></view>
          <view class="dao-realm-name">{{item}}</view>
          <view class="dao-realm-line" wx:if="{{ri < dao.realmNames.length - 1}}"></view>
        </view>
      </view>
    </view>

    <!-- 大道基础信息 -->
    <view class="dao-meta-grid">
      <view class="dao-meta-item">
        <view class="dao-meta-value">{{dao.dailyCap}}修为/日</view>
        <view class="dao-meta-label">每日上限</view>
      </view>
      <view class="dao-meta-item">
        <view class="dao-meta-value">{{dao.baseScore}}修为</view>
        <view class="dao-meta-label">基础修为</view>
      </view>
      <view class="dao-meta-item">
        <view class="dao-meta-value">{{dao.tasks ? dao.tasks.length : 0}}项</view>
        <view class="dao-meta-label">修行功课</view>
      </view>
      <view class="dao-meta-item">
        <view class="dao-meta-value">{{dao.founderName || '天道'}}</view>
        <view class="dao-meta-label">创道司府</view>
      </view>
    </view>
  </view>

  <!-- ===== 功法列表 ===== -->
  <view class="gongfa-section">
    <view class="gongfa-section-header">
      <view class="gongfa-section-title">收录功法</view>
      <view class="gongfa-section-count" wx:if="{{gongfaList.length > 0}}">{{gongfaList.length}}部</view>
    </view>

    <!-- 功法卡片 -->
    <view class="gongfa-list" wx:if="{{gongfaList.length > 0}}">
      <view
        class="card gongfa-card"
        wx:for="{{gongfaList}}"
        wx:key="id"
        bindtap="openGongfa"
        data-id="{{item.id}}"
      >
        <view class="gongfa-card-cover">
          <view class="gongfa-cover-icon">{{item.cover}}</view>
          <view class="gongfa-cover-tag">功法</view>
        </view>
        <view class="gongfa-card-body">
          <view class="gongfa-card-name">{{item.name}}</view>
          <view class="gongfa-card-goal">{{item.subtitle || item.goal}}</view>
          <view class="gongfa-card-desc">{{item.description}}</view>
          <view class="gongfa-card-meta">
            <view class="gongfa-meta-item">
              <text class="gongfa-meta-icon">⚔️</text>
              <text>{{item.tasks ? item.tasks.length : 0}}项修炼</text>
            </view>
            <view class="gongfa-meta-item">
              <text class="gongfa-meta-icon">📐</text>
              <text>{{item.dailyCap}}修为/日</text>
            </view>
          </view>
          <view class="gongfa-card-footer">
            <view class="gongfa-card-tags">
              <view class="gongfa-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</view>
            </view>
            <view class="gongfa-card-arrow">查看功法 →</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态：暂无功法 -->
    <view class="gongfa-empty card" wx:else>
      <view class="gongfa-empty-icon">📜</view>
      <view class="gongfa-empty-title">暂无收录功法</view>
      <view class="gongfa-empty-desc">此大道尚未收录修行功法，天工司正在编纂中，敬请期待。</view>
    </view>
  </view>

  <!-- 底部提示 -->
  <view class="dao-tip">
    <text>📖 选一功法，踏上修行之路</text>
  </view>

</view>
