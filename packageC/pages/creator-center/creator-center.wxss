.container { min-height: 100vh; padding: 24rpx; background: var(--page-bg); }
.stats-card { margin-bottom: 24rpx; padding: 28rpx; }
.stats-title { font-size: 28rpx; font-weight: 700; color: var(--text-primary); }
.stats-row { display: flex; margin-top: 18rpx; }
.stat-item { flex: 1; text-align: center; }
.stat-num { display: block; font-size: 36rpx; font-weight: 700; color: var(--primary); }
.stat-label { display: block; margin-top: 4rpx; font-size: 22rpx; color: var(--text-secondary); }
.section-title { font-size: 28rpx; font-weight: 700; color: var(--text-primary); margin-bottom: 16rpx; }
.publish-item { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid var(--border-color); }
.publish-name { font-size: 26rpx; font-weight: 600; color: var(--text-primary); flex: 1; }
.publish-meta { font-size: 22rpx; color: var(--text-secondary); margin: 0 16rpx; }
.publish-btn { padding: 6rpx 16rpx; font-size: 22rpx; color: var(--primary); }
.publish-btn.danger { color: #ef4444; }
.btn-ghost { margin-top: 16rpx; padding: 14rpx 0; border-radius: 14rpx; font-size: 26rpx; color: var(--text-primary); background: var(--surface-soft); border: 1rpx solid var(--border-color); }
