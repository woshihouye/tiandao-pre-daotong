<view class="container">
  <view class="card" wx:if="{{template}}">
    <view class="preview-name">{{template.name}}</view>
    <view class="preview-desc">{{template.description}}</view>
    <view class="preview-meta">任务数：{{template.tasks.length}} | 上限：{{template.dailyCap}}/日</view>
  </view>

  <view class="card">
    <view class="section-title">正文与素材</view>
    <textarea class="longtext-input" placeholder="写点正文，说说做这个模板的心情、由来（博主视角）" value="{{longTextContent}}" bindinput="onLongTextInput" maxlength="2000" auto-height />
    <input class="mini-input" placeholder="副标题（可选）" value="{{subtitle}}" bindinput="onSubtitleInput" maxlength="30" />
    <input class="mini-input" placeholder="一句话金句（可选）" value="{{slogan}}" bindinput="onSloganInput" maxlength="30" />

    <view class="media-row">
      <view class="media-item" wx:for="{{imageUrls}}" wx:key="*this" data-index="{{index}}" bindtap="removeImage">
        <image class="media-img" src="{{item}}" mode="aspectFill" />
        <text class="media-del">✕</text>
      </view>
      <view class="video-item" wx:for="{{videoUrls}}" wx:key="*this" data-index="{{index}}" bindtap="removeVideo">
        <video class="media-img" src="{{item}}" />
        <text class="media-del">✕</text>
      </view>
      <view class="media-add" bindtap="chooseImages">＋图片</view>
      <view class="media-add" bindtap="chooseVideos">＋视频</view>
    </view>

    <view class="link-item" wx:for="{{externalLinks}}" wx:key="title" data-index="{{index}}">
      <text class="link-title">{{item.title}}</text>
      <text class="link-url">{{item.url}}</text>
      <text class="link-del" data-index="{{index}}" bindtap="removeLink">删除</text>
    </view>
    <view class="link-add-row">
      <input class="mini-input link-title-input" placeholder="链接标题（如 list背单词）" value="{{linkTitle}}" bindinput="onLinkTitleInput" maxlength="20" />
      <input class="mini-input" placeholder="https://..." value="{{linkUrl}}" bindinput="onLinkUrlInput" />
      <button class="btn btn-mini" size="mini" bindtap="addLink">加链接</button>
    </view>
  </view>

  <view class="card">
    <view class="section-title">可见范围</view>
    <view class="option-group">
      <view class="option-item {{visibility === 'public' ? 'selected' : ''}}" data-value="public" bindtap="changeVisibility">公开 · 所有道友可见</view>
      <view class="option-item {{visibility === 'self' ? 'selected' : ''}}" data-value="self" bindtap="changeVisibility">仅自己 · 私人道则</view>
      <view class="option-item {{visibility === 'fans' ? 'selected' : ''}}" data-value="fans" bindtap="changeVisibility">仅粉丝 · 关注者可见</view>
      <view class="option-item {{visibility === 'whitelist' ? 'selected' : ''}}" data-value="whitelist" bindtap="changeVisibility">白名单 · 指定用户可见</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">评论权限</view>
    <view class="option-group">
      <view class="option-item {{commentPerm === 'all' ? 'selected' : ''}}" data-value="all" bindtap="changeCommentPerm">所有人可评论</view>
      <view class="option-item {{commentPerm === 'fans' ? 'selected' : ''}}" data-value="fans" bindtap="changeCommentPerm">仅粉丝可评论</view>
      <view class="option-item {{commentPerm === 'off' ? 'selected' : ''}}" data-value="off" bindtap="changeCommentPerm">关闭评论</view>
    </view>
  </view>

  <button class="btn btn-primary" style="margin: 24rpx;" bindtap="submitPublish" disabled="{{submitting}}">{{submitting ? '发布中...' : '发布至模板广场'}}</button>
</view>
