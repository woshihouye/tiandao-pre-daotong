/* 大道之行 · 活动库 — 双层筛选宫格版 */

/* 页面全高 flex 布局 */
page { height: 100%; }
.page-body { display: flex; flex-direction: column; min-height: 100vh; }

/* ========== 顶部 Hero ========== */
.section-hero {
  margin: 24rpx;
  padding: 32rpx 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, var(--card-bg) 0%, var(--surface-soft) 100%);
  border: 1rpx solid var(--border-color);
}
.hero-kicker { font-size: 24rpx; color: var(--text-secondary); margin-bottom: 8rpx; letter-spacing: 2rpx; }
.hero-title { font-size: 36rpx; font-weight: 700; color: var(--text-primary); margin-bottom: 10rpx; }
.hero-desc { font-size: 26rpx; color: var(--text-secondary); line-height: 1.6; }

.mode-switch {
  display: flex; margin: 0 24rpx 16rpx 24rpx;
  background: var(--bg-secondary, var(--surface-soft));
  border-radius: 40rpx; padding: 6rpx;
}
.mode-switch-item {
  flex: 1; text-align: center; padding: 14rpx 0;
  font-size: 26rpx; color: var(--text-secondary, var(--text-secondary));
  border-radius: 34rpx; transition: all 0.2s;
}
.mode-switch-item.active {
  background: var(--primary-color, var(--primary)); color: #fff; font-weight: 600;
}

/* ========== 主分类 Tab 胶囊 ========== */
.tab-scroll { padding: 0 24rpx; margin-bottom: 10rpx; }
.tab-scroll-inner { display: flex; white-space: nowrap; }
.tab-chip {
  display: inline-flex; align-items: center; padding: 12rpx 24rpx;
  margin-right: 14rpx; border-radius: 40rpx;
  background: var(--bg-secondary, var(--surface-soft));
  font-size: 26rpx; color: var(--text-secondary, var(--text-secondary));
  transition: all 0.2s;
}
.tab-chip.active { background: var(--primary-color, var(--primary)); color: #fff; }
.tab-chip-icon { margin-right: 6rpx; font-weight: 600; }
.tab-chip-text { font-weight: 500; }

/* ========== 搜索框 ========== */
.search-bar { padding: 0 24rpx; margin-bottom: 6rpx; }
.search-box { display: flex; align-items: center; background: var(--bg-secondary, var(--surface-soft)); border-radius: 40rpx; padding: 12rpx 24rpx; }
.search-icon { font-size: 28rpx; margin-right: 12rpx; }
.search-input { flex: 1; font-size: 26rpx; color: var(--text-primary, var(--text-primary)); }
.search-clear { font-size: 28rpx; color: var(--text-tertiary, var(--text-muted)); padding: 4rpx 10rpx; }

/* ========== 筛选 + 内容外框 ========== */
.filter-content-wrap { flex: 1; display: flex; flex-direction: column; }

/* ========== 左右分栏 ========== */
.split-layout { flex: 1; display: flex; padding: 0 24rpx; }

/* ---- 左侧侧边栏 ---- */
.side-bar {
  width: 150rpx; flex-shrink: 0;
  background: var(--bg-secondary, var(--page-bg)); border-radius: 16rpx;
  margin-right: 16rpx; padding: 8rpx 0;
}
.side-item {
  padding: 18rpx 12rpx; text-align: center; font-size: 24rpx;
  color: var(--text-secondary, var(--text-secondary)); border-radius: 10rpx;
  margin: 4rpx 8rpx; transition: all 0.2s;
}
.side-item.active { background: var(--primary-color, var(--primary)); color: #fff; font-weight: 600; }

/* 标签筛选行 */
.tag-filter-row {
  width: 100%; white-space: nowrap; padding: 4rpx 0 12rpx 0;
  display: flex; gap: 10rpx; flex-shrink: 0;
}
.tag-filter-item {
  display: inline-flex; align-items: center; flex-shrink: 0;
  padding: 6rpx 16rpx; border-radius: 20rpx;
  font-size: 22rpx; color: var(--text-secondary, var(--text-secondary));
  background: var(--bg-secondary, var(--surface-soft)); border: 1rpx solid transparent;
}
.tag-filter-item.active {
  color: #fff; background: var(--primary-color, var(--primary)); border-color: transparent;
}
.tag-count { font-size: 18rpx; margin-left: 4rpx; opacity: 0.7; }

/* ---- 右侧宫格区 ---- */
.grid-area { flex: 1; min-height: 0; }
.grid-container {
  display: flex; flex-direction: column; align-content: flex-start;
  padding: 4rpx 0; gap: 16rpx;
}

/* ---- 横向商品卡 ---- */
.grid-card {
  width: 100%; margin: 0 0 0 0;
  padding: 24rpx; border-radius: 28rpx;
  position: relative; box-sizing: border-box; overflow: hidden;
  background: var(--card-bg, var(--card-bg));
  border: 1rpx solid var(--border-color, var(--surface-soft));
  display: flex; align-items: center; gap: 20rpx;
}

/* 左：图标 */
.hc-icon {
  width: 112rpx; height: 112rpx; flex-shrink: 0; border-radius: 24rpx;
  background: linear-gradient(135deg, var(--primary-mist-strong) 0%, var(--primary-mist) 100%);
  display: flex; align-items: center; justify-content: center;
  font-size: 52rpx; font-weight: 700; color: var(--primary-color, var(--primary));
}
.is-negative .hc-icon { background: linear-gradient(135deg, var(--danger-mist) 0%, var(--danger-mist) 100%); color: var(--danger-text, var(--danger)); }

/* 中：信息区 */
.hc-info { flex: 1; min-width: 0; overflow: hidden; display: flex; flex-direction: column; gap: 8rpx; }
.hc-row1 {
  display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx;
  position: relative;
}
.hc-tags { display: flex; gap: 8rpx; flex-wrap: wrap; }
.hc-pin {
  position: absolute; right: 0; top: -2rpx;
  font-size: 28rpx; color: var(--text-tertiary, var(--border-strong));
  padding: 2rpx; line-height: 1;
}
.hc-pin.pinned { color: var(--warning); }
.hc-name {
  font-size: 28rpx; font-weight: 700; color: var(--text-primary, var(--text-primary));
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  max-width: 100%;
}

.hc-row2 {
  overflow: hidden; min-width: 0;
}
.hc-desc {
  font-size: 22rpx; color: var(--text-secondary, var(--text-secondary));
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.hc-row3 {
  display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap;
}
.hc-score { color: var(--danger); font-size: 30rpx; font-weight: 800; }
.hc-train {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-left: 12rpx;
  flex-shrink: 0;
}
.hc-ext { display: flex; flex-wrap: wrap; gap: 4rpx; }

/* 右：加购按钮 */
.hc-add {
  width: 52rpx; height: 52rpx; border-radius: 50%; flex-shrink: 0;
  background: var(--primary); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; font-weight: 700; line-height: 1;
}

/* 旧角标标签位置重置（hc-tags 内） */
.card-tags {
  display: flex;
  gap: 8rpx;
  position: static;
  left: auto;
  top: auto;
  z-index: auto;
  flex-wrap: wrap;
}

/* 负面活动淡灰底色 */
.grid-card.is-negative { background: rgba(239, 68, 68, 0.03); border-color: rgba(239, 68, 68, 0.1); }

/* 卡片操作按钮（横向布局适配） */
.card-actions {
  display: flex;
  justify-content: flex-start;
  gap: 12rpx;
  padding: 8rpx 0 0;
  width: 100%;
  box-sizing: border-box;
  flex-wrap: wrap;
  border-top: none;
}

/* 空状态 */
.empty-tip { width: 100%; text-align: center; padding: 60rpx 24rpx; }
.empty-text { font-size: 28rpx; color: var(--text-secondary, var(--text-secondary)); }
.empty-sub { font-size: 24rpx; color: var(--text-tertiary, var(--text-muted)); margin-top: 8rpx; }

/* 自定义活动角标 */
.card-custom-tag {
  position: absolute; left: 6rpx; top: 6rpx; z-index: 2;
  font-size: 18rpx; color: #fff; background: var(--primary-color, var(--primary));
  padding: 2rpx 10rpx; border-radius: 6rpx; line-height: 1.4;
}

.card-public-tag {
  position: absolute; right: 6rpx; top: 6rpx; z-index: 2;
  font-size: 18rpx; color: #fff; background: var(--blue);
  padding: 2rpx 10rpx; border-radius: 6rpx; line-height: 1.4;
}

.card-owner-name {
  font-size: 18rpx; color: var(--text-tertiary, var(--text-muted));
  text-align: center; margin-top: 2rpx; overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap;
}

/* 分组头 */
.group-header {
  display: flex; align-items: center; justify-content: space-between;
  width: 100%; padding: 16rpx 8rpx 8rpx 8rpx;
}
.group-name { font-size: 26rpx; font-weight: 700; color: var(--text-primary, var(--text-primary)); }
.group-count { font-size: 22rpx; color: var(--text-tertiary, var(--text-muted)); }

/* ========== 弹窗遮罩 ========== */
.modal-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45); z-index: 200;
  display: flex; align-items: flex-end;
  opacity: 0; pointer-events: none; transition: opacity 0.25s;
}
.modal-overlay.show { opacity: 1; pointer-events: auto; }

/* 弹窗面板 */
.modal-sheet {
  width: 100%; max-height: 80vh; overflow-y: auto;
  background: var(--card-bg); border-radius: 28rpx 28rpx 0 0;
  padding: 36rpx 32rpx 48rpx; box-sizing: border-box;
  animation: slideUp 0.3s ease;
}
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }

.modal-title {
  font-size: 34rpx; font-weight: 700; color: var(--text-primary);
  text-align: center; margin-bottom: 32rpx;
}

/* 表单 */
.form-group { margin-bottom: 24rpx; }
.form-label {
  font-size: 26rpx; color: var(--text-secondary, var(--text-secondary));
  margin-bottom: 10rpx; display: block;
}
.form-required { color: var(--danger); }
.form-input {
  width: 100%; height: 80rpx; padding: 0 20rpx; box-sizing: border-box;
  background: var(--bg-secondary, var(--surface-soft)); border-radius: 14rpx;
  font-size: 28rpx; color: var(--text-primary, var(--text-primary));
}
.form-textarea {
  width: 100%; min-height: 100rpx; padding: 16rpx 20rpx; box-sizing: border-box;
  background: var(--bg-secondary, var(--surface-soft)); border-radius: 14rpx;
  font-size: 28rpx; color: var(--text-primary, var(--text-primary));
}
.form-picker {
  width: 100%; height: 80rpx; padding: 0 20rpx; box-sizing: border-box;
  background: var(--bg-secondary, var(--surface-soft)); border-radius: 14rpx;
  font-size: 28rpx; color: var(--text-primary, var(--text-primary));
  display: flex; align-items: center;
}

/* 弹窗底部按钮 */
.modal-actions {
  display: flex; gap: 20rpx; margin-top: 32rpx;
}
.btn-cancel {
  flex: 1; height: 88rpx; border-radius: 16rpx;
  background: var(--bg-secondary, var(--surface-soft));
  color: var(--text-secondary, var(--text-secondary)); font-size: 30rpx;
  display: flex; align-items: center; justify-content: center;
}
.btn-confirm {
  flex: 1; height: 88rpx; border-radius: 16rpx;
  background: var(--primary-color, var(--primary));
  color: #fff; font-size: 30rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
}

/* 编辑弹窗：修行容量行 */
.form-group-row {
  display: flex; align-items: center; gap: 12rpx;
}
.group-input {
  flex: 1;
}
.group-unit {
  font-size: 28rpx; color: var(--text-muted); flex-shrink: 0;
}

/* 编辑弹窗：禁用的输入框 */
.input-disabled {
  color: var(--text-muted); background: var(--surface-soft);
}

/* 编辑弹窗：修为数值正负色 */
.score-input.score-positive { color: var(--primary); }
.score-input.score-negative { color: var(--danger); }

/* 编辑弹窗：自定义标签 */
.form-tag {
  display: inline-block; padding: 6rpx 20rpx;
  font-size: 22rpx; color: var(--primary);
  background: var(--primary-mist); border-radius: 8rpx;
}

/* 编辑弹窗：删除按钮 */
.modal-delete {
  display: flex; align-items: center; justify-content: center;
  padding: 20rpx 0; margin-top: 16rpx;
  font-size: 28rpx; color: var(--danger);
  border-top: 1rpx solid var(--surface-soft);
}

/* ========== 食物卡片 ========== */
.food-card {
  padding: 24rpx;
  justify-content: flex-start;
  align-items: center;
  min-height: 0;
}

/* ========== 修心卡片 ========== */
.study-card {
  padding: 24rpx;
  justify-content: flex-start;
  align-items: center;
  min-height: 0;
}

/* ========== 食物详情面板 ========== */
.food-detail-header {
  display: flex; align-items: center; flex-wrap: wrap;
  gap: 12rpx; margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--border-color);
}
.food-detail-name {
  font-size: 36rpx; font-weight: 700; color: var(--text-primary);
}
.food-detail-tag {
  font-size: 22rpx; color: var(--primary);
  background: var(--primary-mist); padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
.food-edit-btn {
  font-size: 22rpx; color: var(--primary);
  padding: 4rpx 16rpx; margin-left: auto;
}
.food-delete-btn {
  font-size: 22rpx; color: var(--danger);
  padding: 4rpx 16rpx;
}

/* 分区标题 */
.food-section-title {
  font-size: 24rpx; color: var(--text-secondary);
  margin-bottom: 14rpx; font-weight: 600;
}

/* 营养数值网格 */
.food-nutrition-grid {
  display: flex; flex-wrap: wrap;
  margin-bottom: 24rpx;
}
.food-nut-item {
  width: 50%; padding: 14rpx 0;
  text-align: center;
  border-bottom: 1rpx solid var(--surface-soft);
}
.food-nut-value {
  font-size: 32rpx; font-weight: 700; color: var(--text-primary);
}
.food-nut-label {
  font-size: 22rpx; color: var(--text-muted); margin-top: 4rpx;
}
.food-nut-converted .food-nut-value {
  color: var(--primary);
}

/* 克重输入行 */
.food-weight-row {
  display: flex; align-items: center; gap: 12rpx;
  margin-bottom: 24rpx;
}
.food-weight-input {
  flex: 1; height: 80rpx; padding: 0 20rpx; box-sizing: border-box;
  background: var(--bg-secondary, var(--surface-soft)); border-radius: 14rpx;
  font-size: 32rpx; font-weight: 600; color: var(--primary);
  text-align: center;
}
.food-weight-unit {
  font-size: 28rpx; color: var(--text-secondary); flex-shrink: 0;
}

/* 详情底部按钮 */
.food-detail-actions {
  display: flex; gap: 20rpx; margin-top: 8rpx;
}

/* ========== 修心卡片 ========== */
.study-card {
  padding: 28rpx 16rpx 24rpx;
  justify-content: center;
  min-height: 120rpx;
}
.study-card-name {
  font-size: 28rpx; font-weight: 600;
  color: var(--text-primary, var(--text-primary));
  text-align: center; width: 100%;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  margin-bottom: 6rpx;
}
.study-card-rule {
  font-size: 24rpx; color: var(--text-muted);
  text-align: center; width: 100%;
}

/* 煞·心魔 负面活动卡片浅红底色 */
.study-card.is-negative {
  background: rgba(239, 68, 68, 0.04);
  border-color: rgba(239, 68, 68, 0.12);
}

/* ========== 元卡详情面板 ========== */
.meta-detail-header {
  display: flex; flex-direction: column; align-items: center;
  padding-bottom: 20rpx; border-bottom: 1rpx solid var(--border-color, var(--border-color));
  margin-bottom: 20rpx;
}
.meta-detail-name {
  font-size: 36rpx; font-weight: 700;
  color: var(--text-primary, var(--text-primary));
  margin-bottom: 8rpx;
}
.meta-detail-tag {
  font-size: 22rpx; color: var(--blue);
  background: var(--info-mist); border-radius: 8rpx;
  padding: 4rpx 16rpx;
}
.meta-section-title {
  font-size: 26rpx; font-weight: 600;
  color: var(--text-primary, var(--text-primary));
  margin-bottom: 12rpx; margin-top: 20rpx;
}
.meta-detail-desc {
  font-size: 26rpx; color: var(--text-secondary, var(--text-secondary));
  line-height: 1.6;
}
.meta-muscle-tags {
  display: flex; flex-wrap: wrap; gap: 10rpx;
}
.meta-muscle-item {
  font-size: 22rpx; color: var(--primary);
  background: var(--primary-mist); border-radius: 8rpx;
  padding: 6rpx 16rpx;
}
.meta-movement-list {
  display: flex; flex-wrap: wrap; gap: 10rpx;
}
.meta-movement-item {
  font-size: 24rpx; color: var(--text-secondary, var(--text-secondary));
  background: var(--card-bg, var(--page-bg)); border-radius: 8rpx;
  padding: 8rpx 18rpx;
  border: 1rpx solid var(--border-color, var(--border-color));
}
.meta-detail-actions {
  display: flex; gap: 16rpx; margin-top: 32rpx;
}
.meta-detail-actions .btn-cancel { flex: 1; }
.meta-detail-actions .btn-confirm { flex: 2; }

/* ========== 修心详情面板 ========== */
.study-base-card {
  background: var(--card-bg); border: 1rpx solid var(--border-color);
  border-radius: 14rpx; padding: 24rpx;
  text-align: center; font-size: 28rpx;
  color: var(--text-primary); font-weight: 600;
  margin-bottom: 24rpx;
}

.study-result-card {
  background: linear-gradient(135deg, var(--primary-mist-strong) 0%, var(--primary-mist) 100%);
  border: 1rpx solid var(--primary-mist-strong); border-radius: 14rpx;
  padding: 28rpx; text-align: center;
  margin-bottom: 24rpx;
}
.study-result-label {
  font-size: 24rpx; color: var(--text-secondary); margin-bottom: 8rpx;
}
.study-result-score {
  font-size: 48rpx; font-weight: 700; color: var(--primary);
}

/* ========== 我的自定义筛选开关 ========== */
.filter-my-custom {
  display: flex;
  align-items: center;
  padding: 12rpx 30rpx;
  background: var(--card-bg);
  margin: 10rpx 0;
}
.filter-my-custom-check {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  font-size: 24rpx;
  color: #fff;
}
.filter-my-custom-check.checked {
  background: var(--blue);
  border-color: var(--blue);
}
.filter-my-custom-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.card-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.card-tag.official {
  background: var(--info-mist);
  color: var(--blue);
  border: 1rpx solid var(--info-mist);
}
.card-tag.custom {
  background: var(--warning-mist);
  color: var(--warning);
  border: 1rpx solid var(--warning-mist);
}
.card-tag.public {
  background: var(--info-mist);
  color: var(--blue);
  border: 1rpx solid var(--info-mist);
}
.card-tag.meta {
  background: var(--primary-mist);
  color: var(--success);
  border: 1rpx solid var(--primary-mist-strong);
}
.card-tag.public-lib {
  background: var(--primary-mist-strong);
  color: var(--success);
  border: 1rpx solid var(--primary-mist-strong);
}

.card-btn {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  border: 1rpx solid;
}
.card-btn.copy {
  color: var(--blue);
  border-color: var(--blue);
  background: var(--info-mist);
}
.card-btn.edit {
  color: var(--primary);
  border-color: var(--primary);
  background: var(--primary-mist);
}
.card-btn.use {
  color: var(--primary);
  border-color: var(--primary);
  background: var(--primary-mist);
}
.card-btn.delete {
  color: var(--danger);
  border-color: var(--danger);
  background: var(--danger-mist);
}

/* ========== 活动详情弹窗 ========== */
.detail-backdrop {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 1000;
  display: flex; align-items: flex-end; justify-content: center;
  animation: fadeIn .25s ease;
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

.detail-panel {
  width: 100%; max-width: 600px; max-height: 85vh;
  background: var(--bg-primary, var(--card-bg)); border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 28rpx 40rpx; overflow-y: auto;
  box-sizing: border-box;
  animation: slideUp .3s ease;
}

/* 头部 */
.detail-header {
  display: flex; justify-content: space-between; align-items: flex-start;
  padding-bottom: 16rpx; border-bottom: 1rpx solid var(--border-primary, var(--border-color));
}
.detail-header-main { display: flex; flex-direction: column; gap: 8rpx; flex: 1; }
.detail-name { font-size: 34rpx; font-weight: 700; color: var(--text-primary, var(--text-primary)); }
.detail-category-tag {
  display: inline-block; padding: 2rpx 12rpx; border-radius: 12rpx;
  font-size: 22rpx; color: var(--secondary-color, var(--blue));
  background: rgba(139,92,246,0.1); width: fit-content;
}
.detail-close {
  width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; color: var(--text-secondary, var(--text-secondary));
  border-radius: 50%; background: var(--bg-secondary, var(--surface-soft));
}

/* 核心数值 */
.detail-stats {
  display: flex; gap: 32rpx; padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-primary, var(--border-color));
}
.detail-stat-item { display: flex; flex-direction: column; align-items: center; }
.detail-stat-value { font-size: 40rpx; font-weight: 700; color: var(--primary-color, var(--primary)); }
.detail-stat-value.negative { color: var(--danger); }
.detail-stat-label { font-size: 22rpx; color: var(--text-tertiary, var(--text-muted)); margin-top: 4rpx; }

/* 分区 */
.detail-section { padding: 20rpx 0; border-bottom: 1rpx solid var(--border-primary, var(--border-color)); }
.detail-section-title { font-size: 26rpx; font-weight: 600; color: var(--text-primary, var(--text-primary)); margin-bottom: 12rpx; }
.detail-desc { font-size: 26rpx; color: var(--text-secondary, var(--text-secondary)); line-height: 1.6; }

/* 标签 */
.detail-tags { display: flex; flex-wrap: wrap; gap: 8rpx; }
.detail-tag {
  padding: 4rpx 14rpx; border-radius: 16rpx; font-size: 22rpx;
  color: var(--primary-color, var(--primary)); background: rgba(16,185,129,0.1);
}

/* 自定义属性 */
.detail-ext-list { display: flex; flex-wrap: wrap; gap: 8rpx 16rpx; }
.detail-ext-row { display: flex; align-items: center; gap: 4rpx; }
.detail-ext-key { font-size: 22rpx; color: var(--text-secondary, var(--text-secondary)); }
.detail-ext-sep { font-size: 22rpx; color: var(--text-tertiary, var(--text-muted)); }
.detail-ext-val { font-size: 24rpx; color: var(--text-primary, var(--text-primary)); font-weight: 500; }

/* 元信息 */
.detail-meta {
  display: flex; flex-wrap: wrap; gap: 8rpx; padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-primary, var(--border-color));
}
.detail-meta-badge {
  padding: 4rpx 12rpx; border-radius: 12rpx; font-size: 20rpx;
}
.detail-meta-badge.official { color: var(--warning); background: rgba(217,119,6,0.1); }
.detail-meta-badge.custom { color: var(--secondary-color, var(--blue)); background: rgba(139,92,246,0.1); }
.detail-meta-badge.public { color: var(--blue); background: rgba(59,130,246,0.1); }
.detail-meta-badge.author { color: var(--text-tertiary, var(--text-muted)); background: var(--bg-secondary, var(--surface-soft)); }

/* 操作按钮 */
.detail-actions { display: flex; gap: 16rpx; padding-top: 24rpx; }
.detail-btn {
  flex: 1; padding: 18rpx 0; border-radius: 16rpx;
  font-size: 28rpx; font-weight: 600; text-align: center;
  border: none; line-height: 1.4;
}
.detail-btn::after { border: none; }
.detail-btn.copy { color: #fff; background: var(--primary-color, var(--primary)); }
.detail-btn.edit { color: var(--primary-color, var(--primary)); background: var(--bg-secondary, var(--surface-soft)); }
.detail-btn.delete { color: var(--danger); background: var(--bg-secondary, var(--surface-soft)); }
.detail-btn.reclassify { color: var(--blue); background: var(--info-mist); }

/* 调整分类弹窗 */
.reclassify-modal { max-width: 560rpx; }
.reclassify-header { display: flex; justify-content: space-between; align-items: center;
  padding-bottom: 20rpx; font-size: 30rpx; font-weight: bold; }
.reclassify-body { padding: 8rpx 0; }
.reclassify-meta-list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.reclassify-meta-item {
  width: calc(25% - 9rpx); padding: 16rpx 8rpx; text-align: center;
  border-radius: 12rpx; border: 2rpx solid var(--border-color); background: var(--page-bg);
}
.reclassify-meta-item.active { border-color: var(--blue); background: var(--info-mist); }
.reclassify-meta-name { font-size: 28rpx; font-weight: bold; color: var(--text-primary); display: block; }
.reclassify-meta-sub { font-size: 20rpx; color: var(--text-muted); display: block; margin-top: 4rpx; }
.reclassify-footer { display: flex; gap: 16rpx; margin-top: 24rpx; }

/* ========== 元卡筛选 pill 栏（sport 维度）========== */
.meta-filter-bar { background: var(--card-bg); padding: 0 0 12rpx;
  border-bottom: 1rpx solid var(--border-color, var(--border-color)); }
.meta-pill-scroll { white-space: nowrap; padding: 0 20rpx; }
.meta-pill-sub { padding-top: 8rpx; }
.meta-pill {
  display: inline-block; padding: 8rpx 22rpx; margin-right: 12rpx;
  background: var(--bg-secondary, var(--surface-soft)); color: var(--text-secondary, var(--text-secondary));
  border-radius: 20rpx; font-size: 24rpx;
}
.meta-pill.active { background: var(--blue); color: #fff; }

/* 模板搜索结果 */
.search-template-results { padding: 0 20rpx; margin-bottom: 12rpx; }
.search-template-title { font-size: 24rpx; color: var(--text-muted); padding: 8rpx 0; display: block; }
.template-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 20rpx; background: var(--page-bg); border-radius: 12rpx; margin-bottom: 8rpx;
}
.template-name { font-size: 26rpx; color: var(--text-primary); }
.template-meta {
  font-size: 22rpx; color: var(--blue); background: var(--info-mist);
  padding: 4rpx 14rpx; border-radius: 10rpx;
}
