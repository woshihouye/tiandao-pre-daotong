/* 大道之行 · 活动库 — 双层筛选宫格版 */

/* 页面全高 flex 布局 */
page { height: 100%; }
.page-body { display: flex; flex-direction: column; min-height: 100vh; }

/* ========== 顶部 Hero ========== */
.section-hero {
  margin: 24rpx;
  padding: 32rpx 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #fdf6ec 0%, #fef9f2 100%);
  border: 1rpx solid #f0e4cc;
}
.hero-kicker { font-size: 24rpx; color: #b8956a; margin-bottom: 8rpx; letter-spacing: 2rpx; }
.hero-title { font-size: 36rpx; font-weight: 700; color: #5c4033; margin-bottom: 10rpx; }
.hero-desc { font-size: 26rpx; color: #8b7355; line-height: 1.6; }

/* ========== 主分类 Tab 胶囊 ========== */
.tab-scroll { padding: 0 24rpx; margin-bottom: 10rpx; }
.tab-scroll-inner { display: flex; white-space: nowrap; }
.tab-chip {
  display: inline-flex; align-items: center; padding: 12rpx 24rpx;
  margin-right: 14rpx; border-radius: 40rpx;
  background: var(--bg-secondary, #f3f4f6);
  font-size: 26rpx; color: var(--text-secondary, #6b7280);
  transition: all 0.2s;
}
.tab-chip.active { background: var(--primary-color, #10B981); color: #fff; }
.tab-chip-icon { margin-right: 6rpx; font-weight: 600; }
.tab-chip-text { font-weight: 500; }

/* ========== 搜索框 ========== */
.search-bar { padding: 0 24rpx; margin-bottom: 6rpx; }
.search-box { display: flex; align-items: center; background: var(--bg-secondary, #f3f4f6); border-radius: 40rpx; padding: 12rpx 24rpx; }
.search-icon { font-size: 28rpx; margin-right: 12rpx; }
.search-input { flex: 1; font-size: 26rpx; color: var(--text-primary, #1f2937); }
.search-clear { font-size: 28rpx; color: var(--text-tertiary, #9ca3af); padding: 4rpx 10rpx; }

/* ========== 筛选 + 内容外框 ========== */
.filter-content-wrap { flex: 1; display: flex; flex-direction: column; }

/* ========== 左右分栏 ========== */
.split-layout { flex: 1; display: flex; padding: 0 24rpx; }

/* ---- 左侧侧边栏 ---- */
.side-bar {
  width: 150rpx; flex-shrink: 0;
  background: var(--bg-secondary, #f8f8f8); border-radius: 16rpx;
  margin-right: 16rpx; padding: 8rpx 0;
}
.side-item {
  padding: 18rpx 12rpx; text-align: center; font-size: 24rpx;
  color: var(--text-secondary, #6b7280); border-radius: 10rpx;
  margin: 4rpx 8rpx; transition: all 0.2s;
}
.side-item.active { background: var(--primary-color, #10B981); color: #fff; font-weight: 600; }

/* 标签筛选行 */
.tag-filter-row {
  width: 100%; white-space: nowrap; padding: 4rpx 0 12rpx 0;
  display: flex; gap: 10rpx; flex-shrink: 0;
}
.tag-filter-item {
  display: inline-flex; align-items: center; flex-shrink: 0;
  padding: 6rpx 16rpx; border-radius: 20rpx;
  font-size: 22rpx; color: var(--text-secondary, #6b7280);
  background: var(--bg-secondary, #f3f4f6); border: 1rpx solid transparent;
}
.tag-filter-item.active {
  color: #fff; background: var(--primary-color, #10B981); border-color: transparent;
}
.tag-count { font-size: 18rpx; margin-left: 4rpx; opacity: 0.7; }

/* ---- 右侧宫格区 ---- */
.grid-area { flex: 1; }
.grid-container {
  display: flex; flex-wrap: wrap; align-content: flex-start;
  padding: 4rpx 0;
}

/* ---- 宫格卡片 ---- */
.grid-card {
  width: calc((100% - 16rpx) / 2); margin: 0 16rpx 16rpx 0;
  padding: 20rpx 16rpx 16rpx; border-radius: 16rpx;
  position: relative; box-sizing: border-box; overflow: hidden;
  background: var(--card-bg, #fff);
  border: 1rpx solid var(--border-color, #eee);
  display: flex; flex-direction: column; align-items: center;
}
.grid-card:nth-child(2n) { margin-right: 0; }

/* 置顶 */
.card-pin {
  position: absolute; right: 10rpx; top: 8rpx; z-index: 2;
  font-size: 32rpx; color: var(--text-tertiary, #d1d5db);
  padding: 4rpx; line-height: 1;
}
.card-pin.pinned { color: #f59e0b; }

/* 图标区 */
.card-icon-wrap {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  background: linear-gradient(135deg, #e8f5e9 0%, #f0fdf4 100%);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 12rpx;
}
.is-negative .card-icon-wrap { background: linear-gradient(135deg, #fef2f2 0%, #fff5f5 100%); }
.card-icon { font-size: 36rpx; font-weight: 700; color: var(--primary-color, #10B981); }
.is-negative .card-icon { color: var(--danger-text, #ef4444); }

/* 活动名 */
.card-name {
  font-size: 26rpx; font-weight: 600; color: var(--text-primary, #1f2937);
  text-align: center; width: 100%;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  margin-bottom: 8rpx;
}

/* 修为结算 */
.card-score { font-size: 22rpx; font-weight: 600; white-space: nowrap; }
.score-positive { color: var(--primary-color, #10B981); }
.score-negative { color: var(--danger-text, #ef4444); }

/* 元卡描述 */
.card-meta-desc {
  font-size: 22rpx; color: var(--text-secondary, #6b7280);
  text-align: center; width: 100%; line-height: 1.4;
  overflow: hidden; text-overflow: ellipsis;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;
  margin-bottom: 4rpx;
}
.card-meta-muscles {
  font-size: 20rpx; color: #6b7280;
  text-align: center; width: 100%;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  background: #f0fdf4; border-radius: 6rpx;
  padding: 4rpx 10rpx; margin-bottom: 6rpx;
}

/* ext 属性行 */
.card-ext-row {
  display: flex; flex-wrap: wrap; gap: 4rpx;
  margin-top: 4rpx; justify-content: center; width: 100%;
}
.card-ext-item {
  font-size: 18rpx; color: var(--text-tertiary, #9ca3af);
  background: var(--bg-secondary, #f3f4f6);
  padding: 2rpx 8rpx; border-radius: 6rpx;
  max-width: 120rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* 负面活动淡灰底色 */
.grid-card.is-negative { background: rgba(239, 68, 68, 0.03); border-color: rgba(239, 68, 68, 0.1); }

/* 空状态 */
.empty-tip { width: 100%; text-align: center; padding: 60rpx 24rpx; }
.empty-text { font-size: 28rpx; color: var(--text-secondary, #6b7280); }
.empty-sub { font-size: 24rpx; color: var(--text-tertiary, #9ca3af); margin-top: 8rpx; }

/* 自定义活动角标 */
.card-custom-tag {
  position: absolute; left: 6rpx; top: 6rpx; z-index: 2;
  font-size: 18rpx; color: #fff; background: var(--primary-color, #10B981);
  padding: 2rpx 10rpx; border-radius: 6rpx; line-height: 1.4;
}

.card-public-tag {
  position: absolute; right: 6rpx; top: 6rpx; z-index: 2;
  font-size: 18rpx; color: #fff; background: #3B82F6;
  padding: 2rpx 10rpx; border-radius: 6rpx; line-height: 1.4;
}

.card-owner-name {
  font-size: 18rpx; color: var(--text-tertiary, #9CA3AF);
  text-align: center; margin-top: 2rpx; overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap;
}

/* 分组头 */
.group-header {
  display: flex; align-items: center; justify-content: space-between;
  width: 100%; padding: 16rpx 8rpx 8rpx 8rpx;
}
.group-name { font-size: 26rpx; font-weight: 700; color: var(--text-primary, #1f2937); }
.group-count { font-size: 22rpx; color: var(--text-tertiary, #9ca3af); }

/* ========== 弹窗遮罩 ========== */
.modal-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45); z-index: 200;
  display: flex; align-items: flex-end;
  opacity: 0; pointer-events: none; transition: opacity 0.25s;
}
.modal-overlay.show { opacity: 1; pointer-events: auto; }

/* 弹窗面板 */
.modal-sheet {
  width: 100%; max-height: 80vh; overflow-y: auto;
  background: #fffdf7; border-radius: 28rpx 28rpx 0 0;
  padding: 36rpx 32rpx 48rpx; box-sizing: border-box;
  animation: slideUp 0.3s ease;
}
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }

.modal-title {
  font-size: 34rpx; font-weight: 700; color: #5c4033;
  text-align: center; margin-bottom: 32rpx;
}

/* 表单 */
.form-group { margin-bottom: 24rpx; }
.form-label {
  font-size: 26rpx; color: var(--text-secondary, #6b7280);
  margin-bottom: 10rpx; display: block;
}
.form-required { color: #ef4444; }
.form-input {
  width: 100%; height: 80rpx; padding: 0 20rpx; box-sizing: border-box;
  background: var(--bg-secondary, #f3f4f6); border-radius: 14rpx;
  font-size: 28rpx; color: var(--text-primary, #1f2937);
}
.form-textarea {
  width: 100%; min-height: 100rpx; padding: 16rpx 20rpx; box-sizing: border-box;
  background: var(--bg-secondary, #f3f4f6); border-radius: 14rpx;
  font-size: 28rpx; color: var(--text-primary, #1f2937);
}
.form-picker {
  width: 100%; height: 80rpx; padding: 0 20rpx; box-sizing: border-box;
  background: var(--bg-secondary, #f3f4f6); border-radius: 14rpx;
  font-size: 28rpx; color: var(--text-primary, #1f2937);
  display: flex; align-items: center;
}

/* 弹窗底部按钮 */
.modal-actions {
  display: flex; gap: 20rpx; margin-top: 32rpx;
}
.btn-cancel {
  flex: 1; height: 88rpx; border-radius: 16rpx;
  background: var(--bg-secondary, #f3f4f6);
  color: var(--text-secondary, #6b7280); font-size: 30rpx;
  display: flex; align-items: center; justify-content: center;
}
.btn-confirm {
  flex: 1; height: 88rpx; border-radius: 16rpx;
  background: var(--primary-color, #10B981);
  color: #fff; font-size: 30rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
}

/* 编辑弹窗：修行容量行 */
.form-group-row {
  display: flex; align-items: center; gap: 12rpx;
}
.group-input {
  flex: 1;
}
.group-unit {
  font-size: 28rpx; color: #9ca3af; flex-shrink: 0;
}

/* 编辑弹窗：禁用的输入框 */
.input-disabled {
  color: #9ca3af; background: #f5f5f5;
}

/* 编辑弹窗：修为数值正负色 */
.score-input.score-positive { color: #10B981; }
.score-input.score-negative { color: #ef4444; }

/* 编辑弹窗：自定义标签 */
.form-tag {
  display: inline-block; padding: 6rpx 20rpx;
  font-size: 22rpx; color: #10B981;
  background: #ecfdf5; border-radius: 8rpx;
}

/* 编辑弹窗：删除按钮 */
.modal-delete {
  display: flex; align-items: center; justify-content: center;
  padding: 20rpx 0; margin-top: 16rpx;
  font-size: 28rpx; color: #ef4444;
  border-top: 1rpx solid #f3f4f6;
}

/* ========== 食物卡片 ========== */
.food-card {
  padding: 28rpx 16rpx 24rpx;
  justify-content: center;
  min-height: 120rpx;
}
.food-card-name {
  font-size: 28rpx; font-weight: 600;
  color: var(--text-primary, #1f2937);
  text-align: center; width: 100%;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  margin-bottom: 6rpx;
}
.food-card-calories {
  font-size: 22rpx; color: #9ca3af;
  text-align: center; width: 100%;
}

/* ========== 食物详情面板 ========== */
.food-detail-header {
  display: flex; align-items: center; flex-wrap: wrap;
  gap: 12rpx; margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0e4cc;
}
.food-detail-name {
  font-size: 36rpx; font-weight: 700; color: #5c4033;
}
.food-detail-tag {
  font-size: 22rpx; color: #10B981;
  background: #ecfdf5; padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
.food-edit-btn {
  font-size: 22rpx; color: #10B981;
  padding: 4rpx 16rpx; margin-left: auto;
}
.food-delete-btn {
  font-size: 22rpx; color: #ef4444;
  padding: 4rpx 16rpx;
}

/* 分区标题 */
.food-section-title {
  font-size: 24rpx; color: #8b7355;
  margin-bottom: 14rpx; font-weight: 600;
}

/* 营养数值网格 */
.food-nutrition-grid {
  display: flex; flex-wrap: wrap;
  margin-bottom: 24rpx;
}
.food-nut-item {
  width: 50%; padding: 14rpx 0;
  text-align: center;
  border-bottom: 1rpx solid #f3f4f6;
}
.food-nut-value {
  font-size: 32rpx; font-weight: 700; color: #5c4033;
}
.food-nut-label {
  font-size: 22rpx; color: #9ca3af; margin-top: 4rpx;
}
.food-nut-converted .food-nut-value {
  color: #10B981;
}

/* 克重输入行 */
.food-weight-row {
  display: flex; align-items: center; gap: 12rpx;
  margin-bottom: 24rpx;
}
.food-weight-input {
  flex: 1; height: 80rpx; padding: 0 20rpx; box-sizing: border-box;
  background: var(--bg-secondary, #f3f4f6); border-radius: 14rpx;
  font-size: 32rpx; font-weight: 600; color: #10B981;
  text-align: center;
}
.food-weight-unit {
  font-size: 28rpx; color: #8b7355; flex-shrink: 0;
}

/* 详情底部按钮 */
.food-detail-actions {
  display: flex; gap: 20rpx; margin-top: 8rpx;
}

/* ========== 修心卡片 ========== */
.study-card {
  padding: 28rpx 16rpx 24rpx;
  justify-content: center;
  min-height: 120rpx;
}
.study-card-name {
  font-size: 28rpx; font-weight: 600;
  color: var(--text-primary, #1f2937);
  text-align: center; width: 100%;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  margin-bottom: 6rpx;
}
.study-card-rule {
  font-size: 24rpx; color: #999999;
  text-align: center; width: 100%;
}

/* 煞·心魔 负面活动卡片浅红底色 */
.study-card.is-negative {
  background: rgba(239, 68, 68, 0.04);
  border-color: rgba(239, 68, 68, 0.12);
}

/* ========== 元卡详情面板 ========== */
.meta-detail-header {
  display: flex; flex-direction: column; align-items: center;
  padding-bottom: 20rpx; border-bottom: 1rpx solid var(--border-color, #e5e7eb);
  margin-bottom: 20rpx;
}
.meta-detail-name {
  font-size: 36rpx; font-weight: 700;
  color: var(--text-primary, #1f2937);
  margin-bottom: 8rpx;
}
.meta-detail-tag {
  font-size: 22rpx; color: #3B82F6;
  background: #eff6ff; border-radius: 8rpx;
  padding: 4rpx 16rpx;
}
.meta-section-title {
  font-size: 26rpx; font-weight: 600;
  color: var(--text-primary, #1f2937);
  margin-bottom: 12rpx; margin-top: 20rpx;
}
.meta-detail-desc {
  font-size: 26rpx; color: var(--text-secondary, #6b7280);
  line-height: 1.6;
}
.meta-muscle-tags {
  display: flex; flex-wrap: wrap; gap: 10rpx;
}
.meta-muscle-item {
  font-size: 22rpx; color: #059669;
  background: #ecfdf5; border-radius: 8rpx;
  padding: 6rpx 16rpx;
}
.meta-movement-list {
  display: flex; flex-wrap: wrap; gap: 10rpx;
}
.meta-movement-item {
  font-size: 24rpx; color: var(--text-secondary, #6b7280);
  background: var(--card-bg, #f9fafb); border-radius: 8rpx;
  padding: 8rpx 18rpx;
  border: 1rpx solid var(--border-color, #e5e7eb);
}
.meta-detail-actions {
  display: flex; gap: 16rpx; margin-top: 32rpx;
}
.meta-detail-actions .btn-cancel { flex: 1; }
.meta-detail-actions .btn-confirm { flex: 2; }

/* ========== 修心详情面板 ========== */
.study-base-card {
  background: #fef9f2; border: 1rpx solid #f0e4cc;
  border-radius: 14rpx; padding: 24rpx;
  text-align: center; font-size: 28rpx;
  color: #5c4033; font-weight: 600;
  margin-bottom: 24rpx;
}

.study-result-card {
  background: linear-gradient(135deg, #ecfdf5 0%, #f0fdf4 100%);
  border: 1rpx solid #a7f3d0; border-radius: 14rpx;
  padding: 28rpx; text-align: center;
  margin-bottom: 24rpx;
}
.study-result-label {
  font-size: 24rpx; color: #6b7280; margin-bottom: 8rpx;
}
.study-result-score {
  font-size: 48rpx; font-weight: 700; color: #10B981;
}

/* ========== 我的自定义筛选开关 ========== */
.filter-my-custom {
  display: flex;
  align-items: center;
  padding: 12rpx 30rpx;
  background: #fff;
  margin: 10rpx 0;
}
.filter-my-custom-check {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ccc;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  font-size: 24rpx;
  color: #fff;
}
.filter-my-custom-check.checked {
  background: #3B82F6;
  border-color: #3B82F6;
}
.filter-my-custom-label {
  font-size: 26rpx;
  color: #666;
}

/* ========== 卡片标签 ========== */
.card-tags {
  display: flex;
  gap: 8rpx;
  margin-top: 6rpx;
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  z-index: 2;
  flex-wrap: wrap;
}
.card-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.card-tag.official {
  background: #EBF5FF;
  color: #3B82F6;
  border: 1rpx solid #BFDBFE;
}
.card-tag.custom {
  background: #FEF3C7;
  color: #D97706;
  border: 1rpx solid #FDE68A;
}
.card-tag.public {
  background: #F3E8FF;
  color: #7E22CE;
  border: 1rpx solid #E9D5FF;
}

/* ========== 卡片操作按钮 ========== */
.card-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  padding: 10rpx 20rpx 14rpx;
  border-top: 1rpx solid #f0f0f0;
  width: 100%;
  box-sizing: border-box;
}
.card-btn {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  border: 1rpx solid;
}
.card-btn.copy {
  color: #3B82F6;
  border-color: #3B82F6;
  background: #EBF5FF;
}
.card-btn.edit {
  color: #059669;
  border-color: #059669;
  background: #ECFDF5;
}
.card-btn.use {
  color: #10B981;
  border-color: #10B981;
  background: #ECFDF5;
}
.card-btn.delete {
  color: #EF4444;
  border-color: #EF4444;
  background: #FEF2F2;
}

/* ========== 活动详情弹窗 ========== */
.detail-backdrop {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 1000;
  display: flex; align-items: flex-end; justify-content: center;
  animation: fadeIn .25s ease;
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

.detail-panel {
  width: 100%; max-width: 600px; max-height: 85vh;
  background: var(--bg-primary, #fff); border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 28rpx 40rpx; overflow-y: auto;
  box-sizing: border-box;
  animation: slideUp .3s ease;
}

/* 头部 */
.detail-header {
  display: flex; justify-content: space-between; align-items: flex-start;
  padding-bottom: 16rpx; border-bottom: 1rpx solid var(--border-primary, #e5e7eb);
}
.detail-header-main { display: flex; flex-direction: column; gap: 8rpx; flex: 1; }
.detail-name { font-size: 34rpx; font-weight: 700; color: var(--text-primary, #1f2937); }
.detail-category-tag {
  display: inline-block; padding: 2rpx 12rpx; border-radius: 12rpx;
  font-size: 22rpx; color: var(--secondary-color, #8B5CF6);
  background: rgba(139,92,246,0.1); width: fit-content;
}
.detail-close {
  width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; color: var(--text-secondary, #6b7280);
  border-radius: 50%; background: var(--bg-secondary, #f3f4f6);
}

/* 核心数值 */
.detail-stats {
  display: flex; gap: 32rpx; padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-primary, #e5e7eb);
}
.detail-stat-item { display: flex; flex-direction: column; align-items: center; }
.detail-stat-value { font-size: 40rpx; font-weight: 700; color: var(--primary-color, #10B981); }
.detail-stat-value.negative { color: #EF4444; }
.detail-stat-label { font-size: 22rpx; color: var(--text-tertiary, #9ca3af); margin-top: 4rpx; }

/* 分区 */
.detail-section { padding: 20rpx 0; border-bottom: 1rpx solid var(--border-primary, #e5e7eb); }
.detail-section-title { font-size: 26rpx; font-weight: 600; color: var(--text-primary, #1f2937); margin-bottom: 12rpx; }
.detail-desc { font-size: 26rpx; color: var(--text-secondary, #6b7280); line-height: 1.6; }

/* 标签 */
.detail-tags { display: flex; flex-wrap: wrap; gap: 8rpx; }
.detail-tag {
  padding: 4rpx 14rpx; border-radius: 16rpx; font-size: 22rpx;
  color: var(--primary-color, #10B981); background: rgba(16,185,129,0.1);
}

/* 自定义属性 */
.detail-ext-list { display: flex; flex-wrap: wrap; gap: 8rpx 16rpx; }
.detail-ext-row { display: flex; align-items: center; gap: 4rpx; }
.detail-ext-key { font-size: 22rpx; color: var(--text-secondary, #6b7280); }
.detail-ext-sep { font-size: 22rpx; color: var(--text-tertiary, #9ca3af); }
.detail-ext-val { font-size: 24rpx; color: var(--text-primary, #1f2937); font-weight: 500; }

/* 元信息 */
.detail-meta {
  display: flex; flex-wrap: wrap; gap: 8rpx; padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-primary, #e5e7eb);
}
.detail-meta-badge {
  padding: 4rpx 12rpx; border-radius: 12rpx; font-size: 20rpx;
}
.detail-meta-badge.official { color: #D97706; background: rgba(217,119,6,0.1); }
.detail-meta-badge.custom { color: var(--secondary-color, #8B5CF6); background: rgba(139,92,246,0.1); }
.detail-meta-badge.public { color: #3B82F6; background: rgba(59,130,246,0.1); }
.detail-meta-badge.author { color: var(--text-tertiary, #9ca3af); background: var(--bg-secondary, #f3f4f6); }

/* 操作按钮 */
.detail-actions { display: flex; gap: 16rpx; padding-top: 24rpx; }
.detail-btn {
  flex: 1; padding: 18rpx 0; border-radius: 16rpx;
  font-size: 28rpx; font-weight: 600; text-align: center;
  border: none; line-height: 1.4;
}
.detail-btn::after { border: none; }
.detail-btn.copy { color: #fff; background: var(--primary-color, #10B981); }
.detail-btn.edit { color: var(--primary-color, #10B981); background: var(--bg-secondary, #f3f4f6); }
.detail-btn.delete { color: #EF4444; background: var(--bg-secondary, #f3f4f6); }
.detail-btn.reclassify { color: #8B5CF6; background: #F5F3FF; }

/* 调整分类弹窗 */
.reclassify-modal { max-width: 560rpx; }
.reclassify-header { display: flex; justify-content: space-between; align-items: center;
  padding-bottom: 20rpx; font-size: 30rpx; font-weight: bold; }
.reclassify-body { padding: 8rpx 0; }
.reclassify-meta-list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.reclassify-meta-item {
  width: calc(25% - 9rpx); padding: 16rpx 8rpx; text-align: center;
  border-radius: 12rpx; border: 2rpx solid #e5e7eb; background: #f9fafb;
}
.reclassify-meta-item.active { border-color: #8B5CF6; background: #F5F3FF; }
.reclassify-meta-name { font-size: 28rpx; font-weight: bold; color: #333; display: block; }
.reclassify-meta-sub { font-size: 20rpx; color: #999; display: block; margin-top: 4rpx; }
.reclassify-footer { display: flex; gap: 16rpx; margin-top: 24rpx; }

/* ========== 元卡筛选 pill 栏（sport 维度）========== */
.meta-filter-bar { background: #fff; padding: 0 0 12rpx;
  border-bottom: 1rpx solid var(--border-color, #f0f0f0); }
.meta-pill-scroll { white-space: nowrap; padding: 0 20rpx; }
.meta-pill-sub { padding-top: 8rpx; }
.meta-pill {
  display: inline-block; padding: 8rpx 22rpx; margin-right: 12rpx;
  background: var(--bg-secondary, #f3f4f6); color: var(--text-secondary, #666);
  border-radius: 20rpx; font-size: 24rpx;
}
.meta-pill.active { background: #3B82F6; color: #fff; }

/* 模板搜索结果 */
.search-template-results { padding: 0 20rpx; margin-bottom: 12rpx; }
.search-template-title { font-size: 24rpx; color: #999; padding: 8rpx 0; display: block; }
.template-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 20rpx; background: #f9fafb; border-radius: 12rpx; margin-bottom: 8rpx;
}
.template-name { font-size: 26rpx; color: #333; }
.template-meta {
  font-size: 22rpx; color: #3B82F6; background: #EBF5FF;
  padding: 4rpx 14rpx; border-radius: 10rpx;
}
