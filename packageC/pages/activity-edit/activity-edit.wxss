.page {
  min-height: 100vh;
  background: var(--surface-soft);
  padding-bottom: 120rpx;
}
/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: var(--card-bg);
  border-bottom: 1rpx solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 10;
}
.nav-back { padding: 10rpx; }
.nav-back-icon { font-size: 36rpx; color: var(--text-primary); }
.nav-title { font-size: 34rpx; font-weight: bold; color: var(--text-primary); }
.nav-save-text { font-size: 30rpx; color: var(--blue); padding: 10rpx; }

/* 提示条 */
.tip-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: var(--info-mist);
  border-bottom: 1rpx solid var(--info-mist);
}
.tip-icon { font-size: 28rpx; margin-right: 12rpx; }
.tip-text { font-size: 26rpx; color: var(--blue); flex: 1; }

/* 表单 */
.form {
  margin-top: 20rpx;
  background: var(--card-bg);
}
.form-item {
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border-color);
}
.form-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  display: block;
}
.form-input {
  width: 100%;
  height: 80rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  border: 1rpx solid var(--border-color);
  border-radius: 12rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}
.form-textarea {
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  border: 1rpx solid var(--border-color);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}
.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 12rpx;
  font-size: 30rpx;
  color: var(--text-primary);
}
.picker-arrow { color: var(--text-muted); }
.form-hint {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 10rpx;
  display: block;
}

/* 发布到公共库开关 */
.publish-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border-color);
  background: var(--card-bg);
}
.publish-switch-label {
  display: flex;
  flex-direction: column;
}
.publish-switch-title {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
}
.publish-switch-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx 40rpx;
  background: var(--card-bg);
  border-top: 1rpx solid var(--border-color);
}
.btn-save {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--blue);
  color: #fff;
  font-size: 32rpx;
  border-radius: 16rpx;
  text-align: center;
}

/* ═══════════════════════════════════════════════════════════════ */
/*  元卡区域                                                       */
/* ═══════════════════════════════════════════════════════════════ */
.meta-card-section {
  background: var(--card-bg);
  margin-top: 20rpx;
  padding: 20rpx 30rpx;
}

/* 元卡切换栏 */
.meta-card-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.meta-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-right: 20rpx;
  flex-shrink: 0;
}
.meta-card-scroll {
  flex: 1;
  white-space: nowrap;
}
.meta-card-chip {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  background: var(--surface-soft);
  color: var(--text-secondary);
  border-radius: 20rpx;
  font-size: 26rpx;
}
.meta-card-chip.active {
  background: var(--blue);
  color: #fff;
}

/* 章节标题 */
.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-primary);
  padding: 24rpx 0 16rpx;
  display: flex;
  align-items: baseline;
}
.section-desc {
  font-size: 22rpx;
  color: var(--text-muted);
  font-weight: normal;
  margin-left: 12rpx;
}
.section-tip {
  font-size: 20rpx;
  color: var(--text-muted);
  font-weight: normal;
  margin-left: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 肌群列表 */
.muscle-list {
  margin-bottom: 16rpx;
}
.muscle-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}
.muscle-name {
  width: 140rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}
.muscle-slider {
  flex: 1;
  margin: 0 16rpx;
}
.muscle-pct {
  width: 60rpx;
  font-size: 24rpx;
  color: var(--blue);
  text-align: right;
}
.toggle-secondary {
  padding: 8rpx 0;
  text-align: center;
}
.toggle-secondary text {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 模板匹配 */
.template-match {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: var(--primary-mist);
  border-radius: 12rpx;
  margin: 16rpx 0;
}
.match-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}
.match-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--primary);
}
.match-reset {
  font-size: 24rpx;
  color: var(--danger);
  padding: 4rpx 12rpx;
}

/* 容量格子表头 */
.cell-header {
  display: flex;
  align-items: center;
  padding: 12rpx 0 8rpx;
  border-bottom: 2rpx solid var(--border-color);
  margin-bottom: 4rpx;
}
.cell-hd-type {
  font-size: 22rpx; font-weight: 600; color: var(--text-muted);
  flex-shrink: 0; padding: 0 16rpx;
}
.cell-hd-value {
  width: 80rpx; text-align: center;
  font-size: 22rpx; font-weight: 600; color: var(--text-muted);
  margin-left: 8rpx;
}
.cell-hd-unit {
  width: 70rpx; text-align: center;
  font-size: 22rpx; font-weight: 600; color: var(--text-muted);
  margin-left: 8rpx;
}
.cell-hd-weight {
  width: 80rpx; text-align: center;
  font-size: 22rpx; font-weight: 600; color: var(--text-muted);
  margin-left: 8rpx;
}
.cell-hd-del {
  width: 40rpx; margin-left: 4rpx;
}

/* 容量格子 */
.cell-list {
  margin-bottom: 16rpx;
}
.cell-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}
.cell-type-picker {
  flex-shrink: 0;
}
.cell-type {
  font-size: 24rpx;
  color: var(--blue);
  background: var(--info-mist);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}
.cell-value {
  width: 80rpx;
  height: 56rpx;
  text-align: center;
  font-size: 24rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 8rpx;
  margin-left: 8rpx;
}
.cell-unit {
  width: 70rpx;
  height: 56rpx;
  text-align: center;
  font-size: 22rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 8rpx;
  margin-left: 8rpx;
}
.cell-weight-wrap {
  display: flex;
  align-items: center;
  margin-left: 8rpx;
}
.cell-weight {
  width: 64rpx;
  height: 56rpx;
  text-align: center;
  font-size: 22rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 8rpx 0 0 8rpx;
  border-right: none;
}
.cell-weight-suffix {
  width: 32rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: var(--text-muted);
  background: var(--surface-soft);
  border: 1rpx solid var(--border-color);
  border-radius: 0 8rpx 8rpx 0;
  border-left: none;
}
.cell-remove {
  font-size: 28rpx;
  color: var(--danger);
  padding: 8rpx;
  margin-left: 4rpx;
}
.add-cell-btn {
  text-align: center;
  padding: 16rpx 0;
}
.add-cell-btn text {
  font-size: 26rpx;
  color: var(--blue);
}

/* 额外参数 */
.extra-params {
  margin-top: 16rpx;
}
.param-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed var(--border-color);
}
.param-name {
  font-size: 26rpx;
  color: var(--text-secondary);
}
/* 选择型参数（diet 日常卡 picker） */
.select-param-list {
  margin-top: 8rpx;
}
.select-param-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 16rpx;
  background: var(--page-bg);
  border-radius: 8rpx;
  margin-bottom: 8rpx;
}
.select-param-name {
  font-size: 26rpx;
  color: var(--text-secondary);
}
.select-param-val {
  font-size: 26rpx;
  color: var(--blue);
  padding: 6rpx 12rpx;
  background: var(--info-mist);
  border-radius: 6rpx;
}

/* 封面上传 */
.cover-area {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--surface-soft);
}
.cover-preview {
  width: 100%;
  height: 100%;
}
.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.cover-placeholder-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}
.cover-placeholder-text {
  font-size: 22rpx;
  color: var(--text-muted);
}
