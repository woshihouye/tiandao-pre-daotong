.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}
/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}
.nav-back { padding: 10rpx; }
.nav-back-icon { font-size: 36rpx; color: #333; }
.nav-title { font-size: 34rpx; font-weight: bold; color: #333; }
.nav-save-text { font-size: 30rpx; color: #3B82F6; padding: 10rpx; }

/* 提示条 */
.tip-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #EBF5FF;
  border-bottom: 1rpx solid #DBEAFE;
}
.tip-icon { font-size: 28rpx; margin-right: 12rpx; }
.tip-text { font-size: 26rpx; color: #3B82F6; flex: 1; }

/* 表单 */
.form {
  margin-top: 20rpx;
  background: #fff;
}
.form-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}
.form-input {
  width: 100%;
  height: 80rpx;
  font-size: 30rpx;
  color: #333;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}
.form-textarea {
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
  color: #333;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}
.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #333;
}
.picker-arrow { color: #999; }
.form-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx 40rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}
.btn-save {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #3B82F6;
  color: #fff;
  font-size: 32rpx;
  border-radius: 16rpx;
  text-align: center;
}
