<!-- 编辑自定义活动 -->
<view class="page {{themeClass}}">
  <!-- 顶部导航 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="onCancel">
      <text class="nav-back-icon">←</text>
    </view>
    <text class="nav-title">{{mode === 'metaCard' ? '元卡创建' : (isNew ? '复制活动' : '编辑活动')}}</text>
    <view class="nav-action" bindtap="onSave">
      <text class="nav-save-text">{{saving ? '保存中...' : '保存'}}</text>
    </view>
  </view>

  <!-- 提示 -->
  <view class="tip-bar" wx:if="{{mode !== 'metaCard' && isNew && originActivityName}}">
    <text class="tip-icon">💡</text>
    <text class="tip-text">正在复制「{{originActivityName}}」，你可以修改以下内容</text>
  </view>

  <!-- 表单 -->
  <view class="form">
    <!-- 活动名称 -->
    <view class="form-item">
      <text class="form-label">活动名称</text>
      <input class="form-input" placeholder="请输入活动名称（最多20字）" value="{{name}}" bindinput="onNameInput" bindblur="onNameBlur" maxlength="20" />
    </view>

    <!-- 分类（元卡模式下隐藏） -->
    <view class="form-item" wx:if="{{mode !== 'metaCard'}}">
      <text class="form-label">分类</text>
      <picker mode="selector" range="{{categories}}" range-key="label" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="form-picker">
          <text>{{categories[categoryIndex].label}}</text>
          <text class="picker-arrow">▾</text>
        </view>
      </picker>
    </view>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  元卡模式 UI 区块                                               -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <view class="meta-card-section" wx:if="{{mode === 'metaCard'}}">
      <!-- 元卡切换 -->
      <view class="meta-card-bar">
        <text class="meta-label">元卡类型</text>
        <scroll-view scroll-x class="meta-card-scroll">
          <view 
            class="meta-card-chip {{selectedMetaCard === item.id ? 'active' : ''}}" 
            wx:for="{{metaCardList}}" 
            wx:key="id" 
            data-key="{{item.id}}" 
            bindtap="onChangeMetaCard"
          >{{item.name}}</view>
        </scroll-view>
      </view>

      <!-- 肌群参与度 -->
      <view class="section-title">
        <text>肌群参与度</text>
        <text class="section-desc">拖拽调节，自动归一化</text>
      </view>
      <view class="muscle-list">
        <view class="muscle-row" wx:for="{{muscleWeights}}" wx:key="id" wx:if="{{item.group === 'primary' || showSecondaryMuscles}}">
          <text class="muscle-name">{{item.name}}</text>
          <slider 
            class="muscle-slider" 
            min="0" max="100" 
            value="{{item.weight * 100}}" 
            data-index="{{index}}" 
            bindchanging="onMuscleSliderChange" 
            activeColor="{{item.group === 'primary' ? '#3B82F6' : '#9CA3AF'}}" 
            backgroundColor="#E5E7EB" 
            block-size="18" 
          />
          <text class="muscle-pct">{{Math.round(item.weight * 100)}}%</text>
        </view>
      </view>
      <view class="toggle-secondary" bindtap="toggleSecondaryMuscles">
        <text>{{showSecondaryMuscles ? '收起' : '展开'}}辅助肌群 ▸</text>
      </view>

      <!-- 模板匹配提示 -->
      <view class="template-match" wx:if="{{matchedTemplate}}">
        <text class="match-icon">OK</text>
        <text class="match-text">已匹配动作模板，肌群权重已推荐</text>
        <text class="match-reset" bindtap="resetToDefault">重置默认</text>
      </view>

      <!-- 容量格子 -->
      <view class="section-title">容量格子</view>
      <view class="cell-list">
        <view class="cell-row" wx:for="{{cells}}" wx:key="id">
          <picker 
            class="cell-type-picker" 
            mode="selector" 
            range="{{cellTypeOptions}}" 
            range-key="name" 
            value="{{item.typeIndex}}" 
            data-index="{{index}}" 
            bindchange="onCellTypeChange"
          >
            <text class="cell-type">{{item.name}}</text>
          </picker>
          <input 
            class="cell-value" 
            type="number" 
            placeholder="值" 
            value="{{item.value}}" 
            data-index="{{index}}" 
            bindinput="onCellValueInput" 
          />
          <input 
            class="cell-unit" 
            placeholder="单位" 
            value="{{item.unit}}" 
            data-index="{{index}}" 
            bindinput="onCellUnitInput" 
          />
          <input 
            class="cell-weight" 
            type="digit" 
            placeholder="权重" 
            value="{{item.weight}}" 
            data-index="{{index}}" 
            bindinput="onCellWeightInput" 
          />
          <text class="cell-remove" data-index="{{index}}" bindtap="removeCell">✕</text>
        </view>
      </view>
      <view class="add-cell-btn" bindtap="addCell">
        <text>+ 添加格子</text>
      </view>

      <!-- 额外参数 -->
      <view class="extra-params" wx:if="{{metaCardInfo.extraParams}}">
        <view class="param-row" wx:for="{{metaCardInfo.extraParams}}" wx:key="id">
          <text class="param-name">{{item.name}}</text>
          <picker 
            mode="selector" 
            range="{{item.options}}" 
            value="{{extraParamValues[item.id + '_idx'] || 0}}" 
            data-param-id="{{item.id}}" 
            bindchange="onExtraParamChange"
          >
            <text class="param-val">{{extraParamValues[item.id] || item.default}}</text>
          </picker>
        </view>
      </view>
    </view>

    <!-- 自定义分类名 -->
    <view class="form-item">
      <text class="form-label">自定义分类名</text>
      <input class="form-input" placeholder="留空则使用默认分类名" value="{{categoryName}}" bindinput="onCategoryNameInput" maxlength="10" />
      <text class="form-hint">替换上方默认分类名的展示文本</text>
    </view>

    <!-- 单位（自由输入） -->
    <view class="form-item">
      <text class="form-label">单位</text>
      <input class="form-input" placeholder="如 次/分钟/组/秒/份/枚/..." value="{{unit}}" bindinput="onUnitInput" maxlength="10" />
      <text class="form-hint">支持任意自定义单位</text>
    </view>

    <!-- 每单位修为 -->
    <view class="form-item">
      <text class="form-label">每单位修为</text>
      <input class="form-input" type="number" placeholder="输入数值（如 1、-5）" value="{{scorePerUnit}}" bindinput="onScoreInput" />
      <text class="form-hint">正数为增益，负数为减益</text>
    </view>

    <!-- 描述 -->
    <view class="form-item">
      <text class="form-label">描述</text>
      <textarea class="form-textarea" placeholder="输入活动描述（选填）" value="{{description}}" bindinput="onDescInput" maxlength="200" />
    </view>

    <!-- 图标 -->
    <view class="form-item">
      <text class="form-label">图标（emoji）</text>
      <input class="form-input" placeholder="输入一个 emoji 作为图标（选填）" value="{{icon}}" bindinput="onIconInput" maxlength="2" />
    </view>

    <!-- 属性编辑区（ext） -->
    <view class="form-section">
      <text class="form-section-title">自定义属性</text>
      <view class="ext-list">
        <view class="ext-row" wx:for="{{extList}}" wx:key="key">
          <text class="ext-key">{{item.key}}</text>
          <text class="ext-sep">:</text>
          <text class="ext-val">{{item.val}}</text>
          <text class="ext-remove" data-index="{{index}}" bindtap="onRemoveExt">✕</text>
        </view>
      </view>
      <view class="ext-add-row">
        <input class="ext-key-input" placeholder="属性名" value="{{extKey}}" bindinput="onExtKeyInput" maxlength="20" />
        <input class="ext-val-input" placeholder="属性值" value="{{extVal}}" bindinput="onExtValInput" maxlength="50" />
        <button class="ext-add-btn" bindtap="onAddExt" size="mini">添加</button>
      </view>
    </view>

    <!-- 标签 -->
    <view class="form-item">
      <text class="form-label">标签</text>
      <input class="form-input" placeholder="标签以逗号分隔，如：减脂, 入门, 低强度" value="{{tagsStr}}" bindinput="onTagsInput" maxlength="100" />
    </view>

    <!-- 高级设置 -->
    <view class="form-section">
      <view class="advanced-header" bindtap="toggleAdvanced">
        <text class="form-section-title">高级设置（自定义元数据）</text>
        <text class="advanced-arrow">{{showAdvanced ? '▾' : '▸'}}</text>
      </view>
      <view class="advanced-body" wx:if="{{showAdvanced}}">
        <textarea class="form-textarea advanced-textarea" placeholder='输入 JSON 格式的自定义元数据，如：{"calories":500,"difficulty":"hard"}' value="{{customMetaStr}}" bindinput="onCustomMetaInput" maxlength="2000" />
      </view>
    </view>
  </view>

  <!-- 底部保存按钮 -->
  <view class="bottom-bar">
    <button class="btn-save" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}">
      {{mode === 'metaCard' ? '创建元卡活动' : (isNew ? '复制并保存' : '保存修改')}}
    </button>
  </view>
</view>
