/* 自建模板配置页 */

page { height: 100%; background: var(--page-bg); }
.page-body { display: flex; flex-direction: column; height: 100vh; overflow: hidden; }

/* ===== 顶部 ===== */
.builder-header { padding: 20rpx 28rpx 16rpx; background: var(--card-bg); border-bottom: 1rpx solid var(--border-color); }
.name-input-wrap { position: relative; margin-bottom: 14rpx; }
.name-input {
  width: 100%; height: 72rpx; padding: 0 56rpx 0 20rpx; box-sizing: border-box;
  background: var(--surface-soft); border-radius: 14rpx; font-size: 30rpx;
  color: var(--text-primary);
}
.name-clear {
  position: absolute; right: 12rpx; top: 50%; transform: translateY(-50%);
  width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: var(--text-muted); background: var(--surface-soft); border-radius: 50%;
}
.type-tabs { display: flex; gap: 12rpx; }
.type-tab {
  flex: 1; height: 64rpx; border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; color: var(--text-secondary); background: var(--surface-soft);
  transition: all 0.2s;
}
.type-tab.active { background: var(--primary); color: #fff; font-weight: 600; }

/* ===== 上半屏 ===== */
.upper-area { flex: 0 0 auto; height: 42vh; overflow: hidden; display: flex; flex-direction: column; }

.preset-bar { padding: 12rpx 28rpx; display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.section-label { font-size: 26rpx; font-weight: 600; color: var(--text-primary); }
.preset-btn {
  font-size: 24rpx; color: var(--primary); background: var(--primary-mist);
  padding: 8rpx 20rpx; border-radius: 20rpx;
}

/* ===== 日模板：时间轴时段行 ===== */
.slot-rows { flex: 1; min-height: 0; padding: 0 28rpx; }

.slot-row {
  display: flex; align-items: stretch;
  border-bottom: 1rpx solid var(--border-color); padding: 12rpx 12rpx 0;
  transition: all 0.15s; box-sizing: border-box;
}
.slot-row.selected {
  border: 2rpx solid var(--primary); background: var(--primary-mist);
  border-radius: 10rpx; margin-bottom: 2rpx;
}

/* 左侧 160rpx */
.slot-left {
  width: 160rpx; flex-shrink: 0; display: flex; align-items: center; padding-bottom: 42rpx;
}
.slot-name { font-size: 28rpx; font-weight: 600; color: var(--text-primary); }

/* 中间 flex:1 时间轴 + 卡片 */
.slot-mid {
  flex: 1; min-width: 0;
  display: flex; flex-direction: column;
  overflow: hidden;
}
.slot-cards-area {
  flex: 1; min-height: 0;
}
.slot-act-scroll {
  width: 100%;
  white-space: nowrap;
}
.slot-act-wrap {
  display: flex; flex-wrap: nowrap; gap: 12rpx;
  padding: 0 4rpx 8rpx;
}
.slot-empty {
  flex: 1; display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; color: var(--text-muted);
}

/* 时间轴轨道 */
.timeline-track { position: relative; padding-bottom: 34rpx; }
.timeline-line {
  height: 4rpx; background: var(--warning);
}
.timeline-labels {
  display: flex; justify-content: space-between;
  position: absolute; left: 0; right: 0; bottom: 4rpx;
}
.timeline-start, .timeline-end {
  font-size: 22rpx; color: var(--text-muted);
  padding: 4rpx 6rpx;
}
.timeline-start:active, .timeline-end:active { color: var(--text-secondary); }

/* 右侧 80rpx */
.slot-right {
  width: 80rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center;
  padding-bottom: 12rpx;
}
.slot-badge {
  width: 48rpx; height: 48rpx; border-radius: 50%; background: var(--primary);
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: #ffffff; font-weight: 600;
}

.expand-arrow {
  font-size: 26rpx; color: var(--text-muted);
  margin-left: 8rpx;
}

/* 落位模式：时段勾选 toggle */
.slot-drop-toggle {
  width: 48rpx; height: 48rpx; border-radius: 50%; flex-shrink: 0;
  align-self: center; margin-left: 4rpx;
  border: 2rpx dashed var(--primary); color: var(--primary);
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 600;
}
.slot-drop-toggle.checked { background: var(--primary); color: #fff; border-style: solid; }

/* ===== 活动卡片（flex-grow 按次数比例分配宽度，三层居中布局） ===== */
.act-card {
  position: relative; flex: 0 0 150rpx; width: 150rpx;
  padding: 12rpx 10rpx; box-sizing: border-box;
  background: var(--card-bg); border: 1rpx solid var(--primary-mist); border-radius: 8rpx;
  display: flex; flex-direction: column; align-items: center; gap: 6rpx;
}
.act-card .act-del {
  position: absolute; top: -6rpx; right: -6rpx;
  width: 28rpx; height: 28rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 18rpx; color: var(--text-muted); background: var(--surface-soft);
  z-index: 10;
}
.act-card .act-name {
  font-size: 24rpx; color: var(--text-primary); font-weight: 500;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  width: 100%; text-align: center; line-height: 1.3;
}
.act-ctrl {
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
}
.act-btn {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 600;
}
.act-btn.minus { background: var(--primary-mist); color: var(--text-muted); }
.act-btn.plus { background: var(--primary-mist); color: var(--primary); }
.act-val {
  font-size: 22rpx; font-weight: 600; color: var(--text-secondary); min-width: 44rpx; text-align: center;
}

/* 周模板/合道模板 时段列表（共用旧样式） */
.slot-list { flex: 1; padding: 0 28rpx; }
.slot-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 16rpx; margin-bottom: 8rpx;
  background: var(--card-bg); border-radius: 12rpx; border: 1rpx solid var(--border-color);
}
.slot-item.selected { border-color: var(--primary); background: var(--primary-mist); }
.slot-actions { display: flex; gap: 4rpx; }
.slot-move-btn {
  font-size: 20rpx; color: var(--text-muted); padding: 4rpx 8rpx;
  background: var(--surface-soft); border-radius: 6rpx;
}

/* 合道模板 */
.pool-target-row {
  display: flex; align-items: center; padding: 12rpx 28rpx; gap: 12rpx;
}
.pool-target-label { font-size: 26rpx; color: var(--text-secondary); }
.pool-target-input {
  width: 120rpx; height: 56rpx; text-align: center;
  background: var(--card-bg); border: 1rpx solid var(--border-color); border-radius: 10rpx;
  font-size: 26rpx; color: var(--text-primary);
}
.pool-target-suffix { font-size: 22rpx; color: var(--text-muted); }

/* 周模板 */
.week-day-bar {
  padding: 0 28rpx 8rpx; white-space: nowrap;
  display: flex; flex-direction: row;
}
.week-day-tab {
  display: inline-flex; align-items: center; justify-content: center;
  width: 88rpx; height: 60rpx; margin-right: 8rpx; border-radius: 12rpx;
  font-size: 24rpx; color: var(--text-secondary); background: var(--surface-soft); flex-shrink: 0;
}
.week-day-tab.active { background: var(--primary); color: #fff; font-weight: 600; }
.batch-bar { padding: 8rpx 28rpx; }
.batch-btn {
  font-size: 24rpx; color: var(--primary); background: var(--primary-mist);
  padding: 8rpx 20rpx; border-radius: 20rpx; display: inline-block;
}

/* 已添加活动列表 */
.slot-activities { padding: 8rpx 28rpx; }
.sa-title {
  display: flex; justify-content: space-between; align-items: center;
  font-size: 24rpx; color: var(--text-secondary); margin-bottom: 8rpx;
}
.sa-copy { color: var(--primary); font-size: 22rpx; }
.sa-list { display: flex; flex-wrap: wrap; gap: 8rpx; max-height: 140rpx; overflow-y: auto; }
.sa-item {
  display: flex; align-items: center; gap: 6rpx;
  padding: 8rpx 14rpx; background: var(--primary-mist); border-radius: 10rpx;
  border: 1rpx solid var(--primary-mist-strong); font-size: 22rpx;
}
.sa-item-name { color: var(--success); font-weight: 500; }
.sa-item-cap { color: var(--primary); font-size: 20rpx; }
.sa-item-actions { display: flex; gap: 2rpx; margin-left: 4rpx; }
.sa-move { font-size: 18rpx; color: var(--text-secondary); padding: 2rpx 6rpx; }
.sa-remove { font-size: 20rpx; color: var(--danger); padding: 2rpx 6rpx; }

/* ===== 分隔线 ===== */
.section-divider {
  display: flex; align-items: center; padding: 16rpx 28rpx 8rpx; gap: 12rpx;
}
.divider-line { flex: 1; height: 1rpx; background: var(--border-color); }
.divider-text { font-size: 22rpx; color: var(--text-muted); flex-shrink: 0; }

/* ===== 购物车落位区（下半屏） ===== */
.drop-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 28rpx; background: var(--primary-mist);
  border-top: 1rpx solid var(--primary-mist-strong); border-bottom: 1rpx solid var(--primary-mist-strong);
}
.drop-bar-info { font-size: 26rpx; color: var(--success); font-weight: 600; }
.drop-bar-actions { display: flex; gap: 12rpx; }
.drop-btn { padding: 8rpx 24rpx; border-radius: 20rpx; font-size: 24rpx; }
.drop-btn.cancel { background: var(--surface-soft); color: var(--text-secondary); }
.drop-btn.confirm { background: var(--primary); color: #fff; }

.cart-empty {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 20rpx; padding: 40rpx 28rpx;
}
.cart-empty-text { font-size: 28rpx; color: var(--text-muted); }
.cart-empty-btn {
  font-size: 26rpx; color: var(--primary); background: var(--primary-mist);
  padding: 16rpx 40rpx; border-radius: 24rpx;
}

.cart-list { flex: 1; min-height: 0; padding: 0 28rpx; }
.cart-item {
  display: flex; align-items: center;
  background: var(--card-bg); border: 1rpx solid var(--border-color); border-radius: 14rpx;
  padding: 16rpx; margin-bottom: 12rpx;
}
.cart-item-main { flex: 1; min-width: 0; display: flex; align-items: center; gap: 16rpx; }
.cart-item-icon {
  width: 40rpx; height: 40rpx; border-radius: 10rpx; flex-shrink: 0;
  background: var(--primary-mist); color: var(--primary);
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 700;
}
.cart-item-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.cart-item-name {
  font-size: 26rpx; color: var(--text-primary); font-weight: 500;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.cart-item-cap { font-size: 22rpx; color: var(--text-muted); }
.cart-item-drop {
  flex-shrink: 0; margin-left: 16rpx;
  background: var(--primary); color: #fff; font-size: 24rpx;
  padding: 8rpx 22rpx; border-radius: 20rpx;
}
.cart-item-del {
  flex-shrink: 0; margin-left: 16rpx;
  font-size: 26rpx; color: var(--text-muted); padding: 4rpx 8rpx;
}
.cart-clear { text-align: center; font-size: 24rpx; color: var(--text-muted); padding: 16rpx 0; }

/* ===== 修行目标最优区间卡 ===== */
.optimal-card {
  margin: 24rpx 20rpx 12rpx;
  padding: 24rpx 24rpx 20rpx;
  background: linear-gradient(135deg, var(--info-mist) 0%, var(--info-mist) 100%);
  border: 1rpx solid var(--info-mist);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(99, 102, 241, 0.08);
}
.optimal-head {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 10rpx;
}
.optimal-title {
  font-size: 30rpx; font-weight: 700; color: var(--blue);
}
.optimal-apply {
  padding: 10rpx 20rpx; background: var(--blue); color: #fff;
  border-radius: 30rpx; font-size: 24rpx; font-weight: 500;
}
.optimal-sub {
  font-size: 22rpx; color: var(--text-secondary); margin-bottom: 16rpx;
  padding-bottom: 14rpx; border-bottom: 1rpx dashed var(--info-mist);
}
.optimal-group {
  margin-top: 6rpx;
}
.optimal-nutrition-group {
  margin-top: 4rpx; padding-top: 4rpx;
}
.optimal-row {
  display: flex; align-items: center;
  padding: 10rpx 0;
}
.optimal-label {
  flex: 0 0 160rpx; font-size: 26rpx; color: var(--text-secondary);
  font-weight: 500;
}
.optimal-range {
  flex: 1; display: flex; align-items: center;
}
.optimal-input {
  flex: 0 0 130rpx; height: 56rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--info-mist); border-radius: 12rpx;
  padding: 0 14rpx; text-align: center;
  font-size: 24rpx; color: var(--text-primary);
}
.optimal-range-tilde {
  flex: 0 0 32rpx; text-align: center;
  color: var(--blue); font-size: 26rpx;
}
.optimal-unit {
  flex: 0 0 auto; margin-left: 12rpx;
  font-size: 22rpx; color: var(--text-secondary);
}

/* ===== 底部保存 ===== */
.save-bar {
  padding: 16rpx 28rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--card-bg); border-top: 1rpx solid var(--border-color);
}
.save-btn {
  width: 100%; height: 88rpx; border-radius: 16rpx;
  background: var(--primary); color: #fff; font-size: 30rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
}

/* ===== 浮层通用 ===== */
.popup-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45); z-index: 300;
  display: flex; align-items: flex-end;
  opacity: 0; pointer-events: none; transition: opacity 0.25s;
}
.popup-overlay.show { opacity: 1; pointer-events: auto; }
.popup-sheet {
  width: 100%; max-height: 65vh; overflow-y: auto;
  background: var(--card-bg); border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 28rpx 40rpx; box-sizing: border-box;
}
.popup-title {
  font-size: 30rpx; font-weight: 700; color: var(--text-primary);
  text-align: center; margin-bottom: 24rpx;
}
.popup-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.popup-input {
  flex: 1; height: 72rpx; padding: 0 16rpx; box-sizing: border-box;
  background: var(--surface-soft); border-radius: 12rpx; font-size: 28rpx; color: var(--text-primary);
}
.popup-unit-tabs { display: flex; gap: 8rpx; }
.popup-unit {
  padding: 10rpx 18rpx; border-radius: 10rpx; font-size: 24rpx;
  color: var(--text-secondary); background: var(--surface-soft);
}
.popup-unit.active { background: var(--primary); color: #fff; }

.popup-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.popup-btn {
  flex: 1; height: 80rpx; border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 500;
}
.popup-btn.cancel { background: var(--surface-soft); color: var(--text-secondary); }
.popup-btn.confirm { background: var(--primary); color: #fff; }

/* checkbox 列表 */
.checkbox-list { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 16rpx; }
.checkbox-item {
  padding: 12rpx 20rpx; border-radius: 10rpx; font-size: 26rpx;
  color: var(--text-secondary); background: var(--surface-soft); border: 2rpx solid transparent;
}
.checkbox-item.checked { border-color: var(--primary); color: var(--primary); background: var(--primary-mist); }

/* 预设列表 */
.preset-list { max-height: 50vh; }
.preset-option {
  padding: 20rpx 16rpx; border-bottom: 1rpx solid var(--border-color); border-radius: 10rpx; margin-bottom: 6rpx;
}
.preset-opt-name { font-size: 28rpx; font-weight: 600; color: var(--text-primary); }
.preset-opt-desc { font-size: 22rpx; color: var(--text-muted); margin-top: 4rpx; }
