/* 单品活动详情页 */
page { height: 100%; background: #f7f8fa; }
.page-body { min-height: 100vh; display: flex; flex-direction: column; }

/* 头部 */
.detail-hero {
  display: flex; flex-direction: column; align-items: center;
  padding: 48rpx 32rpx 32rpx; background: #fff;
  border-bottom: 1rpx solid #eee;
}
.detail-icon {
  width: 120rpx; height: 120rpx; border-radius: 24rpx;
  background: linear-gradient(135deg, #e8f5e9 0%, #f0fdf4 100%);
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; font-weight: 700; color: #10B981;
  margin-bottom: 20rpx;
}
.detail-name {
  font-size: 36rpx; font-weight: 700; color: #1f2937;
  text-align: center; margin-bottom: 16rpx;
}
.detail-badges { display: flex; flex-wrap: wrap; gap: 10rpx; justify-content: center; }
.badge {
  font-size: 22rpx; line-height: 1; padding: 6rpx 16rpx; border-radius: 20rpx;
  border: 1rpx solid;
}
.badge-meta { background: #DCFCE7; color: #16A34A; border-color: #86EFAC; }
.badge-official { background: #EBF5FF; color: #3B82F6; border-color: #BFDBFE; }
.badge-custom { background: #FEF3C7; color: #D97706; border-color: #FDE68A; }
.badge-public { background: #F3E8FF; color: #7E22CE; border-color: #E9D5FF; }
.badge-ref { background: #FEE2E2; color: #DC2626; border-color: #FECACA; }
.badge-public-lib { background: #d1fae5; color: #047857; border-color: #a7f3d0; }

/* 介绍 */
.detail-section { padding: 28rpx 32rpx; background: #fff; margin-top: 16rpx; }
.detail-label { display: block; font-size: 26rpx; color: #9ca3af; margin-bottom: 12rpx; }
.detail-desc { font-size: 28rpx; color: #374151; line-height: 1.6; }

/* 分值 */
.detail-score {
  display: flex; align-items: baseline; gap: 12rpx;
  padding: 28rpx 32rpx; background: #fff; margin-top: 16rpx;
}
.score-value { font-size: 40rpx; font-weight: 700; color: #10B981; }
.score-unit { font-size: 24rpx; color: #9ca3af; }

/* 底部按钮 */
.detail-footer {
  margin-top: auto; padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff; border-top: 1rpx solid #eee;
}
.add-btn {
  width: 100%; height: 88rpx; border-radius: 16rpx;
  background: #10B981; color: #fff; font-size: 30rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
}
