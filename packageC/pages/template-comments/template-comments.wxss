.page{min-height:100vh;padding:40rpx;background:#1a1a2e;color:#fff}
.title{font-size:36rpx;font-weight:700;margin-bottom:24rpx}
.comment-input-row{display:flex;gap:16rpx;margin-bottom:32rpx;align-items:flex-end}
.comment-input{flex:1;background:rgba(30,41,59,.8);border:1rpx solid rgba(255,255,255,.05);border-radius:16rpx;padding:16rpx;color:#fff;font-size:26rpx;min-height:80rpx;max-height:160rpx}
.comment-send{padding:16rpx 32rpx;background:#eab308;color:#0f172a;border-radius:16rpx;font-size:26rpx;font-weight:600;white-space:nowrap}
.comment-send.disabled{background:#334155;color:#64748b}
.comment{padding:16rpx;background:rgba(30,41,59,.6);border-radius:16rpx;margin-bottom:12rpx}
.author{display:block;font-size:22rpx;color:#94a3b8}.content{display:block;font-size:26rpx;color:#fff;margin-top:4rpx}
.empty{text-align:center;color:#64748b;padding:120rpx 0}
