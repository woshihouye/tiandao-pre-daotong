<view class="page"><view class="title">💬 评论</view>
  <!-- v4.0 发表评论 -->
  <view class="comment-input-row">
    <textarea class="comment-input" value="{{ inputText }}" placeholder="写下你的评价..." bindinput="onInputChange" maxlength="500" auto-height />
    <view class="comment-send {{ inputText ? '' : 'disabled' }}" bindtap="onSendTap">发表</view>
  </view>
  <block wx:if="{{ comments.length }}">
    <view class="comment" wx:for="{{ comments }}" wx:key="_id"><text class="author">{{ item.userName || '修士' }}</text><text class="content">{{ item.content }}</text></view>
  </block>
  <view class="empty" wx:if="{{ !comments.length }}">暂无评论</view>
</view>
