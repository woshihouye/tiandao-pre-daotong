/* 分层进度条 - 境界子阶段（初期/中期/后期/圆满）分段显示 */
/* 使用项目设计令牌 */

.lp-wrap {
  display: flex;
  gap: var(--space-xs);
  align-items: center;
  padding: var(--space-sm) 0;
}
.lp-segment {
  flex: 1;
  height: 20rpx;
  border-radius: 10rpx;
  background: var(--surface-soft);
  overflow: hidden;
  position: relative;
}
.lp-fill {
  height: 100%;
  border-radius: 10rpx;
  transition: width .5s ease;
  position: absolute;
  left: 0;
  top: 0;
}
.lp-segment.current {
  box-shadow: 0 0 12rpx var(--primary);
}
.lp-label-row {
  display: flex;
  gap: var(--space-xs);
  font-size: var(--font-xs);
  color: var(--text-muted);
  margin-top: 6rpx;
}
.lp-label {
  flex: 1;
  text-align: center;
}
.lp-label.active {
  color: var(--primary);
  font-weight: var(--weight-semibold);
}
.lp-overall {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  text-align: center;
  margin-top: 4rpx;
}
