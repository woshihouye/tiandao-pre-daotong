.particle-container { position: absolute; top: 50%; left: 50%; z-index: 999; pointer-events: none; }
.particle { position: absolute; width: var(--size); height: var(--size); border-radius: 50%; background: var(--color);
  animation: particleFly var(--duration) ease-out var(--delay) forwards; opacity: 0; box-shadow: 0 0 calc(var(--size)*2) var(--color); }
@keyframes particleFly {
  0% { transform: translate(0,0) scale(1); opacity: 1; }
  50% { transform: translate(calc(var(--x)*0.7), calc(var(--y)*0.7)) scale(1.3); opacity: 0.8; }
  100% { transform: translate(var(--x), var(--y)) scale(0); opacity: 0; }
}
