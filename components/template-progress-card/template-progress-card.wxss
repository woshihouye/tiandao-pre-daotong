/* 模板进度卡片 */
.template-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
  overflow: hidden;
  transition: all 0.3s ease;
}

.template-card.completed {
  box-shadow: 0 0 0 2rpx var(--card-color, #EF4444), 0 4rpx 10rpx var(--card-color, #EF4444)20;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 144rpx;
  padding: 28rpx 32rpx;
  touch-action: none;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
  min-width: 0;
}

.template-cover {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.template-cover text {
  font-size: 40rpx;
  font-weight: 700;
}

.template-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.template-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.template-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.template-tag-badge {
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.template-meta {
  font-size: 24rpx;
  color: #9CA3AF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex-shrink: 0;
}

.progress-indicator {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.progress-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #374151;
}

.progress-gong {
  font-size: 24rpx;
  font-weight: 500;
  margin-top: 2rpx;
}

.progress-label {
  font-size: 22rpx;
  color: #9CA3AF;
}

.expand-arrow {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  transition: transform 0.3s ease;
}

.expand-arrow text {
  font-size: 24rpx;
  color: #9CA3AF;
}

.expand-arrow.expanded {
  transform: rotate(90deg);
}

/* 进度条 */
.card-progress-bar {
  padding: 0 32rpx 4rpx;
}

.progress-track {
  height: 6rpx;
  background: #E5E7EB;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

/* 展开体 */
.card-body {
  padding: 0 8rpx 24rpx;
  animation: expandIn 0.3s ease;
}

@keyframes expandIn {
  from {
    opacity: 0;
    max-height: 0;
  }
  to {
    opacity: 1;
    max-height: 2000rpx;
  }
}

.activity-list {
  padding: 16rpx 16rpx 0;
}
