/* 单个活动进度项 */
.progress-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 112rpx;
  padding: 0 32rpx;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
  transition: background 0.2s ease;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1F2937;
}

.item-unit {
  font-size: 24rpx;
  color: #9CA3AF;
}

.item-right {
  display: flex;
  align-items: center;
}

.item-percent {
  font-size: 32rpx;
  font-weight: 600;
  color: #374151;
  min-width: 80rpx;
  text-align: right;
}

/* slider 弹层 */
.slider-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.slider-panel {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 40rpx 72rpx;
}

.slider-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.slider-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1F2937;
}

.slider-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F3F4F6;
  font-size: 28rpx;
  color: #6B7280;
}

.slider-body {
  padding: 0 16rpx;
}

.slider-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  padding: 0 8rpx;
}

.slider-labels text {
  font-size: 22rpx;
  color: #9CA3AF;
}
