<!-- 结果汇总面板（综合化：不分类，一个综合卡片） -->
<view class="result-panel">

  <view class="result-header">
    <text class="result-title">今日修行结算</text>
    <view class="result-gong-wrap">
      <text class="result-gong-label">修为</text>
      <text class="result-gong-value {{result.totalGong < 0 ? 'neg' : ''}}">{{result.totalGong < 0 ? '' : '+'}}{{result.totalGong || 0}}</text>
    </view>
  </view>

  <view class="result-body">

    <!-- 🔥 运动消耗 -->
    <view class="res-row row-wu" wx:if="{{result.totalCalories > 0}}">
      <text class="res-icon">🔥</text>
      <view class="res-content">
        <text class="res-text">消耗</text>
        <text class="res-num">{{result.totalCalories}}</text>
        <text class="res-unit">千卡（运动）</text>
      </view>
      <view class="res-chip chip-wu" wx:if="{{result.trainedMuscleCount > 0}}">
        激活 {{result.trainedMuscleCount}} 肌群
      </view>
    </view>

    <!-- 🦵 肌群激活列表 -->
    <view class="muscle-section" wx:if="{{result.muscleRows && result.muscleRows.length > 0}}">
      <view class="muscle-list">
        <view class="muscle-row" wx:for="{{result.muscleRows}}" wx:key="key">
          <text class="muscle-name">{{item.name}}</text>
          <view class="muscle-bar-wrap">
            <view class="muscle-bar-fill" style="width: {{item.activationWidth}}%;"></view>
          </view>
          <text class="muscle-value">{{item.activationPct}}%</text>
        </view>
      </view>
    </view>

    <!-- 🥩 饮食营养 -->
    <view class="res-row row-shi" wx:if="{{result.nutrition && (result.nutrition.protein > 0 || result.nutrition.carbs > 0 || result.nutrition.fat > 0 || result.shiCalories > 0)}}">
      <text class="res-icon">🥩</text>
      <view class="res-content">
        <text class="res-text">摄入</text>
        <text class="res-num">蛋白{{result.nutrition.protein || 0}}g · 碳水{{result.nutrition.carbs || 0}}g · 脂肪{{result.nutrition.fat || 0}}g</text>
      </view>
      <text class="res-calories" wx:if="{{result.shiCalories > 0}}">{{result.shiCalories}} 千卡</text>
    </view>

    <!-- 🥗 三大营养占比（环） -->
    <view class="nutrition-section" wx:if="{{result.nutrition && (result.nutrition.protein > 0 || result.nutrition.carbs > 0 || result.nutrition.fat > 0)}}">
      <view class="macro-ring-row">
        <view class="macro-item">
          <view class="macro-dot protein"></view>
          <text class="macro-label">蛋白 {{result.nutrition.protein || 0}}g</text>
          <text class="macro-percent">{{result.macroRatio && result.macroRatio.protein || 0}}%</text>
        </view>
        <view class="macro-item">
          <view class="macro-dot carbs"></view>
          <text class="macro-label">碳水 {{result.nutrition.carbs || 0}}g</text>
          <text class="macro-percent">{{result.macroRatio && result.macroRatio.carbs || 0}}%</text>
        </view>
        <view class="macro-item">
          <view class="macro-dot fat"></view>
          <text class="macro-label">脂肪 {{result.nutrition.fat || 0}}g</text>
          <text class="macro-percent">{{result.macroRatio && result.macroRatio.fat || 0}}%</text>
        </view>
      </view>
      <view class="macro-ring" wx:if="{{(result.nutrition.protein + result.nutrition.carbs + result.nutrition.fat) > 0}}">
        <view class="ring-segment protein" style="flex: {{result.macroRatio && result.macroRatio.protein || 0}}"></view>
        <view class="ring-segment carbs" style="flex: {{result.macroRatio && result.macroRatio.carbs || 0}}"></view>
        <view class="ring-segment fat" style="flex: {{result.macroRatio && result.macroRatio.fat || 0}}"></view>
      </view>
    </view>

    <!-- 📖 学习 -->
    <view class="res-row row-study" wx:if="{{result.studyMinutes > 0}}">
      <text class="res-icon">📖</text>
      <view class="res-content">
        <text class="res-text">学习</text>
        <text class="res-num">{{result.studyMinutes}}</text>
        <text class="res-unit">分钟</text>
        <text class="res-text res-text-sub" wx:if="{{result.studyKnowledge > 0}}">· 知识 {{result.studyKnowledge}}</text>
      </view>
    </view>

    <!-- 💼 工作 -->
    <view class="res-row row-gong" wx:if="{{result.workOutput > 0}}">
      <text class="res-icon">💼</text>
      <view class="res-content">
        <text class="res-text">成果</text>
        <text class="res-num">{{result.workOutput}}</text>
        <text class="res-unit">项</text>
      </view>
    </view>

    <!-- ⚠️ 放纵 -->
    <view class="res-row row-sha" wx:if="{{result.debuffHours > 0 || result.debuffCalories > 0}}">
      <text class="res-icon">⚠️</text>
      <view class="res-content">
        <text class="res-text">放纵</text>
        <text class="res-num" wx:if="{{result.debuffHours > 0}}">{{result.debuffHours}}</text>
        <text class="res-unit" wx:if="{{result.debuffHours > 0}}">小时</text>
        <text class="res-text res-text-sub" wx:if="{{result.debuffCalories > 0}}">· 额外 {{result.debuffCalories}} 千卡</text>
      </view>
    </view>

    <!-- 无任何数据 -->
    <view class="placeholder" wx:if="{{result.totalCalories <= 0 && !(result.nutrition && (result.nutrition.protein > 0 || result.nutrition.carbs > 0 || result.nutrition.fat > 0)) && result.studyMinutes <= 0 && result.workOutput <= 0 && result.debuffHours <= 0 && result.debuffCalories <= 0}}">
      <text class="placeholder-icon">🧘</text>
      <text class="placeholder-text">请调整进度以查看修行结果</text>
    </view>

  </view>
</view>
