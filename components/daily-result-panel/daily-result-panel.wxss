/* 结果汇总面板（综合化：不分类，一个综合卡片） */
.result-panel {
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  padding: 40rpx 36rpx 32rpx;
  margin-top: 24rpx;
}

/* 顶部 header：标题 + 修为大号数 */
.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 28rpx;
  margin-bottom: 28rpx;
  border-bottom: 2rpx solid #F3F4F6;
}
.result-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
  letter-spacing: 1rpx;
}
.result-gong-wrap {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}
.result-gong-label {
  font-size: 24rpx;
  color: #6B7280;
}
.result-gong-value {
  font-size: 56rpx;
  font-weight: 800;
  color: #8B5CF6;
  letter-spacing: -1rpx;
  line-height: 1;
}
.result-gong-value.neg {
  color: #DC2626;
}

/* body 区 */
.result-body {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 每一行：图标 + 内容 + 右侧 chip */
.res-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #F9FAFB;
}
.res-icon {
  font-size: 44rpx;
  flex-shrink: 0;
  width: 64rpx;
  text-align: center;
}
.res-content {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 6rpx;
}
.res-text {
  font-size: 26rpx;
  color: #6B7280;
}
.res-text-sub {
  color: #9CA3AF;
}
.res-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
}
.res-unit {
  font-size: 24rpx;
  color: #9CA3AF;
}
.res-calories {
  font-size: 26rpx;
  font-weight: 600;
  color: #F59E0B;
  background: rgba(245, 158, 11, 0.08);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}
.res-chip {
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
}
.chip-wu {
  background: rgba(239, 68, 68, 0.1);
  color: #DC2626;
}

.row-wu   { background: rgba(239, 68, 68, 0.05); }
.row-shi  { background: rgba(245, 158, 11, 0.05); }
.row-study{ background: rgba(16, 185, 129, 0.05); }
.row-gong { background: rgba(59, 130, 246, 0.05); }
.row-sha  { background: rgba(249, 115, 22, 0.05); }

/* 肌群激活区：继承原有样式但无 section-title */
.muscle-section {
  padding: 24rpx 24rpx 8rpx 96rpx;
}
.muscle-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.muscle-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.muscle-name {
  font-size: 24rpx;
  color: #6B7280;
  width: 104rpx;
  flex-shrink: 0;
  text-align: right;
}
.muscle-bar-wrap {
  flex: 1;
  height: 12rpx;
  background: #F3F4F6;
  border-radius: 6rpx;
  overflow: hidden;
}
.muscle-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #EF4444, #F87171);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}
.muscle-value {
  font-size: 22rpx;
  color: #9CA3AF;
  width: 64rpx;
  flex-shrink: 0;
}

/* 营养素 */
.nutrition-section {
  padding: 24rpx 24rpx 8rpx 96rpx;
}
.macro-ring-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.macro-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.macro-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.macro-dot.protein { background-color: #EF4444; }
.macro-dot.carbs   { background-color: #F59E0B; }
.macro-dot.fat     { background-color: #8B5CF6; }
.macro-label {
  flex: 1;
  font-size: 26rpx;
  color: #374151;
}
.macro-percent {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
}
.macro-ring {
  display: flex;
  height: 16rpx;
  border-radius: 8rpx;
  overflow: hidden;
}
.ring-segment.protein { background-color: #EF4444; min-width: 2rpx; }
.ring-segment.carbs   { background-color: #F59E0B; min-width: 2rpx; }
.ring-segment.fat     { background-color: #8B5CF6; min-width: 2rpx; }

/* 占位（完全没数据时） */
.placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 48rpx 0 24rpx;
}
.placeholder-icon {
  font-size: 60rpx;
}
.placeholder-text {
  font-size: 26rpx;
  color: #9CA3AF;
}
