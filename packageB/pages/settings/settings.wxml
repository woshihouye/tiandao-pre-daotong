<view class="container theme-page {{themeClass}}">

  <!-- ========== 身体基本数据编辑 ========== -->
  <view class="setting-card card">
    <view class="group-title">身体数据</view>
    <view class="group-desc">影响模板匹配与修为加成计算</view>

    <view class="field-row">
      <view class="field-label">性别</view>
      <picker class="field-control" mode="selector" range="{{genderOptions}}" range-key="label" value="{{genderIndex}}" bindchange="onGenderChange">
        <view class="field-picker">{{genderOptions[genderIndex].label}}</view>
      </picker>
    </view>

    <view class="field-row">
      <view class="field-label">年龄</view>
      <view class="field-control">
        <input class="field-input" type="number" value="{{bodyForm.age}}" placeholder="输入年龄" data-field="age" bindinput="onBodyInput" bindblur="onBodyBlur" />
        <text class="field-unit">岁</text>
      </view>
    </view>

    <view class="field-row">
      <view class="field-label">身高</view>
      <view class="field-control">
        <input class="field-input" type="digit" value="{{bodyForm.height}}" placeholder="输入身高" data-field="height" bindinput="onBodyInput" bindblur="onBodyBlur" />
        <text class="field-unit">cm</text>
      </view>
    </view>

    <view class="field-row">
      <view class="field-label">体重</view>
      <view class="field-control">
        <input class="field-input" type="digit" value="{{bodyForm.weight}}" placeholder="输入体重" data-field="weight" bindinput="onBodyInput" bindblur="onBodyBlur" />
        <text class="field-unit">kg</text>
      </view>
    </view>

    <view class="field-row">
      <view class="field-label">体脂率</view>
      <view class="field-control">
        <input class="field-input" type="digit" value="{{bodyForm.bodyFat}}" placeholder="选填" data-field="bodyFat" bindinput="onBodyInput" />
        <text class="field-unit">%</text>
      </view>
    </view>

    <view class="field-row">
      <view class="field-label">训练年限</view>
      <picker class="field-control" mode="selector" range="{{trainingExperienceOptions}}" value="{{trainingExperienceIndex}}" bindchange="onTrainingExperienceChange">
        <view class="field-picker">{{trainingExperienceOptions[trainingExperienceIndex]}}</view>
      </picker>
    </view>

    <view class="field-row">
      <view class="field-label">健身目标</view>
      <picker class="field-control" mode="selector" range="{{goalOptions}}" range-key="label" value="{{goalIndex}}" bindchange="onGoalChange">
        <view class="field-picker">{{goalOptions[goalIndex].label}}</view>
      </picker>
    </view>

    <view class="action-bar">
      <button class="btn btn-primary save-btn" bindtap="saveBodySettings">保存身体数据</button>
    </view>
  </view>

  <!-- ========== 修炼体系设置 ========== -->
  <view class="setting-card card">
    <view class="group-title">修行体系</view>
    <view class="group-desc">影响境界名称与修行记录的显示</view>

    <view class="system-row" wx:for="{{cultivationSystems}}" wx:key="key" bindtap="selectCultivationSystem" data-key="{{item.key}}">
      <view class="system-copy">
        <view class="system-title">{{item.label}}</view>
      </view>
      <view class="system-radio {{selectedCultivationSystem === item.key ? 'active' : ''}}">
        <view class="system-radio-dot"></view>
      </view>
    </view>
  </view>

  <!-- ========== 主题设置 ========== -->
  <view class="setting-card card">
    <view class="group-title">主题切换</view>
    <view class="group-desc">选择偏好的页面配色方案</view>

    <view class="system-row" wx:for="{{themeOptions}}" wx:key="key" bindtap="selectTheme" data-key="{{item.key}}">
      <view class="system-copy">
        <view class="system-title">{{item.label}}</view>
        <view class="system-desc">{{item.desc}}</view>
      </view>
      <view class="system-radio {{selectedTheme === item.key ? 'active' : ''}}">
        <view class="system-radio-dot"></view>
      </view>
    </view>
  </view>

  <!-- ========== 更新日志 ========== -->
  <view class="settings-item" bindtap="goToUpdateLog">
    <text>更新日志</text>
    <text class="arrow">></text>
  </view>

  <!-- ========== 新功能设置 ========== -->
  <view class="settings-section card">
    <view class="section-title">功能设置</view>
    <view class="section-desc">道童悬浮球与界面开关</view>

    <!-- 道童悬浮球 -->
    <view class="hedao-row toggle-row">
      <view class="system-copy">
        <view class="system-title">道童悬浮球</view>
        <view class="system-desc">全局浮动AI助手快捷入口</view>
      </view>
      <switch checked="{{spiritVisible}}" bindchange="toggleSpirit" color="#10b981" />
    </view>
  </view>

</view>
